<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Follows the phone's light or dark setting (values-night/colors.xml). Pages follow the
         appearance picked in Rupert's account menu, and the top bar takes each page's banner colour. -->
    <style name="Theme.Rupert" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_muted</item>
        <item name="colorError">@color/danger</item>
        <item name="colorSecondaryContainer">@color/selection</item>
        <item name="colorOnSecondaryContainer">@color/banner_title</item>
        <item name="colorSurfaceContainer">@color/bar</item>
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorBackground">@color/launch_background</item>
        <item name="colorSurfaceContainerLowest">@color/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/launch_background</item>
        <item name="toolbarStyle">@style/Widget.Rupert.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.Rupert.BottomNavigation</item>
    </style>

    <style name="Widget.Rupert.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/banner</item>
        <item name="titleTextColor">@color/banner_title</item>
    </style>

    <style name="Widget.Rupert.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
