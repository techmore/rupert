            android:targetClass="com.rupertpos.rupert.MainActivity">
            <extra android:name="com.rupertpos.rupert.TAB" android:value="ask" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="inbox" android:enabled="true" android:icon="@drawable/ic_shortcut_inbox"
        android:shortcutShortLabel="@string/tab_inbox">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.rupertpos.rupert"
            android:targetClass="com.rupertpos.rupert.MainActivity">
            <extra android:name="com.rupertpos.rupert.TAB" android:value="inbox" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="search" android:enabled="true" android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/tab_search">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="com.rupertpos.rupert"
            android:targetClass="com.rupertpos.rupert.MainActivity">
            <extra android:name="com.rupertpos.rupert.TAB" android:value="search" />
        </intent>
