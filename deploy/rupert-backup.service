# Runs bin/backup.sh on a timer. Install to /etc/systemd/system/
# rupert-backup.service on the droplet. Runs as root because it writes to
# /var/backups; it only ever reads the DB and copies .env.
[Unit]
Description=Rupert database backup
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
ExecStart=/root/rupert/bin/backup.sh

[Install]
WantedBy=multi-user.target
