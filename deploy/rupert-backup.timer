# Nightly Rupert database backup. Install to
# /etc/systemd/system/rupert-backup.timer on the droplet, then:
#   systemctl daemon-reload && systemctl enable --now rupert-backup.timer
[Unit]
Description=Nightly Rupert database backup

[Timer]
OnCalendar=*-*-* 02:30:00 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
