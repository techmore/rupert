# Rupert background jobs (Solid Queue dispatchers/workers). Install to
# /etc/systemd/system/rupert-jobs.service on the droplet.
[Unit]
Description=Rupert background jobs (Solid Queue)
After=rupert-web.service
Wants=rupert-web.service

[Service]
Type=simple
User=rupert
Group=rupert
WorkingDirectory=/root/rupert/web
EnvironmentFile=/root/rupert/.env
ExecStart=/root/.rbenv/shims/bundle exec bin/jobs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
