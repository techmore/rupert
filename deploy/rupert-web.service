# Rupert web (Puma). Install to /etc/systemd/system/rupert-web.service on the
# droplet, then: systemctl daemon-reload && systemctl enable --now rupert-web
[Unit]
Description=Rupert web server (Puma)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=rupert
Group=rupert
WorkingDirectory=/root/rupert/web
# .env is also loaded by dotenv-rails at boot; listed here so systemd sets it
# before any pre/post-Exec hooks.
EnvironmentFile=/root/rupert/.env
ExecStart=/root/.rbenv/shims/bundle exec puma -C config/puma.rb -b tcp://0.0.0.0:3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
