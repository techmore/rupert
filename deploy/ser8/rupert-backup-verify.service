# User unit on the SER8 host (systemctl --user), next to rupert-offhost-backup.service. Checks the encrypted backups
# on this host without decrypting them (no key lives here). A failed run shows as "failed" in Cockpit and on
# System → Backups.
[Unit]
Description=Rupert encrypted backup check (digests, age headers, freshness, active key)

[Service]
Type=oneshot
ExecStart=%h/.local/bin/rupert-backup-verify.sh
Nice=10
