# SER8 HOST user unit: install to ~/.config/systemd/user/ next to rupert-offhost-backup.timer, then
#   systemctl --user daemon-reload && systemctl --user enable --now rupert-offhost-backup.timer
# Runs the encrypted backup pull (deploy/ser8/rupert-host-backup-pull.sh installed as ~/.local/bin/rupert-backup, the
# same script the daily cron line runs). Needs `loginctl enable-linger $USER`. No key lives on this host.
[Unit]
Description=Rupert encrypted off-container backup copy

[Service]
Type=oneshot
ExecStart=%h/.local/bin/rupert-backup
Nice=10
IOSchedulingClass=idle
