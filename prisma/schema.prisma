// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

// ---------------------------------------------------------------------------
// Shopify app session store (used by the React Router app)
// ---------------------------------------------------------------------------
model Session {
  id                  String   @id
  shop                String
  state               String
  isOnline            Boolean  @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean  @default(false)
  locale              String?
  collaborator        Boolean? @default(false)
  emailVerified       Boolean? @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// Catalog — Shopify mirror
// ---------------------------------------------------------------------------
model ShopifyProduct {
  id              String           @id // gid://shopify/Product/<id>
  title           String
  status          String           @default("ACTIVE")
  handle          String?
  publishedAt     DateTime?
  totalInventory  Int              @default(0)
  tags            String?
  syncedAt        DateTime         @default(now())
  variants        ShopifyVariant[]

  @@index([title])
  @@index([status])
}

model ShopifyVariant {
  id                String   @id // gid://shopify/ProductVariant/<id>
  productId         String
  product           ShopifyProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  title             String
  sku               String?
  barcode           String?
  price             Float?
  compareAtPrice    Float?
  inventoryQuantity Int      @default(0)
  tracked           Boolean  @default(false)
  inventoryItemId   String?
  syncedAt          DateTime @default(now())
  skuLinks          SkuLink[]
  movements         InventoryMovement[]
  alerts            StockAlert[]
  levels            InventoryLevel[]

  @@index([productId])
  @@index([sku])
  @@index([tracked])
}

// ---------------------------------------------------------------------------
// Catalog — Square mirror
// ---------------------------------------------------------------------------
model SquareItem {
  id         String           @id
  name       String
  syncedAt   DateTime         @default(now())
  variations SquareVariation[]
}

model SquareVariation {
  id       String      @id
  itemId   String
  item     SquareItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sku      String?
  name     String
  syncedAt DateTime    @default(now())
  skuLinks SkuLink[]
  levels   InventoryLevel[]
  movements InventoryMovement[]
  alerts   StockAlert[]

  @@index([itemId])
  @@index([sku])
}

// ---------------------------------------------------------------------------
// Reconciliation plan — SKU-level bridge between Shopify variants and Square
// variations plus run executions
// ---------------------------------------------------------------------------
model SkuLink {
  id                 String           @id @default(cuid())
  sku                String
  shopifyVariantId   String?
  shopifyVariant     ShopifyVariant?  @relation(fields: [shopifyVariantId], references: [id], onDelete: SetNull)
  squareVariationId  String?
  squareVariation    SquareVariation? @relation(fields: [squareVariationId], references: [id], onDelete: SetNull)
  matchSource        String           @default("sku") // sku | barcode | manual
  auto               Boolean          @default(true)
  createdAt          DateTime         @default(now())

  @@unique([shopifyVariantId, squareVariationId])
  @@index([sku])
  @@index([shopifyVariantId])
}

model ReconcileRun {
  id         String          @id @default(cuid())
  mode       String          @default("manual") // manual | automatic
  status     String          @default("pending") // pending | applied | failed
  totalRows  Int             @default(0)
  actionable Int             @default(0)
  applied    Int             @default(0)
  failed     Int             @default(0)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  items      ReconcileItem[]

  @@index([status])
  @@index([startedAt])
}

model ReconcileItem {
  id            String       @id @default(cuid())
  runId         String
  run           ReconcileRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sku           String
  product       String?
  variant       String?
  tracked       Boolean      @default(false)
  priority      String       @default("lowest")
  shopifyQty    Int?
  squareQty     Int?
  target        Int?
  drift         Int?
  shopifyDelta  Int?
  squareDelta   Int?
  ok            Boolean?
  actions       String?

  @@index([runId])
  @@index([sku])
}

// ---------------------------------------------------------------------------
// Locations + inventory levels (multi-location aware)
// ---------------------------------------------------------------------------
model Location {
  id          String           @id @default(cuid())
  source      String           // shopify | square
  externalId  String
  name        String
  kind        String?          // PHYSICAL | MOBILE | FULFILLMENT_SERVICE | RETAIL …
  timezone    String?
  active      Boolean          @default(true)
  syncedAt    DateTime         @default(now())
  levels      InventoryLevel[]

  @@unique([source, externalId])
  @@index([source])
}

model InventoryLevel {
  id                String           @id @default(cuid())
  source            String           // shopify | square
  locationId        String
  location          Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)
  shopifyVariantId  String?
  shopifyVariant    ShopifyVariant?  @relation(fields: [shopifyVariantId], references: [id], onDelete: SetNull)
  squareVariationId String?
  squareVariation   SquareVariation? @relation(fields: [squareVariationId], references: [id], onDelete: SetNull)
  quantity          Int              @default(0)
  available         Int              @default(0)
  updatedAt         DateTime         @default(now())

  @@unique([source, locationId, shopifyVariantId])
  @@unique([source, locationId, squareVariationId])
  @@index([locationId])
  @@index([shopifyVariantId])
}

// ---------------------------------------------------------------------------
// Inventory movements — every adjustment is journaled
// ---------------------------------------------------------------------------
model InventoryMovement {
  id                String           @id @default(cuid())
  sku               String?
  shopifyVariantId  String?
  shopifyVariant    ShopifyVariant?  @relation(fields: [shopifyVariantId], references: [id], onDelete: SetNull)
  squareVariationId String?
  squareVariation   SquareVariation? @relation(fields: [squareVariationId], references: [id], onDelete: SetNull)
  source            String           // shopify | square | reconcile
  direction         String           // in | out | set
  delta             Int              @default(0)
  quantityBefore    Int
  quantityAfter     Int
  reason            String?
  reference         String?          // order id, reconcile run id, manual
  actor             String?          // system | manual | oil
  createdAt         DateTime         @default(now())

  @@index([shopifyVariantId])
  @@index([createdAt])
  @@index([source])
}

// ---------------------------------------------------------------------------
// Stock awareness
// ---------------------------------------------------------------------------
model StockAlert {
  id                String           @id @default(cuid())
  shopifyVariantId  String?
  shopifyVariant    ShopifyVariant?  @relation(fields: [shopifyVariantId], references: [id], onDelete: Cascade)
  squareVariationId String?
  squareVariation   SquareVariation? @relation(fields: [squareVariationId], references: [id], onDelete: Cascade)
  sku               String?
  quantity          Int              @default(0)
  threshold         Int              @default(5)
  status            String           @default("open") // open | resolved | ignored
  note              String?
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?

  @@index([status])
  @@index([shopifyVariantId])
  @@index([squareVariationId])
}

// ---------------------------------------------------------------------------
// Sync state — every pull is recorded
// ---------------------------------------------------------------------------
model SyncRun {
  id         String    @id @default(cuid())
  mode       String    // automatic | manual | shopify | square
  status     String    // running | success | failed
  source     String?   // all | shopify | square
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  error      String?
  details    String?   // JSON summary
  actor      String?   @default("scheduler") // scheduler | user | setup

  @@index([startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Reconciliation policy + central transaction ledger (kept for compatibility)
// ---------------------------------------------------------------------------
model InventoryPolicy {
  sku        String   @id
  priority   String   @default("lowest") // lowest | shopify | square
  min        Int?     // restock threshold hint
  max        Int?     // target cap
  note       String?
  updatedAt  DateTime

  @@index([priority])
}

model LedgerEntry {
  id            String   @id
  source        String
  sourceOrderId String
  orderName     String?
  occurredAt    DateTime
  currency      String
  grossCents    Int
  status        String
  lineItems     Int
  summary       String?
  syncedAt      DateTime

  @@index([source])
  @@index([occurredAt])
}