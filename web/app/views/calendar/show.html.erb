<% content_for :title, 'Calendar' %>
<% today = Date.current %>
<% query = ->(**changes) { calendar_path({ view: @view, show: @show, month: @month.strftime('%Y-%m') }.merge(changes).compact) } %>
<% show_choices = [['Everything', 'all']] %>
<% show_choices << ['Task deadlines', 'tasks'] if @all_kinds.include?('task') %>
<% show_choices << ['Marketing', 'marketing'] if (@all_kinds & %w[marketing_event campaign_task]).any? %>
<% by_day = @calendar.by_day %>
<div class="space-y-6">
  <%= page_header 'Calendar', subtitle: "Task deadlines and marketing events you can open. Task dates are in store time (#{Time.zone.tzinfo.abbreviation}); event times are local to each event." %>

  <nav class="tabs" aria-label="Calendar views">
    <%= link_to 'Month', query.call(view: 'month'), class: 'tab', aria: { current: @view == 'month' ? 'page' : nil } %>
    <%= link_to 'Agenda', query.call(view: 'agenda'), class: 'tab', aria: { current: @view == 'agenda' ? 'page' : nil } %>
  </nav>

  <div class="toolbar-band">
    <%= form_with url: calendar_path, method: :get, class: 'toolbar' do |f| %>
      <%= f.hidden_field :view, value: @view %>
      <div class="toolbar-field"><%= f.label :month, 'Month', class: 'field-label' %>
        <nav class="date-stepper" aria-label="Month navigation">
          <%= link_to '‹', query.call(month: @month.prev_month.strftime('%Y-%m')), class: 'btn-ghost btn-sm', rel: 'prev', aria: { label: 'Previous month' }, title: 'Previous month' %>
          <%= f.month_field :month, value: @month.strftime('%Y-%m'), class: 'input' %>
          <%= link_to '›', query.call(month: @month.next_month.strftime('%Y-%m')), class: 'btn-ghost btn-sm', rel: 'next', aria: { label: 'Next month' }, title: 'Next month' %>
        </nav>
      </div>
      <% if show_choices.size > 2 %>
        <div class="toolbar-field"><%= f.label :show, 'Show', class: 'field-label' %><%= f.select :show, show_choices, { selected: @show }, class: 'select w-full' %></div>
      <% end %>
      <div class="toolbar-actions"><%= f.submit 'Apply', class: 'btn-primary' %><% if @month != today.beginning_of_month %><%= link_to 'This month', query.call(month: nil), class: 'btn-ghost' %><% end %></div>
    <% end %>
  </div>

  <% if @calendar.truncated? %><p class="text-sm text-mocha">More than <%= Work::Calendar::LIMIT %> items fall in this range; the first <%= Work::Calendar::LIMIT %> are shown. Narrow what is shown.</p><% end %>

  <% if @view == 'month' %>
    <section class="card card-pad" aria-label="<%= @month.strftime('%B %Y') %>">
      <h2 class="section-title mb-3"><%= @month.strftime('%B %Y') %></h2>
      <div class="grid grid-cols-7 gap-px overflow-hidden rounded-card border border-fog bg-fog text-xs">
        <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |name| %><div class="bg-haze px-2 py-1 font-semibold text-mocha"><%= name %></div><% end %>
        <% @days.each do |day| %>
          <% entries = by_day.fetch(day, []) %>
          <div class="min-h-[5.5rem] bg-paper p-1.5 <%= 'opacity-50' if day.month != @month.month %>">
            <p class="<%= day == today ? 'inline-grid h-5 w-5 place-items-center rounded-full bg-olive font-semibold text-cream' : 'text-taupe' %>"><span class="sr-only"><%= day.strftime('%b %-d, %Y') %></span><span aria-hidden="true"><%= day.day %></span></p>
            <ul class="mt-1 space-y-0.5">
              <% entries.first(3).each do |entry| %>
                <% label = [entry.kind.label, work_status_label(entry.item.status), entry.starts_at&.strftime('%-l:%M %p %Z'), entry.place].compact.join(' · ') %>
                <li class="truncate">
                  <%= link_to entry.path, title: "#{entry.item.title} · #{label}", class: "block truncate rounded px-1 py-0.5 hover:underline #{entry.overdue ? 'bg-rose/15 text-rose' : entry.kind.done_statuses.include?(entry.item.status) ? 'bg-fern/15 text-taupe line-through' : entry.kind.calendar == :span ? 'bg-clay/15 text-ink' : 'bg-olive/10 text-ink'}" do %><% if entry.starts_at && entry.first_day == day %><%= entry.starts_at.strftime('%-l:%M%P') %> <% end %><%= entry.item.title %><span class="sr-only"> · <%= label %></span><% end %>
                </li>
              <% end %>
              <% if entries.size > 3 %><li class="px-1"><%= link_to "+#{entries.size - 3} more", query.call(view: 'agenda', anchor: "day-#{day.iso8601}"), class: 'text-taupe hover:underline' %></li><% end %>
            </ul>
          </div>
        <% end %>
      </div>
      <p class="mt-3 text-xs text-taupe"><span class="rounded bg-olive/10 px-1 text-ink">Task deadline</span> · <span class="rounded bg-clay/15 px-1 text-ink">Marketing event</span> · <span class="rounded bg-rose/15 px-1 text-rose">Overdue</span> · <span class="rounded bg-fern/15 px-1 text-taupe line-through">Done</span></p>
    </section>
  <% else %>
    <% days = by_day.keys.select { |day| day.month == @month.month }.sort %>
    <% if days.empty? %>
      <section class="card"><%= empty_state "Nothing due or scheduled in #{@month.strftime('%B %Y')}", hint: 'Try another month, or add a due date to a task or an event in Marketing.' %></section>
    <% else %>
      <section class="card overflow-hidden" aria-label="Agenda">
        <div class="table-region" role="region" tabindex="0" aria-label="Agenda">
          <table class="table">
            <thead><tr>
              <th scope="col" class="th">Date</th><th scope="col" class="th">Time</th><th scope="col" class="th">Item</th><th scope="col" class="th">Kind</th>
              <th scope="col" class="th">Where</th><th scope="col" class="th">Owner</th><th scope="col" class="th">Status</th><th scope="col" class="th"><span class="sr-only">Actions</span></th>
            </tr></thead>
            <tbody>
              <% days.each do |day| %>
                <% by_day[day].each_with_index do |entry, index| %>
                  <tr <%= "id=day-#{day.iso8601}" if index.zero? %>>
                    <td class="td whitespace-nowrap <%= index.zero? ? 'font-medium text-ink' : 'text-taupe' %>"><%= day.strftime('%a, %b %-d') %><% if day == today %> <span class="pill-olive">Today</span><% end %></td>
                    <td class="td whitespace-nowrap text-mocha"><% if entry.starts_at %><%= entry.starts_at.strftime('%-l:%M %p') %><% if entry.ends_at %> – <%= entry.ends_at.to_date == entry.starts_at.to_date ? entry.ends_at.strftime('%-l:%M %p') : entry.ends_at.strftime('%b %-d, %-l:%M %p') %><% end %> <%= entry.starts_at.strftime('%Z') %><% else %>Due<% end %></td>
                    <td class="td font-medium text-ink"><%= link_to entry.item.title, entry.path, class: 'text-olive-deep hover:underline' %></td>
                    <td class="td text-mocha"><%= entry.kind.label %></td>
                    <td class="td text-mocha"><%= entry.place || '—' %></td>
                    <td class="td text-mocha"><%= entry.item.assignee&.display_name || 'Unassigned' %></td>
                    <td class="td"><%= work_status_pill(entry.item.status, overdue: entry.overdue) %></td>
                    <td class="td text-right"><%= link_to 'Open', entry.path, class: 'btn-ghost btn-sm' %></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
