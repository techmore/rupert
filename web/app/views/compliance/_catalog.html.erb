<% base = { location_id: @location.id, tab: 'catalog' } %>
<section class="grid grid-cols-2 gap-3 lg:grid-cols-4" aria-label="Catalog summary">
  <div class="stat"><p class="stat-label">Register</p><p class="stat-value-sm mt-1"><%= @policy.locked_catalog ? 'Approved items only' : 'Not locked' %></p><p class="mt-1 text-xs text-taupe"><%= @location.name %></p></div>
  <div class="stat"><p class="stat-label">Approved items</p><p class="stat-value mt-1"><%= @counts[:approved] - @counts[:suspended] %></p><p class="mt-1 text-xs text-taupe"><%= pluralize(@counts[:suspended], 'suspended item') %></p></div>
  <div class="stat"><p class="stat-label">Approved for card</p><p class="stat-value mt-1"><%= @counts[:card] %></p><p class="mt-1 text-xs text-taupe">The rest sell for cash only</p></div>
  <div class="stat"><p class="stat-label">Catalog drift</p><p class="stat-value mt-1 <%= 'text-rose' if @drift.any? %>"><%= @drift.size %></p><p class="mt-1 text-xs text-taupe">Changes at C-Trax since approval</p></div>
</section>

<section class="section-card" aria-labelledby="register-rules">
  <%= section_heading 'Register rules', id: 'register-rules', hint: 'With the register locked, cashiers see and sell only approved items, under their compliant names, and every sale passes the pre-sale check.' %>
  <% if compliance_editor? %>
    <%= form_with model: @policy, url: compliance_policy_path(@location.id), method: :patch, class: 'flex flex-wrap items-end gap-4' do |f| %>
      <label class="flex items-center gap-2 text-sm"><%= f.check_box :locked_catalog, class: 'checkbox' %> Sell approved items only at <%= @location.name %></label>
      <div><%= f.label :coa_max_age_days, 'A COA is current for (days)', class: 'field-label' %><%= f.number_field :coa_max_age_days, min: 30, max: 1095, class: 'input w-28' %></div>
      <%= f.submit 'Save', class: 'btn-primary' %>
    <% end %>
  <% else %>
    <p class="text-sm text-mocha"><%= @policy.locked_catalog ? 'Locked to approved items.' : 'Not locked.' %> COAs are current for <%= @policy.coa_max_age_days %> days. The owner changes these.</p>
  <% end %>
  <details class="explainer text-sm text-mocha"><summary class="explainer-summary">What the pre-sale check blocks</summary>
    <ul class="mt-3 list-disc space-y-1 pl-5">
      <li>Never sold: items not on this list, suspended items, prohibited categories, and (from Dec 11, 2026) items over 0.4 mg THC per container.</li>
      <li>Card needs a manager override: items not approved for card, and items without a current COA. Cash sells them with a warning about the COA.</li>
      <li>Every sale: the cashier confirms the customer’s ID (21 or older).</li>
      <li>Never possible at the register: custom or open-price items and renaming an item.</li>
    </ul>
    <p class="mt-2">Rupert enforces the list you approve. Which products are legal to sell, and where, is for the owner and counsel to decide.</p>
  </details>
</section>

<% if @drift.any? %>
  <section class="section-card" aria-labelledby="catalog-drift">
    <%= section_heading 'Catalog drift', id: 'catalog-drift', hint: 'Read-only comparison with the latest C-Trax stock read. Nothing is changed at C-Trax.' %>
    <ul class="row-list">
      <% @drift.each do |drift| %>
        <li class="row-item"><div class="min-w-0"><p class="font-semibold text-ink"><%= drift.item.compliant_name %></p><p class="text-xs text-mocha"><%= drift.message %></p></div>
          <div class="row-item-end"><% if compliance_editor? %><%= link_to 'Review', edit_compliance_catalog_item_path(drift.item), class: 'btn-ghost btn-sm' %><% end %></div></li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="toolbar-band" aria-label="Catalog filters">
  <%= form_tag compliance_path, method: :get, class: 'toolbar' do %>
    <%= hidden_field_tag :location_id, @location.id %><%= hidden_field_tag :tab, 'catalog' %>
    <div class="toolbar-field"><%= label_tag :q, 'Search', class: 'field-label' %><%= search_field_tag :q, @query, placeholder: 'Name, SKU or barcode', class: 'search' %></div>
    <div class="toolbar-field"><%= label_tag :filter, 'Show', class: 'field-label' %><%= select_tag :filter, options_for_select([['Approved items', 'approved'], ['Not yet approved', 'unapproved'], ['All C-Trax items', 'all']], @filter), class: 'select' %></div>
    <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary' %></div>
  <% end %>
</section>

<section class="card overflow-hidden" aria-label="Approved catalog">
  <div class="table-region" role="region" tabindex="0" aria-label="Approved catalog">
    <table class="table"><caption class="sr-only">Store items and their approval; prices in USD</caption>
      <thead><tr>
        <th scope="col" class="th">Register name</th><th scope="col" class="th">C-Trax item</th><th scope="col" class="th">Category</th>
        <th scope="col" class="th num">Price</th><th scope="col" class="th">Tenders</th><th scope="col" class="th">COA</th><th scope="col" class="th">Status</th><th scope="col" class="th"><span class="sr-only">Actions</span></th>
      </tr></thead>
      <tbody>
        <% if @rows.empty? %>
          <tr><td class="empty-row" colspan="8"><%= @filter == 'approved' ? 'No approved items yet. Show “Not yet approved” and approve the products this store may sell.' : 'No items match these filters.' %></td></tr>
        <% end %>
        <% @rows.each do |record, item| %>
          <tr>
            <td class="td font-medium text-ink"><%= item&.compliant_name || '—' %><% if item&.receipt_name.present? %><br><span class="text-xs text-mocha">Receipt: <%= item.receipt_name %></span><% end %></td>
            <td class="td text-mocha"><%= record ? record['name'] : item.source_name %><br><span class="text-xs text-taupe"><%= [record&.dig('sku') || item&.sku, "ID #{record ? record['id'] : item.source_variant_id}"].compact.join(' · ') %></span></td>
            <td class="td text-mocha"><%= item&.category_name || record&.dig('category') || '—' %></td>
            <td class="td num"><%= ctrax_money(item&.approved_price_cents || record&.dig('price_cents')) %></td>
            <td class="td"><% if item %><%= item.card_eligible && item.compliance_category.card_eligible && !item.compliance_category.prohibited ? tag.span('Card and cash', class: 'pill-fern') : tag.span('Cash only', class: 'pill-clay') %><% else %><span class="text-taupe">—</span><% end %></td>
            <td class="td"><%= item ? coa_status_pill(item, @policy) : tag.span('—', class: 'text-taupe') %></td>
            <td class="td"><% if item.nil? %><span class="pill-taupe">Not approved</span><% elsif item.compliance_category.prohibited %><span class="pill-rose">Prohibited</span><% elsif item.approved? %><span class="pill-fern">Approved</span><% else %><span class="pill-rose">Suspended</span><% end %></td>
            <td class="td text-right whitespace-nowrap"><% if compliance_editor? %><%= item ? link_to('Edit', edit_compliance_catalog_item_path(item), class: 'btn-ghost btn-sm') : (record && link_to('Approve', new_compliance_catalog_item_path(location_id: @location.id, variant_id: record['id']), class: 'btn-ghost btn-sm')) %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% pages = (@total.to_f / ComplianceController::PAGE_SIZE).ceil %>
  <% if pages > 1 %>
    <nav class="row-list-foot flex gap-2" aria-label="Catalog pages">
      <% if @page > 1 %><%= link_to 'Previous', compliance_path(base.merge(filter: @filter, q: @query.presence, page: @page - 1).compact), class: 'btn-ghost btn-sm' %><% end %>
      <span class="text-sm text-mocha">Page <%= @page %> of <%= pages %></span>
      <% if @page < pages %><%= link_to 'Next', compliance_path(base.merge(filter: @filter, q: @query.presence, page: @page + 1).compact), class: 'btn-ghost btn-sm' %><% end %>
    </nav>
  <% end %>
</section>
