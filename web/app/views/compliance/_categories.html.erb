<section class="section-card" aria-labelledby="categories-title">
  <%= section_heading 'Approved categories', id: 'categories-title', hint: 'Set “Card” only for categories your card processor approved in writing. Prohibited categories never ring up.' %>
  <% if @categories.empty? %><%= empty_state 'No categories yet.', hint: 'Add the categories your processor approved, for example “CBD tinctures (THC free)”.' %><% end %>
  <ul class="row-list">
    <% @categories.each do |category| %>
      <li class="row-item">
        <% if compliance_editor? %>
          <%= form_with model: category, url: compliance_category_path(category, location_id: @location&.id), method: :patch, class: 'flex w-full flex-wrap items-end gap-3' do |f| %>
            <div class="min-w-0 flex-1"><%= f.label :name, 'Name', class: 'field-label' %><%= f.text_field :name, class: 'input', maxlength: 60 %></div>
            <label class="flex items-center gap-2 text-sm"><%= f.check_box :card_eligible, class: 'checkbox' %> Card</label>
            <label class="flex items-center gap-2 text-sm"><%= f.check_box :prohibited, class: 'checkbox' %> Prohibited</label>
            <div class="min-w-0 flex-1"><%= f.label :notes, 'Processor note', class: 'field-label' %><%= f.text_field :notes, class: 'input', maxlength: 500 %></div>
            <%= f.submit 'Save', class: 'btn-ghost' %>
          <% end %>
        <% else %>
          <div class="min-w-0"><p class="font-semibold text-ink"><%= category.name %></p><p class="text-xs text-mocha"><%= category.notes %></p></div>
          <div class="row-item-end"><%= category.prohibited ? tag.span('Prohibited', class: 'pill-rose') : category.card_eligible ? tag.span('Card and cash', class: 'pill-fern') : tag.span('Cash only', class: 'pill-clay') %></div>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if compliance_editor? %>
    <%= form_with model: ComplianceCategory.new, url: compliance_categories_path(location_id: @location&.id), class: 'flex flex-wrap items-end gap-3 border-t border-fog pt-4' do |f| %>
      <div class="min-w-0 flex-1"><%= f.label :name, 'New category', class: 'field-label' %><%= f.text_field :name, class: 'input', maxlength: 60, required: true %></div>
      <label class="flex items-center gap-2 text-sm"><%= f.check_box :card_eligible, class: 'checkbox' %> Card</label>
      <label class="flex items-center gap-2 text-sm"><%= f.check_box :prohibited, class: 'checkbox' %> Prohibited</label>
      <div class="min-w-0 flex-1"><%= f.label :notes, 'Processor note', class: 'field-label' %><%= f.text_field :notes, class: 'input', maxlength: 500 %></div>
      <%= f.submit 'Add category', class: 'btn-primary' %>
    <% end %>
  <% end %>
</section>
