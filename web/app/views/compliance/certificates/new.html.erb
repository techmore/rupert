<div class="page-narrow space-y-6">
  <%= page_header 'Add certificate', subtitle: "Lab certificate of analysis for #{@item.compliant_name}." %>
  <%= form_with model: @certificate, url: compliance_catalog_item_certificates_path(@item), class: 'card card-pad space-y-4' do |f| %>
    <% if @certificate.errors.any? %><div class="flash flash-alert" role="alert"><p><%= @certificate.errors.full_messages.to_sentence %></p></div><% end %>
    <div><%= f.label :document_url, 'Link to the lab report (https)', class: 'field-label' %><%= f.url_field :document_url, required: true, placeholder: 'https://', class: 'input' %>
      <p class="mt-1 text-xs text-mocha">This link is what the receipt QR code opens, so it must be viewable by customers.</p></div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :lab_name, 'Lab', class: 'field-label' %><%= f.text_field :lab_name, required: true, maxlength: 120, class: 'input' %></div>
      <div><%= f.label :report_identifier, 'Report number', class: 'field-label' %><%= f.text_field :report_identifier, maxlength: 120, class: 'input' %></div>
      <div><%= f.label :batch, 'Batch or lot (blank: every batch)', class: 'field-label' %><%= f.text_field :batch, maxlength: 120, class: 'input' %></div>
      <div><%= f.label :tested_on, 'Test date', class: 'field-label' %><%= f.date_field :tested_on, required: true, max: Date.current, class: 'input' %></div>
      <div><%= f.label :expires_on, 'Expiry date (optional)', class: 'field-label' %><%= f.date_field :expires_on, class: 'input' %></div>
    </div>
    <p class="text-xs text-mocha">Rupert records the link and dates. It does not judge the lab’s results or whether the product is legal.</p>
    <div class="form-actions"><%= f.submit 'Save', class: 'btn-primary' %><%= link_to 'Cancel', edit_compliance_catalog_item_path(@item), class: 'btn-ghost' %></div>
  <% end %>
</div>
