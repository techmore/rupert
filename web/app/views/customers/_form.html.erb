<% locked = customer.source != 'manual' %>
<%= form_with model: customer, scope: :customer, url: customer.persisted? ? customer_path(customer) : customers_path, class: 'space-y-6' do |f| %>
  <% if customer.errors.any? %>
    <div role="alert" class="flash flash-alert">
      <p class="font-semibold">Please fix the following:</p>
      <ul class="mt-1 list-disc pl-5"><% customer.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>

  <fieldset class="space-y-4">
    <legend class="card-title">Contact details</legend>
    <% if locked %><p class="text-sm text-mocha" id="contact-locked">Contact details are maintained by <%= directory_label(customer.source) %>. The relationship fields below survive directory refreshes.</p><% end %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :first_name, 'First name', class: 'field-label' %><%= f.text_field :first_name, class: 'input', readonly: locked, autocomplete: 'off', aria: { describedby: (locked ? 'contact-locked' : nil) } %></div>
      <div><%= f.label :last_name, 'Last name', class: 'field-label' %><%= f.text_field :last_name, class: 'input', readonly: locked, autocomplete: 'off', aria: { describedby: (locked ? 'contact-locked' : nil) } %></div>
      <div><%= f.label :email, 'Email', class: 'field-label' %><%= f.email_field :email, class: 'input', readonly: locked, autocomplete: 'off', aria: { describedby: (locked ? 'contact-locked' : nil) } %></div>
      <div><%= f.label :phone, 'Phone', class: 'field-label' %><%= f.telephone_field :phone, class: 'input', readonly: locked, autocomplete: 'off', aria: { describedby: (locked ? 'contact-locked' : nil) } %></div>
    </div>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="card-title">Relationship</legend>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :preferred_name, 'Display name', class: 'field-label' %><%= f.text_field :preferred_name, class: 'input', maxlength: 255, aria: { describedby: 'display-name-hint' } %><p id="display-name-hint" class="mt-1 text-xs text-taupe">Shown instead of the contact name, such as a nickname or business name.</p></div>
      <div><%= f.label :crm_status, 'Relationship', class: 'field-label' %><%= f.select :crm_status, Core::Customer::CRM_STATUSES.map { |s| [s.titleize, s] }, {}, class: 'select w-full' %></div>
      <div><%= f.label :tags, 'Tags', class: 'field-label' %><%= f.text_field :tags, class: 'input', maxlength: 1000, placeholder: 'event, local, referral', aria: { describedby: 'tags-hint' } %><p id="tags-hint" class="mt-1 text-xs text-taupe">Separate with commas.</p></div>
      <div><%= f.label :owner_id, 'Assigned to', class: 'field-label' %><%= f.select :owner_id, @owners.map { |u| [u.display_name, u.id] }, { include_blank: 'Unassigned' }, class: 'select w-full' %></div>
    </div>
  </fieldset>

  <fieldset id="wholesale" class="space-y-4">
    <legend class="card-title">Wholesale</legend>
    <div class="flex items-start gap-3">
      <%= f.check_box :wholesale, class: 'checkbox mt-1', aria: { describedby: 'wholesale-hint' } %>
      <div>
        <%= f.label :wholesale, 'Wholesale customer', class: 'text-sm font-semibold text-ink' %>
        <p id="wholesale-hint" class="text-xs text-taupe">Marks this customer as a business account everywhere they appear. Kept in Rupert only; prices and tax do not change.</p>
      </div>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div><%= f.label :wholesale_business_name, 'Business name', class: 'field-label' %><%= f.text_field :wholesale_business_name, class: 'input', maxlength: 255, autocomplete: 'off' %></div>
      <div><%= f.label :resale_certificate_number, 'Resale certificate number', class: 'field-label' %><%= f.text_field :resale_certificate_number, class: 'input', maxlength: 100, autocomplete: 'off' %></div>
      <div><%= f.label :resale_certificate_expires_on, 'Certificate expires', class: 'field-label' %><%= f.date_field :resale_certificate_expires_on, class: 'input' %></div>
      <div class="sm:col-span-2"><%= f.label :wholesale_notes, 'Wholesale notes', class: 'field-label' %><%= f.text_area :wholesale_notes, rows: 3, class: 'input', maxlength: 2_000, placeholder: 'Terms, buyer contact, delivery days…' %></div>
    </div>
  </fieldset>

  <fieldset>
    <legend class="card-title">Notes</legend>
    <%= f.label :notes, 'Private notes', class: 'sr-only' %>
    <%= f.text_area :notes, rows: 5, class: 'input mt-2', maxlength: 10_000, placeholder: 'Preferences, sizing, anything the team should know…' %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit 'Save', class: 'btn-primary' %>
    <%= link_to 'Cancel', customer.persisted? ? customer_path(customer) : customers_path, class: 'btn-ghost' %>
  </div>
<% end %>
