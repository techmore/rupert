<% content_for :title, 'My time' %>
<% if !Current.user %>
  <%= page_header 'My time', subtitle: 'Your hours, pay and time off, together.' do %>
    <%= link_to 'Sign in', login_path, class: 'btn-primary' %>
  <% end %>
  <p class="text-sm text-mocha">First time here or need a new password? Ask your manager for a private sign-in link.</p>
<% elsif !@worker %>
  <%= render 'shared/learning_welcome' unless @preview %>
  <%= page_header 'My time', subtitle: 'Ask an administrator to link your staff record to see your hours, pay and time off.' do %>
    <% if Current.user.can_manage_accounts? %><%= link_to 'Preview staff member view', employee_app_path(preview: 1), class: 'btn-primary' %><% end %>
  <% end %>
  <% if Current.user.can_manage_accounts? %><p class="text-sm text-mocha">Preview uses example data and makes no changes.</p><% end %>
<% else %>
  <%# The clock first (docs/time-and-pay/DESIGN.md): state and one big button above the fold, then today,
      then the period and the three doors. Lessons fold below everything. %>
  <%= page_header t('time.clock.home.hi', name: @worker.first_name), eyebrow: l(Date.current, format: '%A, %B %-d') do %>
    <% if !@preview && Current.user.can_use_pos? %><%= link_to t('time.clock.home.open_pos'), ctrax_pos_path, class: 'btn-ghost btn-sm' %><% end %>
  <% end %>
  <%= render 'shared/clock_card', worker: @worker, open_shift: @open_shift, preview: @preview, return_to: 'home' %>

  <section class="card card-pad space-y-2" aria-labelledby="today-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="today-heading" class="card-title"><%= t('time.clock.home.next_shift') %></h2>
      <%= link_to t('time.clock.home.open_schedule'), personal_schedule_path, class: 'text-sm text-olive underline' %>
    </div>
    <% shift = @today_shift || @next_shift %>
    <% if shift %>
      <p class="text-lg font-semibold tabular-nums"><%= shift.starts_at.to_date == Date.current ? t('time.clock.home.today') : shift.starts_at.strftime('%a %b %-d') %> · <%= shift.time_label %><%= " · #{shift.label}" if shift.label.present? %></p>
      <% if shift.location %><p class="text-sm text-mocha"><%= shift.location.name %></p><% end %>
    <% else %>
      <p class="text-sm text-mocha"><%= @preview ? 'Your next planned shift shows here.' : t('time.clock.home.no_next_shift') %></p>
    <% end %>
  </section>

  <section class="card card-pad space-y-5" <%= tour_anchor('week') %> aria-labelledby="week-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="week-heading" class="section-title"><%= t('time.clock.home.this_period') %></h2>
      <span class="text-sm text-mocha"><%= period_range(@summary.from, @summary.to) %></span>
    </div>
    <%= render 'shared/square_timecard_sync' unless @preview %>
    <% clocked = @preview ? 0 : @summary.clock_hours %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <div class="stat"><div class="stat-label"><%= t('time.clock.home.clocked') %></div><p class="stat-value mt-2 tabular-nums" data-clocked-hours><%= format_hours(clocked) %><span class="text-lg"> h</span></p><% if @open_shift && !@open_shift.stale_open? %><p class="text-xs text-mocha"><%= t('time.clock.home.including_open') %></p><% end %></div>
      <div class="stat"><div class="stat-label"><%= t('time.clock.home.on_timesheet') %><%= define('timesheet') %></div><p class="stat-value mt-2 tabular-nums"><%= format_hours(@summary.hours) %><span class="text-lg"> h</span></p><% if @timesheet %><p class="mt-1"><%= timesheet_status_pill(@timesheet) %></p><% end %></div>
      <div class="stat col-span-2 sm:col-span-1"><div class="stat-label"><%= t('time.clock.home.estimated_gross') %><%= define('estimated_pay') %></div><% waiting_for_sheet = @summary.hours.zero? && clocked.positive? %><p class="stat-value mt-2 tabular-nums"><%= @summary.gross_cents.nil? || waiting_for_sheet ? '–' : number_to_currency(@summary.gross_cents / 100.0) %></p><% if waiting_for_sheet %><p class="text-xs text-mocha">Appears when your clocked hours are on your timesheet.</p><% end %></div>
    </div>
    <ol class="grid grid-cols-7 gap-1 text-center" aria-label="Hours by day">
      <% (@summary.from..@summary.to).each do |day| %>
        <% day_hours = @preview ? @summary.daily_hours(day) : [@summary.clock_hours(day), @summary.daily_hours(day)].max %>
        <li class="rounded-control px-1 py-3 <%= day == Date.current ? 'bg-olive/10 ring-1 ring-olive/40' : 'bg-haze/50' %>" <%= 'aria-current="date"'.html_safe if day == Date.current %>>
          <p class="text-xs text-mocha"><span aria-hidden="true"><%= day.strftime('%a') %></span><span class="sr-only"><%= day.strftime('%A, %B') %></span></p>
          <p class="mt-1 font-semibold"><%= day.day %></p>
          <p class="mt-1 text-xs tabular-nums"><%= day_hours.positive? ? format_hours(day_hours) : (day > Date.current ? '' : '–') %></p>
        </li>
      <% end %>
    </ol>
    <% unless @preview %>
      <% if @timesheet&.review_note.present? && @timesheet.rejected? %><p class="callout callout-attention text-sm"><strong>Returned:</strong> <%= @timesheet.review_note %></p><% end %>
      <div class="flex flex-wrap items-center gap-3">
        <% week_label = if @timesheet.nil? then t('time.clock.home.week_timesheet_start') elsif @timesheet.rejected? then t('time.clock.home.week_timesheet_fix') else t('time.clock.home.week_timesheet_open') end %>
        <%= button_to week_label, employee_week_path, class: 'btn-primary', data: { turbo: false } %>
        <%= link_to t('time.clock.home.all_timesheets'), people_timesheets_path, class: 'text-sm text-olive underline' %>
      </div>
      <p class="text-xs text-mocha"><%= t('time.clock.home.pay_hint') %></p>
    <% else %><div class="flex flex-wrap items-center gap-3"><%= link_to t('time.clock.home.week_timesheet_open'), employee_preview_timesheet_path('current'), class: 'btn-primary' %><%= link_to t('time.clock.home.all_timesheets'), employee_preview_timesheets_path, class: 'text-sm text-olive underline' %></div><% end %>
  </section>

  <section class="grid gap-3 sm:grid-cols-3">
    <div class="card card-pad space-y-2"><h2 class="card-title"><%= t('time.clock.home.schedule') %></h2><p class="text-sm text-mocha">My shifts, the team’s week, open shifts and trades.</p><%= link_to t('time.clock.home.open_schedule'), personal_schedule_path, class: 'btn-ghost btn-sm' %></div>
    <div class="card card-pad space-y-2"><h2 class="card-title"><%= t('time.clock.home.time_off') %></h2><p class="text-sm text-mocha"><%= @next_leave ? "#{@next_leave.leave_type.titleize} · #{@next_leave.starts_on.strftime('%b %-d')} – #{@next_leave.ends_on.strftime('%b %-d')} · #{@next_leave.status.humanize}" : 'Plan a vacation, request a day off or check your calendar.' %></p><%= link_to t('time.clock.home.open_time_off'), personal_time_off_path, class: 'btn-ghost btn-sm' %></div>
    <div class="card card-pad space-y-2"><h2 class="card-title"><%= t('time.clock.home.pay') %></h2><p class="text-sm text-mocha"><%= @summary.gross_cents && !@preview ? "#{number_to_currency(@summary.gross_cents / 100.0)} #{t('time.clock.home.estimated_gross').downcase}" : 'Hours, tips, bonuses and payslips.' %></p><div class="flex flex-wrap gap-2"><%= link_to t('time.clock.home.open_pay'), @preview ? employee_preview_pay_path : employee_pay_path, class: 'btn-ghost btn-sm' %><%= link_to 'My reports', personal_reports_path, class: 'btn-ghost btn-sm' %></div></div>
  </section>

  <% unless @preview %>
    <details class="explainer">
      <summary class="explainer-summary"><%= t('time.clock.home.welcome_more') %></summary>
      <div class="mt-3"><%= render 'shared/learning_welcome' %></div>
    </details>
  <% end %>
  <p class="text-sm text-mocha"><%= t('time.clock.home.need_help') %> <%= link_to t('time.clock.home.report_problem'), personal_reports_path(anchor: 'problems'), class: 'text-olive underline' %>.</p>
<% end %>
