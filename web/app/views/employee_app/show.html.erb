<% content_for :title, 'My time' %>
<%= render 'shared/learning_welcome' if Current.user && !@preview && !@worker %>
<% if !Current.user %>
  <%= page_header 'My time', subtitle: 'Your hours, pay and time off, together.' do %>
    <%= link_to 'Sign in', login_path, class: 'btn-primary' %>
  <% end %>
  <p class="text-sm text-mocha">First time here or need a new password? Ask your manager for a private sign-in link.</p>
<% elsif !@worker %>
  <%= page_header 'My time', subtitle: 'Ask an administrator to link your staff record to see your hours, pay and time off.' do %>
    <% if Current.user.can_manage_accounts? %><%= link_to 'Preview staff member view', employee_app_path(preview: 1), class: 'btn-primary' %><% end %>
  <% end %>
  <% if Current.user.can_manage_accounts? %><p class="text-sm text-mocha">Preview uses example data and makes no changes.</p><% end %>
<% else %>
  <%= page_header "Hi, #{@worker.first_name}", eyebrow: Date.current.strftime('%A, %B %-d') do %>
    <%= link_to 'My time clock', personal_time_clock_path, class: 'btn-ghost' %>
    <% if !@preview && Current.user.can_use_pos? %><%= link_to 'Open POS', ctrax_pos_path, class: 'btn-ghost' %><% end %>
  <% end %>
  <section class="card card-pad flex flex-wrap items-center justify-between gap-4" <%= tour_anchor('clock') %>>
    <div>
      <h2 class="card-title"><%= @open_shift ? 'You’re clocked in' : @worker.on_leave? ? 'You’re on leave' : 'Ready for your day?' %></h2>
      <% if @open_shift&.stale_open? %>
        <p class="mt-1 text-sm" data-open-clock-out="rupert-<%= @open_shift.id %>"><span class="pill-rose">Never clocked out</span> <%= open_clock_out_label(@open_shift.started_at) %>. These hours don’t count until it’s fixed.</p>
        <%= link_to 'Fix clock-out', fix_clock_out_time_clock_path(@open_shift), class: 'btn-ghost btn-sm mt-2' unless @preview %>
      <% elsif @open_shift %>
        <p class="mt-1 text-2xl font-semibold tabular-nums" data-controller="elapsed-time" data-elapsed-time-start-value="<%= @open_shift.started_at.iso8601 %>"><span data-elapsed-time-target="duration"><%= number_with_precision(@open_shift.hours, precision: 2) %>h</span></p>
        <p class="text-sm text-mocha">Since <%= l(@open_shift.started_at, format: '%-I:%M %p %Z') %></p>
      <% else %><p class="mt-1 text-sm text-mocha"><%= @worker.on_leave? ? 'Your time records and time-off requests are still here.' : 'Clock in when you start working.' %></p><% end %>
    </div>
    <% if @preview %><button type="button" disabled class="btn-primary btn-lg opacity-60">Clock in</button>
    <% elsif @open_shift && @open_shift.started_at >= ClockShift::MAX_SHIFT_HOURS.hours.ago %><%= button_to 'Clock out', clock_out_time_clock_path, params: { shift_id: @open_shift.id }, class: 'btn-primary btn-lg', form: { class: 'w-full sm:w-auto' }, data: { turbo: false } %>
    <% elsif @worker.active? && !@open_shift %><%= button_to 'Clock in', clock_in_time_clock_path, params: { request_token: SecureRandom.uuid }, class: 'btn-primary btn-lg', form: { class: 'w-full sm:w-auto' }, data: { turbo: false } %><% end %>
  </section>
  <%= render 'shared/learning_welcome' unless @preview %>
  <section class="card card-pad space-y-5" <%= tour_anchor('week') %> aria-labelledby="week-heading">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h2 id="week-heading" class="section-title">This pay week</h2>
      <span class="text-sm text-mocha"><%= period_range(@summary.from, @summary.to) %></span>
    </div>
    <%= render 'shared/square_timecard_sync' unless @preview %>
    <% clocked = @preview ? 0 : @summary.clock_hours %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <div class="stat"><div class="stat-label">Clocked</div><p class="stat-value mt-2 tabular-nums" data-clocked-hours><%= format_hours(clocked) %><span class="text-lg"> h</span></p><% if @open_shift && !@open_shift.stale_open? %><p class="text-xs text-mocha">Including your open shift</p><% end %></div>
      <div class="stat"><div class="stat-label">On your timesheet<%= define('timesheet') %></div><p class="stat-value mt-2 tabular-nums"><%= format_hours(@summary.hours) %><span class="text-lg"> h</span></p><% if @timesheet %><p class="mt-1"><%= timesheet_status_pill(@timesheet) %></p><% end %></div>
      <div class="stat col-span-2 sm:col-span-1"><div class="stat-label">Estimated gross pay<%= define('estimated_pay') %></div><% waiting_for_sheet = @summary.hours.zero? && clocked.positive? %><p class="stat-value mt-2 tabular-nums"><%= @summary.gross_cents.nil? || waiting_for_sheet ? '–' : number_to_currency(@summary.gross_cents / 100.0) %></p><% if waiting_for_sheet %><p class="text-xs text-mocha">Appears when your clocked hours are on your timesheet.</p><% end %><% if @summary.gross_cents && !waiting_for_sheet && (rate = @summary.rate_for(Date.current)) && rate.pay_type == 'hourly' && rate.hourly_rate_cents.to_i.positive? %><%= explain_calculation(title: 'Estimated gross pay this week', id: 'pay-calculation', rows: [['Hours on your timesheet', format_hours(@summary.hours, unit: true)], ['× Hourly rate on record', number_to_currency(rate.hourly_rate_cents / 100.0)], ['= Estimated gross', number_to_currency(@summary.gross_cents / 100.0)]], formula: 'hours × hourly rate for each day, overtime at its multiplier', note: 'Before deductions, using the pay rate on record for each day. Overtime and PTO lines use their own multipliers, so the total can differ from plain hours × rate. This is not a payslip.', lesson: 'staff') %><% end %></div>
    </div>
    <ol class="grid grid-cols-7 gap-1 text-center" aria-label="Hours by day">
      <% (@summary.from..@summary.to).each do |day| %>
        <% day_hours = @preview ? @summary.daily_hours(day) : [@summary.clock_hours(day), @summary.daily_hours(day)].max %>
        <li class="rounded-control px-1 py-3 <%= day == Date.current ? 'bg-olive/10 ring-1 ring-olive/40' : 'bg-haze/50' %>" <%= 'aria-current="date"'.html_safe if day == Date.current %>>
          <p class="text-xs text-mocha"><span aria-hidden="true"><%= day.strftime('%a') %></span><span class="sr-only"><%= day.strftime('%A, %B') %></span></p>
          <p class="mt-1 font-semibold"><%= day.day %></p>
          <p class="mt-1 text-xs tabular-nums"><%= day_hours.positive? ? format_hours(day_hours) : (day > Date.current ? '' : '–') %></p>
        </li>
      <% end %>
    </ol>
    <% if (rate = @summary.rate_for(Date.current)) %><p class="text-sm text-mocha">Pay cycle: <%= rate.pay_frequency.humanize %> · Your manager confirms payment dates.</p><% end %>
    <% unless @preview %>
      <% if @timesheet&.review_note.present? && @timesheet.rejected? %><p class="callout callout-attention text-sm"><strong>Returned:</strong> <%= @timesheet.review_note %></p><% end %>
      <div class="flex flex-wrap items-center gap-3">
        <% week_label = if @timesheet.nil? then 'Start this week’s timesheet' elsif @timesheet.rejected? then 'Fix this week’s timesheet' else 'Open this week’s timesheet' end %>
        <%= button_to week_label, employee_week_path, class: 'btn-primary', data: { turbo: false } %>
        <%= link_to 'All my timesheets', people_timesheets_path, class: 'text-sm text-olive underline' %>
      </div>
      <p class="text-xs text-mocha"><%= @timesheet.nil? ? 'Starting the timesheet brings in your finished clock shifts. ' : '' %><%= @summary.gross_cents.nil? ? 'An hourly pay estimate needs a pay rate for every recorded day. Salary pay appears in your finalized payslips.' : 'Pay is an estimate before deductions until your timesheet is approved and paid.' %></p>
    <% else %><div class="flex flex-wrap items-center gap-3"><%= link_to 'Open this week’s timesheet', employee_preview_timesheet_path('current'), class: 'btn-primary' %><%= link_to 'All my timesheets', employee_preview_timesheets_path, class: 'text-sm text-olive underline' %></div><% end %>
  </section>
  <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    <div class="card card-pad space-y-2"><h2 class="card-title">Next shift</h2><p class="text-sm text-mocha"><%= if @preview then 'Your next planned shift shows here.' elsif @next_shift then "#{@next_shift.starts_at.to_date == Date.current ? 'Today' : @next_shift.starts_at.strftime('%a %b %-d')} · #{@next_shift.time_label}#{" · #{@next_shift.role_label}" if @next_shift.role_label.present?}" else 'No shift planned yet.' end %></p><%= link_to 'Open schedule', personal_schedule_path, class: 'btn-ghost btn-sm' %></div>
    <div class="card card-pad space-y-2"><h2 class="card-title">Time off</h2><p class="text-sm text-mocha"><%= @next_leave ? "#{@next_leave.leave_type.titleize} · #{@next_leave.starts_on.strftime('%b %-d')} – #{@next_leave.ends_on.strftime('%b %-d')} · #{@next_leave.status.humanize}" : 'Plan a vacation, request a day off or check your calendar.' %></p><%= link_to 'Open time off', personal_time_off_path, class: 'btn-ghost btn-sm' %></div>
    <div class="card card-pad space-y-2"><h2 class="card-title">My reports</h2><p class="text-sm text-mocha">Check hours, estimated pay and finalized payslips. Download your hours when you need them.</p><%= link_to 'Open my reports', personal_reports_path, class: 'btn-ghost btn-sm' %></div>
  </section>
  <p class="text-sm text-mocha">Need help with time or pay? <%= link_to 'Report a problem or correction', personal_reports_path(anchor: 'problems'), class: 'text-olive underline' %>.</p>
<% end %>
