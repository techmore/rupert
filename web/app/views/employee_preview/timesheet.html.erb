<% content_for :title, 'My timesheet' %>
<%= page_header @worker.name, eyebrow: 'Timesheet', subtitle: @sheet.period_label do %>
  <%= link_to 'All timesheets', employee_preview_timesheets_path, class: 'btn-ghost btn-sm' %>
<% end %>
<section class="timesheet-state" aria-label="Timesheet status"><%= timesheet_status_pill(@sheet) %><p class="text-sm text-mocha">Example data. Staff see what happens next here.</p></section>
<section class="grid grid-cols-2 gap-3"><div class="stat"><p class="stat-label">Total hours</p><p class="stat-value mt-1"><%= format_hours(@summary.hours, unit: true) %></p></div><div class="stat"><p class="stat-label">Estimated gross pay</p><p class="stat-value mt-1"><%= number_to_currency(@summary.gross_cents / 100.0) %></p></div><div class="stat"><p class="stat-label">Commission (1%)</p><p class="stat-value mt-1"><%= number_to_currency(@sheet.commission_cents / 100.0) %></p></div><div class="stat"><p class="stat-label">Card bonus (<%= @sheet.card_redemptions %> &times; $10)</p><p class="stat-value mt-1"><%= number_to_currency(@sheet.card_bonus_cents / 100.0) %></p></div></section>
<section class="section-card">
  <%= section_heading 'Entries' do %><%= link_to 'Download example hours', employee_preview_reports_path(format: :csv, from: @summary.from, to: @summary.to), class: 'btn-ghost btn-sm' %><% end %>
  <% @summary.entries.each do |entry| %><article class="border-b border-fog pb-3 text-sm"><p class="flex flex-wrap justify-between gap-2"><strong><%= entry.worked_on.strftime('%a, %b %-d') %></strong><span><%= entry.work_type.humanize %> · <%= format_hours(entry.hours, unit: true) %></span></p><p class="mt-1 text-mocha"><%= entry.notes %></p></article><% end %>
</section>
<% if @sheet.draft? %>
  <section class="section-card">
    <%= section_heading "Add a day's hours", hint: 'Staff can add or correct draft entries, import their finished shifts and submit for review. These actions are disabled in preview.' %>
    <fieldset disabled class="space-y-3"><div class="grid grid-cols-2 gap-3"><div><label for="preview-worked-on" class="field-label">Date</label><input id="preview-worked-on" type="date" value="<%= Date.current %>" class="input w-full"></div><div><label for="preview-hours" class="field-label">Hours</label><input id="preview-hours" type="number" class="input w-full"></div></div><div><label for="preview-type" class="field-label">Type</label><select id="preview-type" class="select w-full"><% People::TimesheetEntry::WORK_TYPES.each do |type| %><option><%= type.humanize %></option><% end %></select></div><div><label for="preview-notes" class="field-label">Note</label><input id="preview-notes" type="text" class="input w-full"></div><div class="flex flex-wrap gap-3"><button type="button" class="btn-primary">Add hours</button><button type="button" class="btn-ghost">Import clock shifts</button><button type="button" class="btn-ghost">Submit for review</button></div></fieldset>
  </section>
<% else %><p class="card card-pad text-sm text-mocha">Approved hours are read only. Ask your manager if a correction is needed.</p><% end %>
