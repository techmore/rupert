<% presenter = DashboardPresenter.new %>
<div class="space-y-10">
  <section>
    <p class="eyebrow mb-2 text-olive"><%= l(Time.current, format: :long) %></p>
    <h1 class="font-display text-4xl text-ink md:text-5xl">Inventory, in one place.</h1>
    <p class="mt-3 max-w-xl text-mocha">Shopify and Square mirror into a single database — products, quantities, drift, and the money side of every order.</p>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <%= render "home/stat", label: "Active products", value: presenter.product_count, note: "Shopify mirror" %>
    <%= render "home/stat", label: "Tracked variants", value: presenter.variant_count, note: "#{presenter.linked_count} linked to Square" %>
    <%= render "home/stat", label: "Out of sync SKUs", value: presenter.drifting, note: "Shopify vs Square" %>
    <%= render "home/stat", label: "Open alerts", value: presenter.open_alerts, note: "Low stock flags" %>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Latest reconcile runs</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_runs.empty? %>
          <li class="py-3 text-sm text-taupe">No runs yet.</li>
        <% end %>
        <% presenter.recent_runs.each do |run| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= run.mode %> run</p>
              <p class="text-xs text-taupe"><%= l(run.startedAt, format: :short) %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="<%= run.status == "applied" ? "pill-fern" : run.status == "failed" ? "pill-rose" : "pill-taupe" %>"><%= run.status %></span>
              <span class="text-xs text-mocha"><%= run.applied %>/<%= run.actionable %></span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Sync history</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_syncs.empty? %>
          <li class="py-3 text-sm text-taupe">No syncs recorded. Run one from the Sync page.</li>
        <% end %>
        <% presenter.recent_syncs.each do |sync| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= sync.source || sync.mode %> sync</p>
              <p class="text-xs text-taupe"><%= l(sync.startedAt, format: :short) %></p>
            </div>
            <span class="<%= sync.success? ? "pill-fern" : sync.failed? ? "pill-rose" : "pill-taupe" %>"><%= sync.status %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Revenue · last 30 days</h2>
        <span class="text-xs text-taupe">per source</span>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-4">
        <% presenter.ledger_groups.each do |source, gross, count| %>
          <div class="rounded-xl bg-haze px-4 py-3">
            <dt class="text-xs font-medium capitalize text-mocha"><%= source %></dt>
            <dd class="font-display text-2xl text-ink"><%= number_to_currency(gross.to_i / 100.0) %></dd>
            <dd class="text-xs text-taupe"><%= count %> orders</dd>
          </div>
        <% end %>
        <% if presenter.ledger_groups.empty? %>
          <p class="text-sm text-taupe">No ledger entries this month.</p>
        <% end %>
      </dl>
    </div>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Stock alerts · last 14 days</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_alerts.empty? %>
          <li class="py-3 text-sm text-taupe">No recent alerts.</li>
        <% end %>
        <% presenter.recent_alerts.each do |alert| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= alert.sku.presence || alert.id.first(10) %></p>
              <p class="text-xs text-taupe"><%= l(alert.createdAt, format: :short) %></p>
            </div>
            <span class="<%= alert.quantity <= 0 ? "pill-rose" : "pill-clay" %>"><%= alert.quantity %> / <%= alert.threshold %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>
