<% presenter = DashboardPresenter.new %>
<div class="space-y-8">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow mb-2 text-olive"><%= l(Time.current, format: :long) %></p>
      <h1 class="font-display text-4xl text-ink md:text-5xl">Good morning.</h1>
      <p class="mt-3 max-w-xl text-mocha">Daily business at a glance — sales, orders, and inventory health across Shopify and Square.</p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <%= form_tag syncs_path, method: :post do %>
        <%= submit_tag "Sync now", class: "btn-primary", data: { disable_with: "Syncing…" } %>
      <% end %>
      <% if (last_sync = presenter.last_sync) %>
        <p class="text-xs text-taupe">
          Last <%= last_sync.success? ? "synced" : "sync" %> <%= time_ago_in_words(last_sync.startedAt) %> ago
          <span class="<%= last_sync.success? ? "pill-fern" : "pill-rose" %>"><%= last_sync.status %></span>
        </p>
      <% else %>
        <p class="text-xs text-taupe">No syncs yet — hit Sync now.</p>
      <% end %>
    </div>
  </section>

  <section class="grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-6">
    <%= render "home/stat", label: "Today's sales", value: number_to_currency(presenter.today_revenue.to_i / 100.0), note: "#{presenter.today_orders} orders" %>
    <%= render "home/stat", label: "Yesterday", value: number_to_currency(presenter.yesterday_revenue.to_i / 100.0), note: vs_yesterday(presenter.today_revenue, presenter.yesterday_revenue) %>
    <%= render "home/stat", label: "Last 7 days", value: number_to_currency(presenter.week_revenue.to_i / 100.0), note: "#{presenter.month_revenue.to_i / 100} this month" %>
    <%= render "home/stat", label: "Out of sync SKUs", value: presenter.reconcile_summary[:drift_count], note: "#{presenter.reconcile_summary[:actionable]} actionable" %>
    <%= render "home/stat", label: "Low stock alerts", value: presenter.open_alerts, note: "#{presenter.stockouts} at zero" %>
    <%= render "home/stat", label: "Active products", value: presenter.product_count, note: "#{presenter.linked_count} linked to Square" %>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Today · per channel</h2>
        <span class="text-xs text-taupe">gross revenue</span>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-4">
        <% presenter.today_groups.each do |source, gross, count| %>
          <div class="rounded-xl bg-haze px-4 py-3">
            <dt class="text-xs font-medium capitalize text-mocha"><%= source %></dt>
            <dd class="font-display text-2xl text-ink"><%= number_to_currency(gross.to_i / 100.0) %></dd>
            <dd class="text-xs text-taupe"><%= count %> orders</dd>
          </div>
        <% end %>
        <% if presenter.today_groups.empty? %>
          <p class="text-sm text-taupe">No sales recorded yet today.</p>
        <% end %>
      </dl>
    </div>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Needs attention</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% attention_items(presenter).each do |item| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= item[:label] %></p>
              <p class="text-xs text-taupe"><%= item[:note] %></p>
            </div>
            <span class="<%= item[:pill] %> shrink-0"><%= item[:value] %></span>
          </li>
        <% end %>
        <% if attention_items(presenter).empty? %>
          <li class="py-3 text-sm text-taupe">All quiet — nothing needs attention.</li>
        <% end %>
      </ul>
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Stock alerts · last 14 days</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_alerts.empty? %>
          <li class="py-3 text-sm text-taupe">No recent alerts.</li>
        <% end %>
        <% presenter.recent_alerts.each do |alert| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= alert.sku.presence || alert.id.first(10) %></p>
              <p class="text-xs text-taupe"><%= l(alert.createdAt, format: :short) %></p>
            </div>
            <span class="<%= alert.quantity <= 0 ? "pill-rose" : "pill-clay" %>"><%= alert.quantity %> / <%= alert.threshold %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Revenue · last 30 days</h2>
        <span class="text-xs text-taupe">per source</span>
      </div>
      <dl class="mt-4 grid grid-cols-2 gap-4">
        <% presenter.ledger_groups.each do |source, gross, count| %>
          <div class="rounded-xl bg-haze px-4 py-3">
            <dt class="text-xs font-medium capitalize text-mocha"><%= source %></dt>
            <dd class="font-display text-2xl text-ink"><%= number_to_currency(gross.to_i / 100.0) %></dd>
            <dd class="text-xs text-taupe"><%= count %> orders</dd>
          </div>
        <% end %>
        <% if presenter.ledger_groups.empty? %>
          <p class="text-sm text-taupe">No ledger entries this month.</p>
        <% end %>
      </dl>
    </div>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Sync history</h2>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_syncs.empty? %>
          <li class="py-3 text-sm text-taupe">No syncs recorded. Run one from the Sync page.</li>
        <% end %>
        <% presenter.recent_syncs.each do |sync| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= sync.source || sync.mode %> sync</p>
              <p class="text-xs text-taupe"><%= l(sync.startedAt, format: :short) %></p>
            </div>
            <span class="<%= sync.success? ? "pill-fern" : sync.failed? ? "pill-rose" : "pill-taupe" %>"><%= sync.status %></span>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Latest reconcile runs</h2>
        <%= link_to "Reconcile", reconcile_index_path, class: "text-xs font-semibold text-olive hover:underline" %>
      </div>
      <ul class="mt-4 divide-y divide-fog">
        <% if presenter.recent_runs.empty? %>
          <li class="py-3 text-sm text-taupe">No runs yet.</li>
        <% end %>
        <% presenter.recent_runs.each do |run| %>
          <li class="flex items-center justify-between gap-4 py-3">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-ink"><%= run.mode %> run</p>
              <p class="text-xs text-taupe"><%= l(run.startedAt, format: :short) %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="<%= run.status == "applied" ? "pill-fern" : run.status == "failed" ? "pill-rose" : "pill-taupe" %>"><%= run.status %></span>
              <span class="text-xs text-mocha"><%= run.applied %>/<%= run.actionable %></span>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>
