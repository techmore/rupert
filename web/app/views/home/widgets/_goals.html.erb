<div class="card card-pad">
  <div class="flex items-baseline justify-between">
    <h2 class="font-display text-xl text-ink">Goals & KPIs</h2>
    <%= link_to "All", goals_goals_path, class: "text-xs font-semibold text-olive hover:underline" %>
  </div>
  <ul class="mt-4 divide-y divide-fog">
    <% Goals::Goal.active.order(updated_at: :desc).limit(4).each do |goal| %>
      <li class="py-3">
        <div class="flex items-center justify-between gap-4">
          <p class="truncate text-sm font-medium text-ink"><%= goal.name %></p>
          <span class="<%= goal.progress_pct && goal.progress_pct >= 100 ? "pill-fern" : "pill-olive" %> shrink-0"><%= goal.progress_pct ? "#{goal.progress_pct}%" : "—" %></span>
        </div>
        <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-haze">
          <div class="h-full rounded-full bg-olive" style="width: <%= goal.progress_pct || 0 %>%"></div>
        </div>
      </li>
    <% end %>
    <% Goals::Kpi.order(updated_at: :desc).limit(3).each do |kpi| %>
      <li class="flex items-center justify-between gap-4 py-3">
        <p class="truncate text-sm font-medium text-ink"><%= kpi.name %></p>
        <span class="<%= kpi.on_track? ? "pill-fern" : "pill-clay" %> shrink-0"><%= number_with_precision(kpi.latest_value, precision: 2) %> / <%= number_with_precision(kpi.target_value, precision: 2) %></span>
      </li>
    <% end %>
    <% if Goals::Goal.active.count.zero? && Goals::Kpi.count.zero? %>
      <li class="py-3 text-sm text-taupe">No goals or KPIs yet.</li>
    <% end %>
  </ul>
</div>
