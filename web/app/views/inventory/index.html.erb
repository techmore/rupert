<% content_for :title, "Inventory" %>
<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl text-ink">Inventory</h1>
      <p class="mt-1 text-sm text-mocha">Products mirrored from Shopify, with quantities on both sides.</p>
    </div>
    <div class="flex gap-2">
      <%= link_to "Manual counts", inventory_counts_path, class: "btn-ghost" %>
      <%= link_to "New count", new_inventory_count_path, class: "btn-primary" %>
    </div>
  </section>

  <%= form_tag inventory_index_path, method: :get, class: "max-w-sm" do %>
    <input type="search" name="q" value="<%= @q %>" placeholder="Search products or SKUs…" class="search w-full" autocomplete="off">
  <% end %>

  <% size_items = @products.sum { |product| product.variants.count { |v| @variant_qtys[v.id]&.dig(:size) } } %>
  <% if size_items.positive? %>
    <div class="rounded-xl border border-olive/20 bg-olive/5 px-4 py-2.5 text-sm text-ink">
      <span class="font-semibold"><%= pluralize(size_items, "size-derived variant") %></span> on this page is reconciled from its gram root (e.g. 3.5g / 7g / 14g / 28g) rather than Square realtime — see
      <%= link_to "Sizes", size_families_path, class: "font-semibold text-olive hover:underline" %>.
    </div>
  <% end %>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr>
            <th scope="col" class="th">Product / Variant</th>
            <th scope="col" class="th">SKU</th>
            <th scope="col" class="th text-right">Price</th>
            <th scope="col" class="th text-right">Shopify</th>
            <th scope="col" class="th text-right">Square</th>
            <th scope="col" class="th text-right">Drift</th>
            <th scope="col" class="th">Linked</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <% if @products.empty? %>
            <tr>
              <td class="td py-8 text-center text-taupe"><%= @q.present? ? "Nothing matches that search." : "No products mirrored yet — run a sync." %></td>
            </tr>
          <% end %>
          <% @products.each do |product| %>
            <% product.variants.sort_by(&:title).each do |variant| %>
              <% info = @variant_qtys.fetch(variant.id, {}) %>
              <% shopify_qty = info[:shopify_qty] || 0 %>
              <% link = info[:link] %>
              <% square_qty = info[:square_qty] %>
              <% drift = square_qty != nil ? square_qty - shopify_qty : nil %>
              <tr class="hover:bg-cream">
                <td class="td">
                  <div class="flex items-center gap-3">
                    <% if (thumb = product.thumbnail_url) %>
                      <%= image_tag thumb, alt: product.title, loading: "lazy", class: "h-10 w-10 shrink-0 rounded-lg border border-fog bg-haze object-cover" %>
                    <% else %>
                      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-fog bg-haze font-display text-base text-taupe"><%= product.title.first.upcase %></span>
                    <% end %>
                    <div class="min-w-0">
                      <p class="truncate font-medium text-ink"><%= link_to variant.title, shopify_variant_path(variant), class: "hover:text-olive hover:underline" %></p>
                      <p class="truncate text-xs text-taupe"><%= product.title %></p>
                      <% if (size = info[:size]) %>
                        <span class="mt-1 inline-flex flex-wrap items-center gap-1.5">
                          <span class="pill-olive">size <%= size[:grams] %>g</span>
                          <% if size[:root].nil? %>
                            <span class="pill-taupe">no root set</span>
                          <% elsif size[:pending] %>
                            <span class="pill-rose">pending → <%= size[:pending].target_quantity %></span>
                          <% elsif size[:target] == square_qty %>
                            <span class="pill-fern">in sync · <%= size[:target] %></span>
                          <% else %>
                            <span class="pill-taupe">target <%= size[:target] %> · root <%= number_with_precision(size[:root], precision: 1) %>g</span>
                          <% end %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                </td>
                <td class="td font-mono text-xs text-mocha"><%= variant.sku.presence || "—" %></td>
                <td class="td text-right font-medium text-ink"><%= number_to_currency(variant.price) %></td>
                <td class="td text-right text-mocha"><%= shopify_qty %></td>
                <td class="td text-right text-mocha"><%= square_qty || "—" %></td>
                <td class="td text-right">
                  <% if drift.nil? %>
                    <span class="font-medium text-taupe">—</span>
                  <% else %>
                    <span class="<%= drift == 0 ? "font-medium text-taupe" : "font-semibold text-clay" %>">
                      <%= drift == 0 ? "—" : drift.positive? ? "+#{drift}" : drift %>
                    </span>
                  <% end %>
                </td>
                <td class="td"><%= link ? content_tag(:span, "linked", class: "pill-fern") : content_tag(:span, "unlinked", class: "pill-taupe") %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @products.length >= 40 %>
    <p class="text-xs text-taupe">Showing the first 40 products — refine your search to narrow down.</p>
  <% end %>
</div>
