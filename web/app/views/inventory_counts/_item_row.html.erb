<div data-row class="flex items-center gap-2">
  <input type="text" name="items[][sku]" value="<%= item.sku %>" list="known-skus" placeholder="SKU" class="input flex-1 font-mono" autocomplete="off">
  <input type="number" name="items[][quantity]" value="<%= item.quantity.to_i.positive? ? item.quantity : "" %>" min="0" placeholder="Qty" class="input w-24">
  <button type="button" data-remove-row class="text-xs font-medium text-taupe hover:text-rose">Remove</button>
</div>
