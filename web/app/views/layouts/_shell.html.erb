<div class="min-h-full">
  <header class="sticky top-0 z-20 border-b border-fog bg-oat/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-3">
      <%= link_to root_path, class: "flex items-center gap-3" do %>
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-olive font-display text-lg text-cream">R</span>
        <span class="hidden font-display text-lg text-ink sm:block">Rupert</span>
      <% end %>

      <% if Current.user %>
        <nav class="flex items-center gap-1 overflow-x-auto" aria-label="Module areas">
          <% nav_areas.each do |area| %>
            <%= link_to area[:name], safe_module_path(area[:modules].first),
              class: "nav-pill shrink-0 #{area[:key] == active_area_key ? "nav-pill-active" : "nav-pill-idle"}",
              aria: { current: (area[:key] == active_area_key ? "page" : nil) } %>
          <% end %>
        </nav>

        <div class="flex items-center gap-3">
          <% if Current.user.super_admin? %>
            <%= link_to "Tenants", tenants_path, class: "nav-pill nav-pill-idle" %>
          <% end %>
          <button type="button" onclick="window.dispatchEvent(new Event('rupert:open-search'))" class="nav-pill nav-pill-idle" aria-label="Search" title="Search — press /">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="hidden sm:inline">Search</span>
            <kbd class="hidden rounded bg-haze px-1.5 font-mono text-[10px] text-taupe md:inline">/</kbd>
          </button>
          <% if @last_sync %>
            <% synced = @last_sync.success? %>
            <span class="<%= synced ? "pill-fern" : "pill-clay" %>" title="<%= l(@last_sync.startedAt, format: :long) %>">
              <span class="dot <%= synced ? "bg-fern" : "bg-clay" %>"></span>
              <%= synced ? "Synced" : "Needs sync" %>
            </span>
          <% else %>
            <span class="pill-taupe">
              <span class="dot bg-taupe"></span>
              Never synced
            </span>
          <% end %>

          <span class="hidden text-sm text-mocha lg:block"><%= Current.user.email %></span>
          <%= button_to "Sign out", logout_path, method: :delete, class: "nav-pill border border-fog bg-paper hover:bg-haze" %>
        </div>
      <% end %>
    </div>
  </header>

  <% if Current.user && active_area_modules.length > 1 %>
    <div class="border-b border-fog bg-cream/70">
      <div class="mx-auto max-w-6xl overflow-x-auto px-6">
        <nav class="flex items-center gap-1 py-1.5" aria-label="Module">
          <% active_area_modules.each do |entry| %>
            <%= link_to entry.name, safe_module_path(entry),
              class: "nav-pill #{active_module_entry&.key == entry.key ? "nav-pill-active-sm" : "nav-pill-idle-sm"}",
              aria: { current: (active_module_entry&.key == entry.key ? "page" : nil) } %>
          <% end %>
        </nav>
      </div>
    </div>
  <% end %>

  <main class="mx-auto max-w-6xl px-6 py-8">
    <% if notice %><div role="status" class="mb-4 rounded-xl border border-fern/30 bg-fern/10 px-4 py-2.5 text-sm text-fern"><%= notice %></div><% end %>
    <% if alert %><div role="alert" class="mb-4 rounded-xl border border-rose/30 bg-rose/10 px-4 py-2.5 text-sm text-rose"><%= alert %></div><% end %>
    <%= yield %>
  </main>
</div>

<% if Current.user %>
  <div data-controller="search" data-action="rupert:open-search@window->search#open" class="fixed inset-0 z-50 hidden items-start justify-center px-4 pt-[12vh]">
    <div class="fixed inset-0 bg-ink/30" data-action="click->search#close"></div>
    <div class="relative w-full max-w-xl overflow-hidden rounded-2xl border border-fog bg-paper shadow-2xl" role="dialog" aria-label="Search">
      <div class="flex items-center gap-2 border-b border-fog px-4 py-3">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-taupe" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" data-search-target="input" data-action="input->search#search keydown->search#keydown" placeholder="Search orders, customers, SKUs, employees…" class="w-full bg-transparent text-sm text-ink outline-none placeholder:text-taupe" autocomplete="off" aria-label="Search">
        <button type="button" data-action="search#close" class="rounded-full bg-haze px-2 py-0.5 text-xs text-taupe hover:text-ink" aria-label="Close">esc</button>
      </div>
      <div data-search-target="results" class="max-h-[50vh] overflow-y-auto py-1"></div>
      <div data-search-target="empty" class="hidden px-4 py-6 text-center text-sm text-taupe">No matches — try an order number, customer, or SKU.</div>
    </div>
  </div>
<% end %>
