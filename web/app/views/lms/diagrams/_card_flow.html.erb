<%# The life of a card payment: from tap to money in the bank. Real text, so it reads aloud and reflows on a phone. %>
<figure class="lms-figure" aria-labelledby="fig-card-flow">
  <figcaption id="fig-card-flow" class="lms-figure-caption">From tap to deposit</figcaption>
  <ol class="lms-flow">
    <li class="lms-flow-step"><span class="lms-flow-when">0 s</span><span class="lms-flow-what">Tap, dip or swipe</span><span class="lms-flow-who">P18 terminal reads the chip and encrypts the card</span></li>
    <li class="lms-flow-step"><span class="lms-flow-when">1–3 s</span><span class="lms-flow-what">Authorization</span><span class="lms-flow-who">Processor → card network → customer's bank says yes or no and holds the amount</span></li>
    <li class="lms-flow-step"><span class="lms-flow-when">Same moment</span><span class="lms-flow-what">Capture</span><span class="lms-flow-who">The approved sale is marked “charge this”; tips can still be adjusted</span></li>
    <li class="lms-flow-step"><span class="lms-flow-when">End of day</span><span class="lms-flow-what">Batch close</span><span class="lms-flow-who">All captured sales go to the processor in one bundle</span></li>
    <li class="lms-flow-step"><span class="lms-flow-when">Overnight</span><span class="lms-flow-what">Settlement</span><span class="lms-flow-who">Networks move the money between the banks and take their fees</span></li>
    <li class="lms-flow-step"><span class="lms-flow-when">1–3 business days</span><span class="lms-flow-what">Funding</span><span class="lms-flow-who">Our merchant account deposits to our checking account</span></li>
  </ol>
</figure>
