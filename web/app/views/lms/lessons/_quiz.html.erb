<% questions = lesson.questions.to_a %>
<% if questions.empty? %>
  <%= form_with url: quiz_lms_course_lesson_path(course, lesson), method: :post, class: 'section-card', id: 'lms-quiz' do %>
    <h2 class="section-title"><%= t('lms.lesson.quiz_title') %></h2>
    <p class="text-sm text-mocha"><%= t('lms.lesson.no_quiz') %></p>
    <% unless progress&.passed? %><div class="form-actions"><%= submit_tag t('lms.lesson.mark_read'), class: 'btn-primary' %></div><% end %>
  <% end %>
<% else %>
  <%= form_with url: quiz_lms_course_lesson_path(course, lesson), method: :post, class: 'section-card scroll-mt-6', id: 'lms-quiz', data: { busy: false } do %>
    <div class="card-head"><div><h2 class="section-title"><%= t('lms.lesson.quiz_title') %></h2><p class="card-hint"><%= t('lms.lesson.quiz_hint') %></p></div></div>
    <% if result && !result.passed? %>
      <div id="quiz-feedback" class="flash flash-alert" role="alert"><p><%= t('lms.quiz.try_again', count: result.wrong.size) %></p></div>
    <% end %>
    <% questions.each_with_index do |question, q_index| %>
      <% chosen = result&.answered(question) %>
      <% wrong = result&.wrong?(question) %>
      <% right = result && !wrong %>
      <fieldset class="quiz-question lms-question <%= 'lms-question-wrong' if wrong %> <%= 'lms-question-right' if right %>" <%= 'aria-describedby=quiz-feedback' if wrong %>>
        <legend class="font-semibold"><span class="text-olive-deep"><%= q_index + 1 %>.</span> <%= question.prompt %><% if wrong %> <span class="pill-rose"><%= t('lms.lesson.incorrect') %></span><% elsif right %> <span class="pill-fern"><%= t('lms.lesson.correct') %></span><% end %></legend>
        <div class="mt-3 space-y-2">
          <% question.choices.each_with_index do |choice, index| %>
            <% selected = chosen == index.to_s || (right && question.correct?(index)) %>
            <label class="lms-choice <%= 'quiz-wrong' if wrong && chosen == index.to_s %> <%= 'lms-choice-right' if right && question.correct?(index) %>">
              <%= radio_button_tag "answers[#{question.id}]", index, selected, required: true, id: "answers_#{question.id}_#{index}", disabled: right, class: 'lms-choice-input' %>
              <span class="text-sm"><%= choice %></span>
            </label>
          <% end %>
          <% if right %><%= hidden_field_tag "answers[#{question.id}]", question.answer_index, id: "answers_#{question.id}_keep" %><% end %>
        </div>
        <% if result && question.explanation.present? %><p class="lms-explanation <%= wrong ? 'lms-explanation-wrong' : 'lms-explanation-right' %>"><%= question.explanation %></p><% end %>
      </fieldset>
    <% end %>
    <div class="form-actions"><%= submit_tag progress&.passed? ? t('lms.index.review') : t('lms.lesson.check'), class: 'btn-primary', data: { turbo_submits_with: t('lms.lesson.checking') } %><% if progress&.passed? %><p class="text-xs text-mocha"><%= t('lms.lesson.quiz_passed') %></p><% end %></div>
  <% end %>
<% end %>
