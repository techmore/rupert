<% content_for :title, 'Rupert stock' %>
<% can_write = Current.user.can?('inventory.write') %>
<div class="page-narrow space-y-5">
  <%= page_header 'Rupert stock', subtitle: (@site ? "Rupert’s own counts at #{@site.name}. Recording here does not change Shopify, C-Trax or Square." : 'Rupert’s own stock counts per site.'),
        menu: [['Ledger', master_stock_movements_path(site_id: @site&.id)], ['Push preview', master_stock_push_preview_path(site_id: @site&.id)], ['Setup', master_stock_setup_path], (['Add item', new_master_stock_item_path] if can_write)].compact %>
  <% if @site.nil? %>
    <%= render 'master_stock/no_sites' %>
  <% else %>
    <%= render 'master_stock/site_picker', sites: @sites, site: @site, path: :master_stock_items_path %>
    <%= form_with url: master_stock_items_path, method: :get, class: 'toolbar' do %>
      <%= hidden_field_tag :site_id, @site.id %>
      <%= hidden_field_tag :all, params[:all] if params[:all] == '1' %>
      <div class="toolbar-field grow"><%= label_tag :q, 'Find item', class: 'field-label' %><%= search_field_tag :q, @query, class: 'input font-mono', placeholder: 'Scan or type SKU, barcode or name', autofocus: true, autocomplete: 'off', maxlength: 255 %></div>
      <div class="toolbar-actions"><%= submit_tag 'Find', class: 'btn-primary', name: nil %><% if @query.present? %><%= link_to 'Clear', master_stock_items_path(site_id: @site.id), class: 'btn-ghost' %><% end %></div>
    <% end %>
    <p class="text-xs text-taupe">
      <% if params[:all] == '1' %>Showing every Rupert item. <%= link_to "Only items at #{@site.name}", master_stock_items_path(site_id: @site.id, q: @query.presence), class: 'underline' %>
      <% else %>Showing items linked or counted at <%= @site.name %>. <%= link_to 'Show all items', master_stock_items_path(site_id: @site.id, q: @query.presence, all: 1), class: 'underline' %><% end %>
    </p>

    <ul class="space-y-3" aria-label="Items">
      <% @items.each do |item| %>
        <% balance = @balances[item.id] %>
        <li class="card card-pad space-y-3">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <%= link_to item.name, master_stock_item_path(item, site_id: @site.id), class: 'font-semibold text-ink hover:underline' %><% if @exact %> <span class="pill-fern">Exact code match</span><% end %>
              <p class="text-xs text-taupe font-mono"><%= [item.sku, item.barcode].compact_blank.join(' · ').presence || 'No SKU or barcode' %></p>
            </div>
            <div class="text-right shrink-0">
              <% if balance %>
                <p class="stat-value-sm text-ink" aria-label="On hand"><%= balance.on_hand %></p>
                <p class="text-xs text-taupe">on hand</p>
              <% else %>
                <span class="pill-clay">Not counted</span>
              <% end %>
            </div>
          </div>
          <% if can_write %>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
              <% (balance ? StockLedgerEntry::STAFF_KINDS : %w[count]).each do |kind| %>
                <%= link_to({ 'count' => 'Count', 'receive' => 'Receive', 'adjust' => 'Adjust', 'transfer' => 'Transfer' }.fetch(kind),
                      new_master_stock_movement_path(kind: kind, item_id: item.id, site_id: @site.id, return_q: @query.presence),
                      class: "#{kind == 'count' && balance.nil? ? 'btn-primary' : 'btn-ghost'} btn-lg justify-center") %>
              <% end %>
            </div>
          <% end %>
        </li>
      <% end %>
      <% if @items.empty? %>
        <li class="card card-pad text-sm text-mocha">
          <%= @query.present? ? "Nothing matches “#{@query}”." : "No items at #{@site.name} yet." %>
          <% if can_write %><%= link_to 'Add an item', new_master_stock_item_path, class: 'font-semibold text-olive-deep underline' %> or <%= link_to 'start tracking from a platform', master_stock_setup_path, class: 'font-semibold text-olive-deep underline' %>.<% end %>
        </li>
      <% end %>
    </ul>
    <% if @pagy.pages > 1 %><div class="text-xs text-taupe"><%== @pagy.series_nav %></div><% end %>
  <% end %>
</div>
