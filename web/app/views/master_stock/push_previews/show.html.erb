<% content_for :title, 'Push preview' %>
<div class="space-y-5">
  <%= page_header 'Push preview', subtitle: 'A dry run: what Rupert would change on each platform to match its own stock. Nothing is sent.',
        menu: [['Rupert stock', master_stock_items_path(site_id: @site&.id)], ['Setup', master_stock_setup_path]] %>
  <% if @site.nil? %>
    <%= render 'master_stock/no_sites' %>
  <% else %>
    <%= render 'master_stock/site_picker', sites: @sites, site: @site, path: :master_stock_push_preview_path, extra: { platform: @platform } %>
    <%= page_tabs(StockSite::PLATFORMS.map { |p| [MasterStock.platform_label(p), master_stock_push_preview_path(site_id: @site.id, platform: p), p == @platform] }, label: 'Platform') %>

    <div class="flash flash-alert" role="note">
      <strong>Preview only. Live pushing is off and needs owner approval.</strong>
      Sales made on <%= MasterStock.platform_label(@platform) %> or another channel after Rupert’s last count are not yet applied to Rupert’s number, so a push long after a count would undo them.
    </div>

    <% blocker = @preview.platform_blocker %>
    <% summary = @preview.summary %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="card card-pad"><p class="stat-label">Would change</p><p class="stat-value"><%= summary[:change] %></p><p class="text-xs text-taupe">−<%= summary[:units_down] %> / +<%= summary[:units_up] %> units</p></div>
      <div class="card card-pad"><p class="stat-label">Blocked</p><p class="stat-value"><%= summary[:blocked] %></p></div>
      <div class="card card-pad"><p class="stat-label">Already match</p><p class="stat-value"><%= summary[:in_sync] %></p></div>
      <div class="card card-pad"><p class="stat-label"><%= MasterStock.platform_label(@platform) %> read</p><p class="text-sm font-semibold text-ink"><%= @preview.snapshot_at ? "#{time_ago_in_words(@preview.snapshot_at)} ago" : 'Never' %></p><p class="text-xs text-taupe"><%= @preview.location&.name || 'No location mapped' %></p></div>
    </div>
    <% if blocker %><p class="flash flash-alert" role="status"><%= blocker %></p><% end %>
    <p class="text-sm text-mocha"><%= MasterStock::PushPreview::PLATFORM_WRITES.fetch(@platform) %></p>

    <div class="toolbar-band">
      <%= form_with url: master_stock_push_preview_path, method: :get, class: 'toolbar' do %>
        <%= hidden_field_tag :site_id, @site.id %><%= hidden_field_tag :platform, @platform %>
        <div class="toolbar-field"><%= label_tag :status, 'Show', class: 'field-label' %><%= select_tag :status, options_for_select([['Would change', 'change'], ['Blocked', 'blocked'], ['Already match', 'in_sync']], @status), include_blank: 'Everything', class: 'input' %></div>
        <div class="toolbar-actions"><%= submit_tag 'Apply', class: 'btn-primary', name: nil %></div>
      <% end %>
    </div>

    <ul class="space-y-3" aria-label="Proposed platform writes">
      <% @rows.each do |row| %>
        <li class="card card-pad space-y-2">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <%= link_to row.item.name, master_stock_item_path(row.item), class: 'font-semibold text-ink hover:underline' %>
              <p class="font-mono text-xs text-taupe break-all"><%= row.link.native_item_id %></p>
            </div>
            <span class="<%= { 'change' => 'pill-clay', 'blocked' => 'pill-taupe', 'in_sync' => 'pill-fern' }.fetch(row.status) %>"><%= { 'change' => 'Would change', 'blocked' => 'Blocked', 'in_sync' => 'Matches' }.fetch(row.status) %></span>
          </div>
          <dl class="grid grid-cols-3 gap-2 text-sm">
            <div><dt class="text-xs text-taupe"><%= MasterStock.platform_label(@platform) %> now</dt><dd class="font-semibold tabular-nums"><%= row.observed.nil? ? 'Unknown' : row.observed %></dd></div>
            <div><dt class="text-xs text-taupe">Rupert</dt><dd class="font-semibold tabular-nums"><%= row.target.nil? ? 'Not counted' : row.target %></dd></div>
            <div><dt class="text-xs text-taupe">Change</dt><dd class="font-semibold tabular-nums"><%= row.change.nil? ? '—' : (row.change.positive? ? "+#{row.change}" : row.change) %></dd></div>
          </dl>
          <p class="text-sm text-ink"><%= row.action %></p>
          <% row.reasons.each do |reason| %><p class="text-xs text-clay"><%= reason %></p><% end %>
          <% if row.payload %>
            <details class="explainer"><summary class="explainer-summary">Exact request Rupert would send</summary><pre class="mt-2 overflow-x-auto whitespace-pre-wrap break-all rounded bg-haze p-2 font-mono text-xs"><%= JSON.pretty_generate(row.payload) %></pre><p class="mt-1 text-xs text-taupe">Credentials and the idempotency key are added only when a live push is queued.</p></details>
          <% end %>
        </li>
      <% end %>
      <% if @rows.empty? %>
        <li class="card card-pad text-sm text-mocha">No items at <%= @site.name %> are linked to <%= MasterStock.platform_label(@platform) %><%= ' with this status' if @status %>. Link items in Setup or on an item’s page.</li>
      <% end %>
    </ul>
  <% end %>
</div>
