<% content_for :title, 'Push preview' %>
<div class="space-y-5">
  <%= page_header 'Push preview', subtitle: 'A dry run: what Rupert would change on each platform to match its own stock. Nothing is sent.',
        menu: [['Rupert stock', master_stock_items_path(site_id: @site&.id)], ['Setup', master_stock_setup_path]] %>
  <% if @site.nil? %>
    <%= render 'master_stock/no_sites' %>
  <% else %>
    <% label = MasterStock.platform_label(@platform) %>
    <%= render 'master_stock/site_picker', sites: @sites, site: @site, path: :master_stock_push_preview_path, extra: { platform: @platform } %>
    <%= page_tabs(StockSite::PLATFORMS.map { |p| ["#{MasterStock.platform_label(p)}#{' (not mapped)' unless @site.mapped_platforms.include?(p)}", master_stock_push_preview_path(site_id: @site.id, platform: p), p == @platform] }, label: 'Platform') %>

    <div class="callout callout-attention" role="note">
      <p class="callout-title">Preview only. Live pushing is off until the owner approves it.</p>
      <p class="mt-1 text-sm text-mocha">Sales made on <%= label %> or another channel after Rupert’s last count are not in Rupert’s number yet, so a push long after a count would undo them. Push right after counting.</p>
    </div>

    <% blocker = @preview.platform_blocker %>
    <% summary = @preview.summary %>
    <% all_rows = @preview.rows %>
    <% large = all_rows.count { |row| row.status == 'change' && MasterStock::PushPreview.large_change?(row) } %>
    <% read_at = @preview.snapshot_at %>
    <% stale = read_at.nil? || read_at < MasterStock::PushPreview::FRESH_FOR.ago %>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="card card-pad"><p class="stat-label">Would change</p><p class="stat-value"><%= summary[:change] %></p><p class="text-xs text-taupe">−<%= summary[:units_down] %> / +<%= summary[:units_up] %> units<%= " · #{large} large" if large.positive? %></p></div>
      <div class="card card-pad"><p class="stat-label">Blocked</p><p class="stat-value"><%= summary[:blocked] %></p><p class="text-xs text-taupe">Need a count, a fresh read or a link</p></div>
      <div class="card card-pad"><p class="stat-label">Already match</p><p class="stat-value"><%= summary[:in_sync] %></p></div>
      <div class="card card-pad"><p class="stat-label"><%= label %> read</p><p class="text-sm font-semibold <%= stale ? 'text-clay' : 'text-ink' %>"><%= read_at ? "#{short_age(read_at)} ago" : 'Never' %><%= ' · too old to push' if stale && read_at %></p><p class="text-xs text-taupe"><%= @preview.location&.name || 'No location mapped' %></p></div>
    </div>
    <% if blocker %>
      <p class="flash flash-alert" role="status"><%= blocker %> <% if Current.user.can?('settings.write') %><%= link_to 'Map it in Setup', master_stock_setup_path, class: 'font-semibold underline' %><% end %></p>
    <% end %>
    <p class="text-sm text-mocha"><%= MasterStock::PushPreview::PLATFORM_WRITES.fetch(@platform) %></p>

    <% counts = { nil => all_rows.size, 'change' => summary[:change], 'blocked' => summary[:blocked], 'in_sync' => summary[:in_sync] } %>
    <%= page_tabs([[nil, 'All'], ['change', 'Change'], ['blocked', 'Blocked'], ['in_sync', 'Match']].map { |status, text| ["#{text} #{counts[status]}", master_stock_push_preview_path(site_id: @site.id, platform: @platform, status: status), @status == status] }, label: 'Show') %>

    <% if @rows.any? %>
      <div class="card overflow-hidden">
        <table class="table preview-table stack-table" aria-label="Proposed <%= label %> writes at <%= @site.name %>">
          <thead><tr><th scope="col" class="th">Item</th><th scope="col" class="th num"><%= label %> now</th><th scope="col" class="th num">Rupert</th><th scope="col" class="th num">Change</th><th scope="col" class="th">What would happen</th></tr></thead>
          <tbody>
            <% @rows.each do |row| %>
              <% big = row.status == 'change' && MasterStock::PushPreview.large_change?(row) %>
              <tr class="<%= 'preview-row-large' if big %>">
                <td class="td" data-label="Item">
                  <%= link_to row.item.name, master_stock_item_path(row.item, site_id: @site.id), class: 'font-medium text-ink hover:underline' %>
                  <p class="font-mono text-xs text-taupe break-all"><%= row.item.sku.presence || row.link.native_item_id.sub('gid://shopify/ProductVariant/', 'Variant ') %></p>
                </td>
                <td class="td num" data-label="<%= label %> now"><%= row.observed.nil? ? tag.span('Unknown', class: 'text-taupe') : row.observed %></td>
                <td class="td num" data-label="Rupert"><%= row.target.nil? ? tag.span('Not counted', class: 'text-taupe') : row.target %></td>
                <td class="td num font-semibold" data-label="Change"><%= signed_units(row.change) %></td>
                <td class="td" data-label="What would happen">
                  <span class="<%= { 'change' => 'pill-clay', 'blocked' => 'pill-rose', 'in_sync' => 'pill-fern' }.fetch(row.status) %>"><%= { 'change' => 'Would change', 'blocked' => 'Blocked', 'in_sync' => 'Matches' }.fetch(row.status) %></span>
                  <% if big %><span class="pill-rose">Large change: recount first</span><% end %>
                  <p class="mt-1 text-sm text-ink"><%= row.action %></p>
                  <% row.reasons.each do |reason| %><p class="text-xs text-mocha"><%= reason %></p><% end %>
                  <% if row.payload %>
                    <details class="explainer mt-1"><summary class="explainer-summary">Exact request</summary><pre class="mt-2 overflow-x-auto whitespace-pre-wrap break-all rounded bg-haze p-2 font-mono text-xs"><%= JSON.pretty_generate(row.payload) %></pre><p class="mt-1 text-xs text-taupe">Credentials and the idempotency key are added only when a live push is queued.</p></details>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card card-pad text-sm text-mocha">
        <% if @status %>Nothing at <%= @site.name %> is in “<%= { 'change' => 'Would change', 'blocked' => 'Blocked', 'in_sync' => 'Match' }.fetch(@status) %>” for <%= label %>.
        <% else %>No items at <%= @site.name %> are linked to <%= label %>. Link items in <%= link_to 'Setup', master_stock_setup_path, class: 'underline' %> or on an item’s page.<% end %>
      </div>
    <% end %>
  <% end %>
</div>
