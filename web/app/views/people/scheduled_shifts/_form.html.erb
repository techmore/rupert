<div class="card card-pad">
  <%= form_with model: shift, scope: :scheduled_shift, url: (shift.persisted? ? people_scheduled_shift_path(shift) : people_scheduled_shifts_path), class: "space-y-6" do |f| %>
    <% if shift.errors.any? %><div role="alert" class="flash flash-alert"><%= shift.errors.full_messages.to_sentence %></div><% end %>
    <fieldset class="space-y-4">
      <legend class="card-title">Shift</legend>
      <div>
        <%= f.label :employee_id, "Staff member", class: "field-label" %>
        <%= f.select :employee_id, [['Open shift (anyone can pick up)', 'open']] + @employees.map { |e| [e.full_name, e.id] }, { selected: (shift.employee_id || 'open') }, class: "select w-full" %>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :position_id, "Position (optional)", class: "field-label" %>
          <%= f.select :position_id, @positions.map { |p| [p.name, p.id] }, { include_blank: "Any" }, class: "select w-full" %>
        </div>
        <div>
          <%= f.label :break_minutes, "Unpaid break (minutes)", class: "field-label" %>
          <%= f.number_field :break_minutes, class: "input", min: 0, max: 240, step: 5 %>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :starts_at, "Starts", class: "field-label" %>
          <%= f.datetime_field :starts_at, class: "input", required: true %>
        </div>
        <div>
          <%= f.label :ends_at, "Ends", class: "field-label" %>
          <%= f.datetime_field :ends_at, class: "input", required: true %>
        </div>
      </div>
      <div>
        <%= f.label :location_id, "Store (optional)", class: "field-label" %>
        <%= f.select :location_id, @locations.map { |location| [location.picker_label, location.id] }, { include_blank: "No store" }, class: "select w-full" %>
      </div>
      <div>
        <%= f.label :role_label, "Role or station (optional)", class: "field-label" %>
        <%= f.text_field :role_label, class: "input", maxlength: 80, placeholder: "e.g. Front counter" %>
      </div>
      <div>
        <%= f.label :notes, "Note for the staff member (optional)", class: "field-label" %>
        <%= f.text_area :notes, rows: 2, maxlength: 2000, class: "input" %>
      </div>
    </fieldset>
    <div class="form-actions">
      <%= f.submit "Save", class: "btn-primary" %>
      <%= link_to "Cancel", people_scheduled_shifts_path(week: shift.starts_at&.to_date&.iso8601), class: "btn-ghost" %>
    </div>
  <% end %>
  <% if shift.persisted? %><div class="mt-4 flex justify-end"><%= button_to (shift.published? ? "Cancel shift" : "Remove draft"), people_scheduled_shift_path(shift), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: (shift.published? ? "Cancel this posted shift? The person is told." : "Remove this draft shift?") } } %></div><% end %>
</div>
