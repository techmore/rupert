<% content_for :title, "Shifts" %>
<% can_write = Current.user.can?('schedule.write') || Current.user.can?('hr.write') %>
<div class="space-y-6">
  <%= page_header 'Shifts', subtitle: 'Planned shifts for the week.' do %>
    <%= full_window_button %>
    <% if can_write %>
      <%= button_to "Copy last week", copy_last_week_people_scheduled_shifts_path(week: @week.iso8601), class: "btn-ghost", form: { data: { turbo_confirm: "Copy #{(@week - 7).strftime('%b %-d')} – #{(@week - 1).strftime('%b %-d')} into this week? Shifts that overlap one already planned are skipped." } } %>
      <%= link_to "Add shift", new_people_scheduled_shift_path(date: [@week, Date.current].max.iso8601), class: "btn-primary" %>
    <% end %>
  <% end %>

  <section class="toolbar-band">
    <nav class="toolbar" aria-label="Week">
      <div class="date-stepper">
        <%= link_to "‹", people_scheduled_shifts_path(week: (@week - 7).iso8601), class: "btn-ghost btn-sm", aria: { label: "Previous week" }, title: "Previous week" %>
        <h2 class="section-title"><%= @week.strftime("%b %-d") %> – <%= (@week + 6).strftime("%b %-d, %Y") %></h2>
        <%= link_to "›", people_scheduled_shifts_path(week: (@week + 7).iso8601), class: "btn-ghost btn-sm", aria: { label: "Next week" }, title: "Next week" %>
      </div>
      <% unless Date.current.between?(@week, @week + 6) %><%= link_to "This week", people_scheduled_shifts_path, class: "btn-ghost btn-sm" %><% end %>
    </nav>
  </section>

  <% if @on_leave.any? %>
    <p role="note" class="rounded-xl border border-warn-edge bg-warn-bg p-3 text-sm text-warn" data-leave-warning><%= pluralize(@on_leave.size, 'shift') %> this week <%= @on_leave.size == 1 ? 'falls' : 'fall' %> on approved leave. They are marked below; the shift is still planned until you change it.</p>
  <% end %>

  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Planned shifts">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Staff member</th>
            <% (@week..(@week + 6)).each do |day| %><th scope="col" class="th"><%= day.strftime("%a %-d") %></th><% end %>
            <th scope="col" class="th num">Hours</th>
          </tr>
        </thead>
        <tbody>
          <% if @by_employee.empty? %>
            <tr><td colspan="9" class="empty-row">No shifts planned this week.<%= ' Add the first shift.' if can_write %></td></tr>
          <% end %>
          <% @by_employee.each do |employee, shifts| %>
            <tr class="align-top">
              <td class="td font-medium text-ink"><%= employee.full_name %></td>
              <% (@week..(@week + 6)).each do |day| %>
                <td class="td text-mocha">
                  <% shifts.select { |shift| shift.starts_at.to_date == day }.each do |shift| %>
                    <p class="whitespace-nowrap"><%= can_write ? link_to(shift.time_label, edit_people_scheduled_shift_path(shift), class: "text-olive hover:underline") : shift.time_label %><% if shift.role_label.present? %><span class="block text-xs"><%= shift.role_label %></span><% end %><% if @on_leave.include?(shift.id) %><span class="block text-xs font-semibold text-warn" data-on-leave="<%= shift.id %>">On approved leave</span><% end %></p>
                  <% end %>
                </td>
              <% end %>
              <td class="td num"><%= number_with_precision(shifts.sum(&:hours), precision: 2, strip_insignificant_zeros: true) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <p class="text-xs text-mocha">Staff see their own shifts on the Schedule tab of their workspace.</p>
</div>
