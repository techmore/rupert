<%# Accept / Keep original for one Square timecard. Locals: review (SquareTimecardReviewer). %>
<% view = review.comparison %>
<%= form_with url: people_square_timecard_review_path(review.card), scope: :square_review, class: 'space-y-2', data: { square_review: review.card.id } do |f| %>
  <%= f.hidden_field :seen_key, value: view[:seen_key] %>
  <%= f.label :reason, 'Why', class: 'sr-only', for: "square-review-reason-#{review.card.id}" %>
  <%= f.text_field :reason, id: "square-review-reason-#{review.card.id}", class: 'input', required: true, maxlength: 1000, placeholder: 'Why (for the history)', autocomplete: 'off' %>
  <% if view[:blocker] %>
    <p class="text-xs text-mocha"><%= view[:blocker] %></p>
  <% elsif view[:locks].any? %>
    <p class="text-xs text-mocha"><span class="pill-clay">Locked</span> <%= view[:locks].map(&:label).to_sentence %>. Accepting flags it instead of changing hours.</p>
  <% end %>
  <div class="flex flex-wrap gap-2">
    <%= f.button view[:latest][:removed] ? 'Accept removal' : 'Accept Square’s hours', name: 'square_review[decision]', value: 'accept', class: 'btn-ghost btn-sm',
          disabled: view[:blocker].present?, data: { turbo_submits_with: 'Saving…' } %>
    <%= f.button 'Keep original', name: 'square_review[decision]', value: 'keep', class: 'btn-ghost btn-sm', data: { turbo_submits_with: 'Saving…' } %>
  </div>
<% end %>
