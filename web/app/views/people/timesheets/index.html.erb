<% content_for :title, "Timesheets" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="space-y-6">
  <%= page_header 'Timesheets', subtitle: (@reviewer ? 'Weekly hours from staff, to review and approve.' : 'Your hours by pay week. Submit each week for review.'),
        menu: [['Download CSV', people_timesheets_path(format: :csv, status: @status, from: @from&.iso8601, to: @to&.iso8601, q: @query), { data: { turbo: false } }]] do %>
    <% if policy(People::Timesheet).create? %><%= link_to 'Add timesheet', new_people_timesheet_path, class: 'btn-primary' %><% end %>
  <% end %>
  <%= render 'shared/open_clock_outs', items: @open_items, limit: @open_clock_outs.limit_hours %>

  <% if @reviewer && @pending_corrections_count.to_i.positive? %>
    <section class="callout callout-attention flex flex-wrap items-center justify-between gap-3" aria-label="Clock corrections waiting" data-corrections-waiting>
      <div>
        <p class="callout-title"><%= pluralize(@pending_corrections_count, 'clock correction') %> waiting for review</p>
        <p class="text-sm text-mocha">Timesheets with these shifts cannot be approved until the corrections are reviewed.</p>
      </div>
      <% if ClockCorrection.reviewer?(Current.user) %><%= link_to 'Review corrections', time_clock_path(anchor: 'corrections'), class: 'btn-ghost btn-sm' %><% end %>
    </section>
  <% end %>

  <% status_labels = { 'submitted' => 'In review', 'all' => 'All', 'approved' => 'Approved', 'rejected' => 'Returned', 'draft' => 'Draft' } %>
  <% status_count = ->(status) { status == 'submitted' ? @awaiting : status == 'all' ? (@status_counts || {}).values.sum : (@status_counts || {}).fetch(status, 0) } %>
  <div class="flex flex-wrap items-center justify-between gap-3" <%= tour_anchor('views') %>>
    <%= page_tabs([['list', 'Rupert timesheets'], ['unified', 'All sources'], ['calendar', 'Calendar']].map { |key, label| [label, people_timesheets_path(request.query_parameters.merge(view: key, month: (key == 'calendar' ? (@month || @from || Date.current).strftime('%Y-%m') : nil)).compact), @view == key] }, label: 'Timesheet view') %>
    <% if @reviewer && @awaiting.positive? && @status != 'submitted' %>
      <%= link_to "#{@awaiting} in review", people_timesheets_path(status: 'submitted', view: 'list'), class: 'text-sm font-semibold text-olive-deep underline' %>
    <% end %>
  </div>

  <section class="toolbar-band">
    <%= form_with url: people_timesheets_path, method: :get, class: 'toolbar', html: { 'aria-label': 'Timesheet filters' }, data: { turbo: false } do %>
      <%= hidden_field_tag :view, @view %>
      <% weeks = (0..52).map { |n| Date.current.beginning_of_week - (n - 2).weeks } %>
      <% from_choices = ([@from] + weeks).compact.uniq.sort.reverse %>
      <% to_choices = ([@to] + weeks.map { |w| w + 6 }).compact.uniq.sort.reverse %>
      <div class="toolbar-field">
        <%= label_tag :from, 'From', class: 'field-label' %>
        <%= select_tag :from, options_for_select([['All dates', '']] + from_choices.map { |d| [d.strftime('%a, %b %-d, %Y'), d.iso8601] }, @from&.iso8601), class: 'select' %>
      </div>
      <div class="toolbar-field">
        <%= label_tag :to, 'To', class: 'field-label' %>
        <%= select_tag :to, options_for_select([['All dates', '']] + to_choices.map { |d| [d.strftime('%a, %b %-d, %Y'), d.iso8601] }, @to&.iso8601), class: 'select' %>
      </div>
      <div class="toolbar-field" <%= tour_anchor('tabs') %>>
        <%= label_tag :status, 'Status', class: 'field-label' %>
        <%= select_tag :status, options_for_select(status_labels.map { |key, label| ["#{label} (#{status_count.call(key)})", key] }, @status), class: 'select',
              aria: { label: @reviewer ? 'Timesheet review' : 'Status' } %>
      </div>
      <% if @reviewer %>
        <div class="toolbar-field">
          <%= label_tag :q, 'Staff member', class: 'field-label' %>
          <%= search_field_tag :q, @query, class: 'input', placeholder: 'Search by name' %>
        </div>
      <% end %>
      <div class="toolbar-actions">
        <%= submit_tag 'Apply', class: 'btn-primary', name: nil %>
        <%= link_to 'Clear', people_timesheets_path(view: @view), class: 'btn-ghost' %>
      </div>
    <% end %>
  </section>

  <% if @view == 'calendar' %>
  <section class="section-card">
    <div class="card-head">
      <div><h2 class="section-title"><%= @month.strftime('%B %Y') %></h2></div>
      <nav class="card-head-actions" aria-label="Month">
        <div class="date-stepper">
          <%= link_to '‹', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: @prev_month.strftime('%Y-%m'))), class: 'btn-ghost btn-sm', aria: { label: 'Previous month' }, title: 'Previous month' %>
          <% unless @month.strftime('%Y-%m') == Date.current.strftime('%Y-%m') %><%= link_to 'This month', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: Date.current.strftime('%Y-%m'))), class: 'btn-ghost btn-sm' %><% end %>
          <%= link_to '›', people_timesheets_path(request.query_parameters.merge(view: 'calendar', month: @next_month.strftime('%Y-%m'))), class: 'btn-ghost btn-sm', aria: { label: 'Next month' }, title: 'Next month' %>
        </div>
      </nav>
    </div>
    <div class="table-region">
    <div class="month-grid">
    <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-mocha" aria-hidden="true">
      <% Date::DAYNAMES.rotate.each do |day| %><div class="py-1"><%= day[0, 3] %></div><% end %>
    </div>
    <ol class="grid grid-cols-7 gap-1" aria-label="<%= @month.strftime('%B %Y') %>">
      <% @calendar_days_range.each do |day| %>
        <% in_month = day.month == @month.month %>
        <% bucket = in_month ? @calendar_days[day.iso8601] : nil %>
        <li class="min-h-24 rounded-card border p-2 text-left <%= in_month ? (bucket && (bucket[:timesheets].any? || bucket[:punches].positive?) ? 'border-fog bg-haze/40' : 'border-fog bg-cream') : 'border-transparent bg-haze/30' %> <%= day == Date.current ? 'ring-2 ring-olive' : '' %>" <%= 'aria-hidden="true"'.html_safe unless in_month %> <%= 'aria-current="date"'.html_safe if day == Date.current %>>
          <p class="text-xs font-semibold <%= in_month ? (day == Date.current ? 'text-olive' : 'text-ink') : 'text-mocha font-normal' %>"><span class="sr-only"><%= day.strftime('%A, %B') %> </span><%= day.day %></p>
          <% if in_month && bucket && bucket[:timesheets].any? %>
            <ul class="mt-1 space-y-0.5">
              <% bucket[:timesheets].each do |ts| %>
                <li class="truncate rounded px-1 py-0.5 text-xs font-semibold leading-tight <%= ts.approved? ? 'bg-fern/15 text-fern' : ts.submitted? ? 'bg-clay/15 text-clay' : ts.rejected? ? 'bg-rose/15 text-rose' : 'bg-taupe/15 text-taupe' %>" title="<%= ts.employee&.name %> · <%= ts.period_label %> · <%= format_hours(ts.total_hours, unit: true) %>">
                  <%= link_to "#{ts.employee&.name} · #{timesheet_status_label(ts.status)}", people_timesheet_path(ts), class: 'hover:underline' %>
                </li>
              <% end %>
            </ul>
          <% end %>
          <% if in_month && bucket && bucket[:punches].positive? %>
            <p class="mt-1 text-xs text-mocha"><%= pluralize(bucket[:punches], 'punch', plural: 'punches') %> · <%= format_hours(bucket[:hours], unit: true) %></p>
          <% end %>
        </li>
      <% end %>
    </ol>
    </div>
    </div>
    <p class="text-xs text-taupe">Timesheets (pay weeks) and punches (daily) from Rupert, Square and C-Trax. Overlapping hours are never added together.</p>
  </section>
  <% elsif @view == 'unified' %>
  <div class="card">
    <div class="table-region" role="region" tabindex="0" aria-label="Time records from every source">
      <table class="table">
        <thead>
          <tr>
            <th scope="col" class="th">Source</th>
            <% if @reviewer %><th scope="col" class="th">Staff member</th><% end %>
            <th scope="col" class="th">Date</th>
            <th scope="col" class="th num">Hours</th>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @unified_records.blank? %>
            <tr><td colspan="6" class="empty-row">No time records in this view. Widen the dates or clear the filters.</td></tr>
          <% end %>
          <% @unified_records.each do |record| %>
            <tr>
              <td class="td"><span class="<%= record[:source_class] %>"><%= record[:source] %></span></td>
              <% if @reviewer %><td class="td font-medium text-ink"><%= record[:employee] %></td><% end %>
              <td class="td text-mocha"><%= record[:date] ? (record[:end_date] && record[:end_date] != record[:date] ? period_range(record[:date], record[:end_date]) : record[:date].strftime('%b %-d, %Y')) : '–' %></td>
              <td class="td num"><%= record[:hours].nil? ? '–' : format_hours(record[:hours]) %></td>
              <td class="td"><% if record[:source] == 'Rupert' %><%= timesheet_status_pill(record[:status]) %><% else %><span class="pill-taupe"><%= record[:status].to_s.humanize %></span><% end %></td>
              <td class="td text-right"><%= link_to 'Open', record[:path], class: 'btn-ghost btn-sm', aria: { label: "Open #{record[:detail]}" } %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <%== @pagy.series_nav if @pagy && @pagy.pages > 1 %>
  <% else %>
  <% if @reviewer %>
    <section class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Timesheet summary">
      <div class="stat"><p class="stat-label">In review</p><p class="stat-value mt-1 tabular-nums"><%= @status_counts.fetch('submitted', 0) %></p><% if @awaiting != @status_counts.fetch('submitted', 0) %><p class="text-xs text-mocha"><%= @awaiting %> across all dates</p><% end %></div>
      <div class="stat"><p class="stat-label">Approved</p><p class="stat-value mt-1 tabular-nums"><%= @status_counts.fetch('approved', 0) %></p></div>
      <div class="stat"><p class="stat-label">Returned · Draft</p><p class="stat-value mt-1 tabular-nums"><%= @status_counts.fetch('rejected', 0) %> · <%= @status_counts.fetch('draft', 0) %></p></div>
      <div class="stat"><p class="stat-label">Hours in this view</p><p class="stat-value mt-1 tabular-nums"><%= format_hours(@view_hours) %></p></div>
    </section>
  <% end %>

  <% approvable = @reviewer ? @timesheets.select { |t| t.submitted? && policy(t).approve? } : [] %>
  <% show_overtime = @timesheets.any? { |t| @summaries[t.id].overtime.positive? } || PayRules.current.overtime_enabled? %>
  <% show_other = @timesheets.any? { |t| @summaries[t.id].other.positive? } %>
  <% show_comp = @timesheets.any? { |t| t.compensation_total_cents.positive? } %>
  <% show_regular = @reviewer && (show_overtime || show_other) %>
  <% show_flags = @reviewer && @timesheets.any? { |t| @summaries[t.id].flags.any? } %>
  <% columns = 4 + (approvable.any? ? 1 : 0) + (@reviewer ? 1 : 0) + (show_regular ? 1 : 0) + (show_flags ? 1 : 0) + (show_overtime ? 1 : 0) + (show_other ? 1 : 0) + (show_comp ? 1 : 0) %>
  <%= form_with url: bulk_approve_people_timesheets_path, method: :post, id: 'bulk-approve', data: { turbo_confirm: 'Approve the selected timesheets?' } do |f| %>
    <%= hidden_field_tag :return_status, @status %><%= hidden_field_tag :return_period, @period %><%= hidden_field_tag :return_from, @from&.iso8601 %><%= hidden_field_tag :return_to, @to&.iso8601 %><%= hidden_field_tag :return_view, 'list' %><%= hidden_field_tag :return_q, @query %>
    <% if approvable.any? %>
      <div class="mb-3 flex flex-wrap items-center gap-3" role="group" aria-label="Approve several">
        <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="checkbox" data-bulk-all onclick="document.querySelectorAll('#bulk-approve .bulk-box').forEach(function(b){b.checked=this.checked}.bind(this))"> Select all <%= approvable.size %> in review</label>
        <%= text_field_tag :review_note, nil, maxlength: 4000, placeholder: 'Comment for everyone selected (optional)', 'aria-label': 'Optional comment for everyone selected', class: 'input w-full sm:w-80' %>
        <%= f.submit 'Approve selected', class: 'btn-primary btn-sm' %>
      </div>
    <% end %>
  <div class="card" <%= tour_anchor('table') %>>
    <div class="table-region" role="region" tabindex="0" aria-label="Timesheets">
      <table class="table">
        <thead>
          <tr>
            <% if approvable.any? %><th scope="col" class="th"><span class="sr-only">Select</span></th><% end %>
            <% if @reviewer %><th scope="col" class="th">Staff member</th><% end %>
            <th scope="col" class="th">Pay week</th>
            <% if show_regular %><th scope="col" class="th num">Regular</th><% end %>
            <% if show_overtime %><th scope="col" class="th num">Overtime</th><% end %>
            <% if show_other %><th scope="col" class="th num">PTO, holiday</th><% end %>
            <th scope="col" class="th num">Hours</th>
            <% if show_comp %><th scope="col" class="th num" title="1% commission + $10 card bonus">Commission</th><% end %>
            <% if show_flags %><th scope="col" class="th">To check</th><% end %>
            <th scope="col" class="th">Status</th>
            <th scope="col" class="th"><span class="sr-only">Open</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @timesheets.empty? %>
            <tr><td colspan="<%= columns %>" class="empty-row"><%= if @status == 'submitted' then 'Nothing in review. Everything submitted has been handled.' elsif @reviewer then 'No timesheets match. Clear the filters or choose other dates.' else 'No timesheets yet. Open this week from My time, or add a timesheet.' end %></td></tr>
          <% end %>
          <% @timesheets.each do |timesheet| %>
            <% sum = @summaries[timesheet.id] %>
            <% can_review = @reviewer && timesheet.submitted? && policy(timesheet).approve? %>
            <tr>
              <% if approvable.any? %>
                <td class="td"><% if approvable.include?(timesheet) %><input type="checkbox" class="checkbox bulk-box" name="timesheet_ids[]" value="<%= timesheet.id %>" aria-label="Select <%= timesheet.employee&.name %>, <%= timesheet.period_label %>"><% end %></td>
              <% end %>
              <% if @reviewer %><td class="td font-medium text-ink"><%= timesheet.employee&.name %><% if timesheet.demo? %> <span class="pill-taupe">Demo</span><% end %></td><% end %>
              <td class="td whitespace-nowrap"><%= link_to timesheet.period_label, people_timesheet_path(timesheet), class: "text-olive hover:underline" %><% if !@reviewer && timesheet.demo? %> <span class="pill-taupe">Demo</span><% end %></td>
              <% if show_regular %><td class="td num"><%= format_hours(sum.regular) %></td><% end %>
              <% if show_overtime %><td class="td num"><%= format_hours(sum.overtime, blank_zero: true) %></td><% end %>
              <% if show_other %><td class="td num"><%= format_hours(sum.other, blank_zero: true) %></td><% end %>
              <td class="td num font-semibold text-ink"><%= format_hours(sum.total) %></td>
              <% if show_comp %><td class="td num"><%= timesheet.compensation_total_cents.positive? ? number_to_currency(timesheet.compensation_total_cents / 100.0) : '–' %></td><% end %>
              <% if show_flags %><td class="td"><% sum.flags.each do |flag| %><span class="<%= flag.start_with?('Overtime') ? 'pill-olive' : 'pill-clay' %> mr-1 mb-1 inline-block"><%= flag %></span><% end %></td><% end %>
              <td class="td">
                <%= timesheet_status_pill(timesheet) %>
                <% if timesheet.submitted? && timesheet.submitted_at %><p class="mt-0.5 text-xs text-mocha">Sent <%= time_ago_in_words(timesheet.submitted_at) %> ago</p><% end %>
              </td>
              <td class="td text-right">
                <% label = if can_review then 'Review' elsif !@reviewer && timesheet.draft? then 'Continue' elsif !@reviewer && timesheet.rejected? then 'Fix' else 'Open' end %>
                <%= link_to label, people_timesheet_path(timesheet), class: (can_review ? 'btn-primary btn-sm' : 'btn-ghost btn-sm'), aria: { label: "#{label} #{timesheet.employee&.name}, #{timesheet.period_label}" } %>
                <% if timesheet.assigned_reviewer %><p class="text-xs text-mocha">Assigned to <%= timesheet.assigned_reviewer.display_name %></p><% end %>
                <% if @reviewer && timesheet.submitted? && !policy(timesheet).approve? %><p class="text-xs text-mocha">Another reviewer required</p><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% end %>
  <%== @pagy.series_nav if @pagy.pages > 1 %>
  <% end %>

  <% if @reviewer && @calendar_view %>
    <% clocked_in_now = @calendar.clocked_in.map(&:employee_id).uniq.size %>
    <details class="card" <%= 'open' if params[:period].present? %>>
      <summary class="card-pad cursor-pointer"><span class="section-title">This week's shift calendar</span><% if clocked_in_now.positive? %> <span class="pill-fern ml-2 align-middle"><%= clocked_in_now %> clocked in now</span><% end %><span class="block text-sm text-mocha">Rupert, Square and C-Trax shifts by day; tick staff on and off.</span></summary>
      <div class="card-pad pt-0">
        <%= render 'people/timesheets/calendar', calendar: @calendar, week: (@week_start || Date.current.beginning_of_week) %>
      </div>
    </details>
  <% end %>

  <% if @reviewer %>
    <div class="grid gap-6 lg:grid-cols-2">
      <section class="space-y-3" aria-label="Pay periods" <%= tour_anchor('weeks') %>>
        <%= section_heading 'Pay periods', hint: PayRules.current.summary %>
        <div class="card">
          <ul class="row-list">
            <% @pay_periods.each do |period| %>
              <li class="row-item" data-pay-period="<%= period[:from].iso8601 %>">
                <div class="min-w-0">
                  <p class="font-semibold text-ink"><%= link_to period[:label], people_timesheets_path(from: period[:from].iso8601, to: period[:to].iso8601, status: 'all'), class: 'hover:underline' %></p>
                  <p class="text-xs text-mocha"><%= period_range(period[:from], period[:to]) %><%= ' · in progress' if period[:current] %></p>
                </div>
                <div class="row-item-end text-sm">
                  <% parts = [] %>
                  <% parts << ["#{period[:submitted]} in review", 'pill-clay'] if period[:submitted].positive? %>
                  <% parts << ["#{period[:rejected]} returned", 'pill-rose'] if period[:rejected].positive? %>
                  <% parts << ["#{period[:draft]} draft", 'pill-taupe'] if period[:draft].positive? %>
                  <% parts << ["#{period[:approved]} approved", 'pill-fern'] if period[:approved].positive? %>
                  <% if period[:missing].positive? %><% parts << (period[:current] ? ["#{period[:missing]} clocked, not started", 'pill-taupe'] : ["#{period[:missing]} worked, no timesheet", 'pill-rose']) %><% end %>
                  <% parts.each do |text, pill| %><span class="<%= pill %>"><%= text %></span><% end %>
                  <% if parts.empty? %><span class="text-mocha">No timesheets</span><% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </section>

      <section class="space-y-3" aria-label="Upcoming time off">
        <%= section_heading "Upcoming time off#{" (#{@pending_leave_count} pending)" if @pending_leave_count&.positive?}" do %>
          <%= link_to 'All requests', people_leave_requests_path, class: 'btn-ghost btn-sm' %>
        <% end %>
        <% if @upcoming_leave.empty? %>
          <%= empty_state 'No upcoming time off', hint: 'Approved and pending requests for the weeks ahead appear here.' %>
        <% else %>
          <div class="card">
            <div class="table-region" role="region" tabindex="0" aria-label="Upcoming time off">
              <table class="table">
                <thead>
                  <tr><th scope="col" class="th">Staff member</th><th scope="col" class="th">Type</th><th scope="col" class="th">Dates</th><th scope="col" class="th">Status</th></tr>
                </thead>
                <tbody>
                  <% @upcoming_leave.each do |leave| %>
                    <tr>
                      <td class="td font-medium text-ink"><%= leave.employee&.name %></td>
                      <td class="td"><%= leave.leave_type.humanize %></td>
                      <td class="td"><%= period_range(leave.starts_on, leave.ends_on) %></td>
                      <td class="td"><span class="<%= leave.approved? ? 'pill-fern' : leave.requested? ? 'pill-clay' : 'pill-taupe' %>"><%= leave.requested? ? 'Requested' : leave.status.humanize %></span></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        <% end %>
      </section>
    </div>
  <% end %>

  <% if @reviewer %>
    <div <%= tour_anchor('sources') %>>
      <%= render 'shared/time_source_coverage', coverage: @coverage %>
    </div>
  <% else %>
    <details class="explainer" <%= tour_anchor('sources') %>>
      <summary class="explainer-summary">Where these hours come from</summary>
      <div class="mt-3"><%= render 'shared/time_source_coverage', coverage: @coverage %></div>
    </details>
  <% end %>
</div>
