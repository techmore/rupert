<% content_for :title, "Permissions" %>
<% grid = @grid %>
<% override_count = grid.personal_override_count %>
<div class="space-y-6">
  <%= page_header 'Permissions', subtitle: 'What each role allows before any per-person changes.' %>
  <%= render 'permissions/tabs' %>

  <% if override_count.positive? %>
    <p class="text-sm text-mocha" data-personal-overrides>
      <%= pluralize(override_count, 'user') %> in this business <%= override_count == 1 ? 'has' : 'have' %> a personal permission list, so their access can differ from their role. Check their account under Users.
    </p>
  <% end %>

  <div class="card">
    <%= data_grid 'permissions-by-role', label: 'What each role allows', filename: 'permissions-by-role', filter: true do %>
      <table class="data-grid-table">
        <thead>
          <tr>
            <th scope="col" data-label="Permission">Permission</th>
            <th scope="col" data-label="Area" data-default-hidden>Area</th>
            <th scope="col" data-label="Code" data-default-hidden>Code</th>
            <% grid.roles.each do |role| %>
              <th scope="col" data-label="<%= grid.role_label(role) %>" data-role="<%= role %>">
                <%= grid.role_label(role) %>
                <% if grid.changed?(role) %><span class="block text-xs font-normal text-mocha" data-role-changed>Changed here</span><% end %>
              </th>
            <% end %>
          </tr>
        </thead>
        <% grid.areas.each do |area| %>
          <tbody data-area="<%= area.name %>">
            <tr>
              <th scope="rowgroup" colspan="<%= grid.roles.length + 3 %>"><span class="font-semibold text-ink"><%= area.name %></span></th>
            </tr>
            <% area.rows.each do |row| %>
              <tr data-row="<%= row.key %>">
                <th scope="row" data-sort-value="<%= row.label %>" data-export="<%= row.label %>: <%= row.description %>">
                  <div class="w-44 whitespace-normal sm:w-72">
                    <span class="font-medium text-ink"><%= row.label %></span>
                    <span class="block text-xs font-normal text-mocha"><%= row.description %></span>
                  </div>
                </th>
                <td><%= area.name %></td>
                <td class="font-mono text-xs text-taupe"><%= row.code || '—' %></td>
                <% grid.roles.each do |role| %>
                  <% allowed = grid.allowed?(role, row.key) %>
                  <td data-sort-value="<%= allowed ? 1 : 0 %>" data-role="<%= role %>" data-allowed="<%= allowed %>">
                    <% if allowed %><span class="pill-fern">Yes</span><% else %><span class="text-taupe">No</span><% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        <% end %>
      </table>
    <% end %>
  </div>

  <details class="explainer">
    <summary class="explainer-summary">How to read this</summary>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-ink">
      <li>Each column is what a person gets when you give them that role in this business, including any changes made under Edit roles. Roles marked Changed here no longer use the built-in list.</li>
      <li>A person with their own permission list on their account gets that list instead of their role's.</li>
      <li>Super admin always has full access. Employee is fixed to the POS, their own time records and assigned tasks, and no change can widen it.</li>
      <li>Anyone linked to a staff record can also clock in and keep their own timesheets, whatever their role.</li>
      <li>Nobody reviews their own timesheet or approves a correction to their own shift.</li>
    </ul>
  </details>
</div>
