<% kind = @checkout.sandbox_payment? ? 'Sandbox receipt' : (@checkout.demo? ? 'Demo receipt' : 'Receipt') %>
<% content_for :title, "#{kind} #{@checkout.reference}" %>
<div class="page-medium space-y-6">
  <%= page_header kind, subtitle: "#{@checkout.reference} · USD", eyebrow: "POS · #{@checkout.location.name}" do %>
    <span class="<%= @checkout.paid? ? 'pill-fern' : @checkout.unresolved? ? 'pill-clay' : 'pill-taupe' %>"><%= @checkout.paid? ? (@checkout.sandbox_payment? ? 'Sandbox complete' : 'Paid') : @checkout.status.humanize %></span>
    <%= link_to 'Open cashier', ctrax_pos_path(location_id: @checkout.location_id, display_id: (@checkout.pos_display_session.active? && @checkout.user_id == Current.user.id ? @checkout.pos_display_session_id : nil)), class: 'btn-primary' %>
  <% end %>
  <% if @checkout.unresolved? %><div class="flash flash-alert" role="status"><p class="font-semibold">Payment outcome needs verification</p><p class="mt-1">Check this receipt and the gateway before collecting another payment. Rechecking reads the existing payment; it does not send another charge.</p></div><% end %>
  <section class="section-card" aria-label="Receipt totals">
    <%= section_heading 'Sale details' %>
    <% @checkout.lines.each do |line| %><div class="flex items-start justify-between gap-3 border-b border-fog pb-3"><p class="min-w-0 text-sm"><span class="font-semibold"><%= line['title'] %></span><br><span class="text-mocha"><%= line['quantity'] %> × <%= line['unit_price'] %> USD</span></p></div><% end %>
    <dl class="space-y-2"><% { 'Subtotal' => @checkout.subtotal_cents, 'Tax' => @checkout.tax_cents, 'Tip' => @checkout.tip_cents, 'Total' => @checkout.total_cents, 'Cash received' => @checkout.cash_received_cents, 'Change' => @checkout.change_cents }.each do |label, value| %><% unless value.nil? %><div class="flex justify-between gap-3 <%= label == 'Total' ? 'border-y border-fog py-3 text-lg' : 'text-sm' %>"><dt><%= label %></dt><dd class="num font-semibold"><%= ctrax_money(value) %></dd></div><% end %><% end %></dl>
    <details class="explainer text-sm text-mocha"><summary class="explainer-summary">How total and change are calculated</summary><p class="mt-3">Subtotal <%= ctrax_money(@checkout.subtotal_cents) %> + tax <%= ctrax_money(@checkout.tax_cents) %> + tip <%= ctrax_money(@checkout.tip_cents) %> = <%= ctrax_money(@checkout.total_cents) %> due.</p><% if @checkout.cash_received_cents && @checkout.change_cents %><p class="mt-2">Cash received <%= ctrax_money(@checkout.cash_received_cents) %> − total due <%= ctrax_money(@checkout.total_cents) %> = <%= ctrax_money(@checkout.change_cents) %> change.</p><% end %><%= link_to 'Practice reading a checkout', learning_path('checkout', anchor: 'lesson-example'), class: 'mt-3 inline-block text-olive-deep underline' %></details>
  </section>
  <% coa_lines = @checkout.lines.filter_map { |line| [line['title'], @coa_badges.dig(line['variant_id'].to_s, :coa_url)] if @coa_badges.dig(line['variant_id'].to_s, :coa_url) } %>
  <% if coa_lines.any? %>
    <section class="section-card" aria-label="Lab certificates">
      <%= section_heading 'Lab certificates (COA)' %>
      <p class="text-sm text-mocha">Scan a code to open the product’s certificate of analysis.</p>
      <div class="coa-qr-grid"><% coa_lines.uniq.each do |title, url| %><%= link_to url, target: '_blank', rel: 'noopener noreferrer', class: 'coa-qr-link' do %><%= coa_qr_svg(url, label: title) %><% end %><% end %></div>
    </section>
  <% end %>
  <% if @checkout.id_checked || @checkout.compliance_override? %>
    <section class="section-card" aria-label="Compliance checks">
      <%= section_heading 'Compliance checks' %>
      <dl class="facts">
        <% unless @checkout.id_checked.nil? %><div><dt>ID checked (21+)</dt><dd><%= @checkout.id_checked ? 'Yes' : 'No' %></dd></div><% end %>
        <% if @checkout.compliance_override? %>
          <div><dt>Manager override</dt><dd><%= @checkout.compliance_override_by&.display_name || 'Manager' %>: <%= @checkout.compliance_override_reason %></dd></div>
          <div><dt>Overridden</dt><dd><%= @checkout.compliance_issues.select { |i| i['severity'] == 'block' }.map { |i| compliance_issue_label(i['code']) }.uniq.to_sentence %></dd></div>
        <% end %>
      </dl>
    </section>
  <% end %>
  <% if (card = @checkout.card_receipt) %>
    <section class="section-card" aria-label="Card payment">
      <%= section_heading 'Card payment' %>
      <dl class="space-y-1 text-sm">
        <div class="flex justify-between gap-3"><dt>Card</dt><dd><%= [card[:brand], card[:last_four] && "ending #{card[:last_four]}"].compact.join(' ').presence || 'Card' %></dd></div>
        <% if card[:auth_code] %><div class="flex justify-between gap-3"><dt>Approval code</dt><dd class="num"><%= card[:auth_code] %></dd></div><% end %>
        <div class="flex justify-between gap-3"><dt>Processed by</dt><dd><%= card[:processor] %><%= ' (sandbox)' if @checkout.environment == 'sandbox' %> · <span class="num"><%= card[:transaction_id] %></span></dd></div>
        <% if card[:refunded_cents].positive? %><div class="flex justify-between gap-3"><dt>Refunded</dt><dd class="num font-semibold"><%= ctrax_money(card[:refunded_cents]) %></dd></div><% end %>
      </dl>
      <% reversals = @checkout.pos_card_reversals.order(:id).to_a %>
      <% if reversals.any? %>
        <ul class="mt-3 space-y-1 text-sm">
          <% reversals.each do |r| %><li class="flex flex-wrap justify-between gap-2 border-t border-fog pt-2"><span><%= r.kind.capitalize %> <%= ctrax_money(r.amount_cents) %> · <%= r.reason %></span><span class="<%= r.status == 'succeeded' ? 'pill-fern' : r.unresolved? ? 'pill-clay' : 'pill-taupe' %>"><%= r.status == 'unknown' ? 'Needs recheck' : r.status.humanize %></span><% if r.failure_message %><span class="w-full text-mocha"><%= r.failure_message %></span><% end %></li><% end %>
        </ul>
        <% if reversals.any?(&:unresolved?) %><%= button_to 'Recheck refund with gateway', recheck_reversal_pos_checkout_path(@checkout), method: :post, class: 'btn-ghost mt-3', data: { turbo: false } %><% end %>
      <% end %>
      <% remaining = @checkout.total_cents - card[:refunded_cents] %>
      <% if remaining.positive? && reversals.none?(&:unresolved?) && Current.user.can?('sales.write') %>
        <%= form_with url: reverse_pos_checkout_path(@checkout), method: :post, class: 'mt-4 space-y-3', data: { turbo: false } do %>
          <p class="text-sm text-mocha">Refund to the original card. Before the payment settles (usually the same day) only the whole sale can be voided; after that you can refund part or all of it. Restock returned items separately.</p>
          <div class="grid gap-3 sm:grid-cols-2">
            <div><label for="refund_amount" class="field-label">Amount (USD)</label><%= text_field_tag :amount, format('%.2f', remaining / 100.0), id: 'refund_amount', class: 'input', inputmode: 'decimal' %></div>
            <div><label for="refund_reason" class="field-label">Reason</label><%= text_field_tag :reason, nil, id: 'refund_reason', class: 'input', maxlength: 500, required: true %></div>
          </div>
          <%= submit_tag 'Void or refund', class: 'btn-ghost', data: { confirm: 'Send this refund to the card gateway?' } %>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <% if @checkout.status == 'declined' && @checkout.latest_attempt&.decline_reason %><p class="flash flash-alert" role="status"><%= @checkout.latest_attempt.decline_reason %></p><% end %>
  <p class="text-sm text-mocha"><%= @checkout.demo? ? 'Demonstration only. No real payment or inventory movement was made.' : @checkout.sandbox_payment? ? 'Sandbox gateway test. No live sale or source stock movement was made.' : @checkout.terminal_card? ? 'Tender: Card (A920). The card was run on the A920 terminal and recorded here; Rupert sent no gateway charge. Refund it on the terminal, then record the refund on the order.' : "Tender: #{@checkout.tender_label}. A paid receipt requires recorded cash collection or verified gateway approval." %><% if @checkout.order && retail_business_access?('sales.read') %> <%= link_to 'Open order', order_path(@checkout.order), class: 'underline' %><% end %></p>
  <% if %w[ready declined].include?(@checkout.status) || @checkout.unresolved? %>
    <div class="flex flex-wrap gap-2">
      <% if %w[ready declined].include?(@checkout.status) %><%= button_to 'Cancel unpaid checkout', cancel_pos_checkout_path(@checkout), method: :post, class: 'btn-ghost', data: { turbo: false } %><% end %>
      <% if @checkout.unresolved? %><%= button_to 'Recheck gateway payment', reconcile_pos_checkout_path(@checkout), method: :post, class: 'btn-ghost', data: { turbo: false } %><% end %>
    </div>
  <% end %>
  <section class="section-card">
    <%= section_heading 'Stock updates' %>
    <% if @checkout.pos_stock_allocations.empty? %><p class="text-sm text-mocha">No source stock allocation is recorded for this receipt.</p><% end %>
    <% @checkout.pos_stock_allocations.each do |allocation| %><div class="flex flex-wrap items-center justify-between gap-2 border-t border-fog pt-3"><p class="text-sm">Variant #<%= allocation.variant_id %> · <%= allocation.quantity %> units</p><span class="<%= allocation.status == 'applied' ? 'pill-fern' : 'pill-taupe' %>"><%= allocation.status.humanize %></span></div><% end %>
  </section>
</div>
