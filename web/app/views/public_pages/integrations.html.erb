<%# Integrations: public. What Rupert connects to today, in the same terms as web/config/product_roadmap.json
    (Available / Partial / Planned). Keep it in step with the roadmap, and do not name a partner here
    until there is a working, agreed integration. Never name customers.
    OWNER REVIEW: Google Drive is marked Partial because the Google OAuth app was still in Testing
    (docs/ops/google-backup-verification.md); mark it Available once any workspace can connect. %>
<% content_for :title, 'Integrations' %>
<% groups = [
     ['Stores and point of sale', [
       ['Shopify', 'Available', 'Reads products, stock by location and orders into Rupert. Rupert changes nothing in Shopify unless the owner confirms it.'],
       ['Square', 'Available', 'Reads the catalog, stock, sales and timecards. Read-only.'],
       ['C-Trax', 'Available', 'Reads daily orders, register reports, stock counts and staff punches. Read-only.'],
       ['SwipeSimple', 'Available', 'Reviewed imports of sales and register reports.']
     ]],
     ['Card payments', [
       ['Authorize.net', 'Partial', 'Card checkout through Authorize.net hosted card fields, plus read-only transaction reporting. Live use depends on the merchant’s own Authorize.net account and its approval.'],
       ['NMI', 'Partial', 'Card checkout through NMI hosted card fields, on test accounts only. Live charging is switched off.'],
       ['Processor deposit reports', 'Partial', 'Reads deposit reports from supported merchant portals to check them against the register.'],
       ['Card terminals', 'Planned', 'Semi-integrated terminals, where the card is read on the terminal and Rupert receives only the result. Not available yet.']
     ]],
     ['Books and files', [
       ['QuickBooks', 'Available', 'Imports QuickBooks data, and exports the ledger as QuickBooks IIF or CSV.'],
       ['Google Drive', 'Partial', 'Copies retained reports, statements and exports into a Google Drive folder the workspace connects.'],
       ['Rupert API', 'Partial', 'A read-only API for catalog and inventory, with scoped, expiring and revocable tokens. Write access and webhooks are planned.']
     ]]
   ] %>
<div class="page-medium space-y-6">
  <%= page_header 'Integrations', subtitle: 'What Rupert connects to today. Updated Nov 2, 2026.' %>

  <section class="section-card">
    <%= section_heading 'How connections work' %>
    <ul class="list-disc space-y-1 pl-5 text-sm">
      <li>A workspace administrator sets up and authorizes each connection separately. Signing in to Rupert never connects anything on its own.</li>
      <li>Saved credentials are encrypted. Most connections only read data into Rupert, and anything that would change another system asks for the owner’s confirmation first.</li>
      <li>Rupert keeps each source’s numbers separate and never adds two systems’ stock together.</li>
    </ul>
    <p class="text-sm text-mocha"><strong>Available</strong> means it works today. <strong>Partial</strong> means part of the workflow works, as described. <strong>Planned</strong> means it is not available yet.</p>
  </section>

  <% groups.each do |title, rows| %>
    <section class="section-card">
      <%= section_heading title %>
      <dl class="space-y-3">
        <% rows.each do |name, status, detail| %>
          <div>
            <dt class="text-sm font-semibold"><%= name %> <span class="pill <%= { 'Available' => 'pill-fern', 'Partial' => 'pill-clay' }[status] %>"><%= status %></span></dt>
            <dd class="text-sm text-mocha"><%= detail %></dd>
          </div>
        <% end %>
      </dl>
    </section>
  <% end %>

  <section class="section-card">
    <%= section_heading 'Payments and security' %>
    <p class="text-sm">Rupert never receives full card numbers. How card payments are kept out of Rupert’s servers: <%= link_to 'Security and data handling', security_statement_path(anchor: 'card-payments'), class: 'text-olive underline' %>. For a feature-by-feature list, see the <%= link_to 'product roadmap', 'https://techmore.github.io/rupert/roadmap.html', class: 'text-olive underline' %>.</p>
  </section>

  <%= render 'public_pages/policy_links' %>
</div>
