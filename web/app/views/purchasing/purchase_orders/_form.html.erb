<%= form_with model: purchase_order, url: (purchase_order.persisted? ? purchase_order : purchasing_purchase_orders_path), class: "mt-6 space-y-4" do |f| %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :vendor_id, "Vendor", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.collection_select :vendor_id, @vendors, :id, :name, { prompt: "Choose a vendor" }, class: "select w-full" %>
    </div>
    <div>
      <%= f.label :order_number, "Order number", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.text_field :order_number, class: "input", autocomplete: "off" %>
    </div>
  </div>

  <div>
    <%= f.label :expected_date, "Expected date", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
    <%= f.date_field :expected_date, class: "select" %>
  </div>

  <div>
    <%= f.label :notes, "Notes", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
    <%= f.text_area :notes, rows: 2, class: "input !rounded-2xl" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit purchase_order.persisted? ? "Save changes" : "Create purchase order", class: "btn-primary" %>
    <%= link_to "Cancel", purchasing_purchase_orders_path, class: "btn-ghost" %>
  </div>
<% end %>
