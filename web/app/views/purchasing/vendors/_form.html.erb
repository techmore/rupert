<%= form_with model: vendor, url: (vendor.persisted? ? vendor : purchasing_vendors_path), class: "mt-6 space-y-4" do |f| %>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :name, "Vendor name", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.text_field :name, class: "input", placeholder: "e.g. GreenLeaf Distributors", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :contact_name, "Contact person", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.text_field :contact_name, class: "input", autocomplete: "off" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :email, "Email", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.email_field :email, class: "input", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :phone, "Phone", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.telephone_field :phone, class: "input", autocomplete: "off" %>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :payment_terms, "Payment terms", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
      <%= f.select :payment_terms, Purchasing::Vendor::PAYMENT_TERMS, {}, class: "select w-full" %>
    </div>
    <div></div>
  </div>

  <div>
    <%= f.label :address, "Address", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
    <%= f.text_area :address, rows: 2, class: "input !rounded-2xl" %>
  </div>

  <div>
    <%= f.label :notes, "Notes", class: "mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" %>
    <%= f.text_area :notes, rows: 2, class: "input !rounded-2xl" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit vendor.persisted? ? "Save changes" : "Add vendor", class: "btn-primary" %>
    <%= link_to "Cancel", purchasing_vendors_path, class: "btn-ghost" %>
  </div>
<% end %>
