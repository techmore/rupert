<div class="space-y-6">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl text-ink"><%= title %></h1>
      <p class="mt-1 text-sm text-mocha"><%= subtitle %></p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex items-center gap-1 rounded-full border border-fog bg-paper p-1">
        <% { "sales" => "Sales", "financial" => "Financial", "inventory" => "Inventory", "operations" => "Operations" }.each do |key, label| %>
          <%= link_to label, send("#{key}_reports_path", days: @days), class: (params[:action] == key ? "rounded-full bg-olive px-3.5 py-1.5 text-sm font-medium text-cream" : "rounded-full px-3.5 py-1.5 text-sm font-medium text-mocha hover:bg-haze hover:text-ink") %>
        <% end %>
      </div>
      <%= form_tag url_for(action: params[:action]), method: :get, class: "flex items-center gap-1" do %>
        <%= select_tag :days, options_for_select([["7 days", 7], ["30 days", 30], ["90 days", 90], ["1 year", 365]], @days), class: "select" %>
        <%= submit_tag "Refresh", class: "btn-ghost btn-sm" %>
      <% end %>
      <%= link_to "CSV", url_for(action: params[:action], format: :csv, days: @days), class: "btn-ghost btn-sm" %>
    </div>
  </section>
  <%= yield %>
</div>
