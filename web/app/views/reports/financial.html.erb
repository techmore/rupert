<%= render "reports/layout", title: "Financial report", subtitle: "P&L summary and tender breakdown over the last #{@days} days." do %>
  <section class="grid grid-cols-2 gap-4 lg:grid-cols-5">
    <div class="stat">
      <p class="stat-label">Gross revenue</p>
      <p class="stat-value mt-1"><%= number_to_currency(@revenue_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Tax collected</p>
      <p class="stat-value mt-1"><%= number_to_currency(@tax_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Refunds</p>
      <p class="stat-value mt-1 text-rose"><%= number_to_currency(@refund_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Net revenue</p>
      <p class="stat-value mt-1"><%= number_to_currency(@net_cents / 100.0) %></p>
    </div>
    <div class="stat">
      <p class="stat-label">Avg order</p>
      <p class="stat-value mt-1"><%= number_to_currency(@avg_order_cents / 100.0) %></p>
    </div>
  </section>

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Net revenue · daily</h2>
      <div class="mt-3"><%= area_chart @daily_net, height: "220px", colors: chart_color(:ink), legend: false %></div>
    </div>
    <div class="card card-pad">
      <h2 class="font-display text-lg text-ink">Payment tenders</h2>
      <div class="mt-3">
        <% if @tenders.empty? %>
          <p class="text-sm text-taupe">No payment data in this window.</p>
        <% else %>
          <%= pie_chart @tenders, height: "220px", colors: chart_color(:ink, :olive_deep, :clay, :butter) %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="border-b border-fog px-5 py-3">
      <h2 class="font-display text-lg text-ink">P&L summary</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="border-b border-fog bg-haze/60">
          <tr><th scope="col" class="th">Line</th><th scope="col" class="th text-right">Amount</th></tr>
        </thead>
        <tbody class="divide-y divide-fog">
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Gross revenue</td>
            <td class="td text-right font-medium text-ink"><%= number_to_currency(@revenue_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Tax collected</td>
            <td class="td text-right font-medium text-ink"><%= number_to_currency(@tax_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td text-mocha">Refunds</td>
            <td class="td text-right font-medium text-rose"><%= number_to_currency(@refund_cents / 100.0) %></td>
          </tr>
          <tr class="hover:bg-cream">
            <td class="td font-semibold text-ink">Net revenue</td>
            <td class="td text-right font-semibold text-ink"><%= number_to_currency(@net_cents / 100.0) %></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
