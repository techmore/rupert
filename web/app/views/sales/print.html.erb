<% content_for :title, "Print #{l(@date, format: :long)}" %>
<div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-fog bg-paper px-5 py-3 print:hidden">
  <div>
    <h1 class="font-display text-xl text-ink">Print <%= @doc == "invoice" ? "invoices" : "packing slips" %> · <%= l(@date, format: :long) %></h1>
    <p class="text-sm text-mocha"><%= @orders.length %> order(s)</p>
  </div>
  <div class="flex gap-2">
    <%= link_to @doc == "invoice" ? "Packing slips" : "Invoices", sales_print_path(date: @date, doc: @doc == "invoice" ? "packing_slip" : "invoice"), class: "btn-ghost btn-sm" %>
    <button type="button" data-controller="print" data-action="click->print#print" class="btn-primary btn-sm">Print</button>
    <%= link_to "Back to sales", sales_path, class: "btn-ghost btn-sm" %>
  </div>
</div>

<% @orders.each do |order| %>
  <section class="slip rounded-2xl border border-fog bg-paper p-6">
    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-fog pb-4">
      <div>
        <p class="eyebrow text-olive"><%= @doc == "invoice" ? "Invoice" : "Packing slip" %></p>
        <h2 class="font-display text-2xl text-ink"><%= @doc == "invoice" ? "#{TenantSettings.invoice_prefix}-#{order.display_number}" : "Order #{order.display_number}" %></h2>
        <p class="text-sm text-mocha"><%= l(order.occurred_at, format: :long) %></p>
      </div>
      <div class="text-right">
        <p class="font-display text-lg text-ink"><%= TenantSettings.business_name %></p>
        <p class="text-xs text-taupe"><%= order.channel %> · <span class="capitalize"><%= order.source %></span></p>
        <% if @doc == "packing_slip" && order.fulfillments.with_tracking.any? %>
          <p class="mt-1 text-xs text-mocha">Tracking: <%= order.fulfillments.with_tracking.map(&:tracking_number).join(", ") %></p>
        <% end %>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <p class="eyebrow text-mocha">Ship to</p>
        <% if (addr = order.shipping_address) %>
          <p class="mt-1 text-sm font-medium text-ink"><%= addr[:name] %></p>
          <p class="text-sm text-mocha"><%= addr[:line1] %><% if addr[:line2].present? %>, <%= addr[:line2] %><% end %></p>
          <p class="text-sm text-mocha"><%= [addr[:city], addr[:province], addr[:zip]].select(&:present?).join(", ") %></p>
        <% else %>
          <p class="mt-1 text-sm text-taupe">No shipping address.</p>
        <% end %>
      </div>
      <div>
        <p class="eyebrow text-mocha">Customer</p>
        <% if order.customer %>
          <p class="mt-1 text-sm font-medium text-ink"><%= order.customer.name %></p>
          <% if order.customer.email.present? %><p class="text-sm text-mocha"><%= order.customer.email %></p><% end %>
        <% else %>
          <p class="mt-1 text-sm text-taupe">Walk-in</p>
        <% end %>
      </div>
    </div>

    <table class="mt-4 w-full text-sm">
      <thead class="border-b border-fog">
        <tr>
          <th scope="col" class="th">Item</th>
          <th scope="col" class="th">SKU</th>
          <th scope="col" class="th text-right">Qty</th>
          <% if @doc == "invoice" %><th scope="col" class="th text-right">Amount</th><% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-fog">
        <% order.order_lines.each do |line| %>
          <tr>
            <td class="td font-medium text-ink"><%= line.name %></td>
            <td class="td font-mono text-xs text-mocha"><%= line.sku.presence || "—" %></td>
            <td class="td text-right text-mocha"><%= line.quantity %></td>
            <% if @doc == "invoice" %><td class="td text-right font-medium text-ink"><%= number_to_currency(line.line_cents / 100.0) %></td><% end %>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @doc == "invoice" %>
      <div class="mt-3 flex justify-end">
        <dl class="space-y-1 text-sm">
          <div class="flex justify-between gap-8">
            <dt class="text-mocha">Total</dt>
            <dd class="font-semibold text-ink"><%= number_to_currency(order.gross_cents / 100.0) %></dd>
          </div>
        </dl>
      </div>
    <% end %>
  </section>
<% end %>

<% if @orders.empty? %>
  <div class="rounded-2xl border border-fog bg-paper p-8 text-center text-sm text-taupe print:hidden">No orders on this day.</div>
<% end %>
