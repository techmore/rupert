<div class="space-y-8">
  <section>
    <h1 class="font-display text-3xl text-ink">Settings</h1>
    <p class="mt-1 text-sm text-mocha">Environment variables and database backup/restore. Environment keys apply to the sync engine immediately; boot-time keys (Shopify API key/secret, database) come from the droplet env.</p>
  </section>

  <section class="grid gap-4 lg:grid-cols-2">
    <div class="card card-pad">
      <div class="flex items-baseline justify-between">
        <h2 class="font-display text-xl text-ink">Environment (.env)</h2>
        <%= link_to "Export .env", env_export_settings_path, class: "btn-ghost btn-sm", data: { turbo: false } %>
      </div>
      <p class="mt-2 text-xs text-taupe">Import a .env file (or paste its contents) to update managed keys. Values are stored encrypted in the database and override the droplet env.</p>

      <div id="env-list" class="mt-4 space-y-2"></div>

      <form id="env-import-form" class="mt-5 space-y-3">
        <textarea name="text" rows="8" placeholder="KEY=VALUE&#10;# comments are ignored&#10;SQUARE_ACCESS_TOKEN=..." class="input !rounded-2xl font-mono text-xs"></textarea>
        <label class="flex items-center gap-2 text-xs text-mocha">
          or upload a file
          <input type="file" name="file" accept=".env,text/plain" class="text-xs">
        </label>
        <button type="submit" class="btn-primary">Import into settings</button>
        <span id="env-result" class="text-xs"></span>
      </form>
    </div>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Database backup</h2>
      <p class="mt-2 text-xs text-taupe">Download a consistent snapshot of the SQLite database, or restore from a previous backup. Restoring replaces all current data.</p>

      <div class="mt-5 flex flex-wrap gap-2">
        <%= link_to "Download backup", backup_settings_path, class: "btn-primary", data: { turbo: false } %>
        <label class="btn-ghost cursor-pointer">
          Restore from file
          <input type="file" id="restore-file" accept=".sqlite3,.sqlite,.db,application/octet-stream" class="hidden" data-url="<%= restore_settings_path %>">
        </label>
      </div>
      <p id="restore-result" class="mt-3 text-xs"></p>
    </div>
  </section>

  <section class="card card-pad">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Google Drive backup</h2>
      <span id="drive-conn" class="badge"></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Automatically snapshot the database to your Google Drive every 6 hours and keep the last <span id="drive-retention">7</span> backups. Each attempt is logged below.</p>

    <div id="drive-setup" class="mt-5 hidden">
      <p class="text-xs font-medium text-ink">Easy setup — about 5 minutes, one time:</p>
      <ol class="mt-3 space-y-3 text-xs text-mocha">
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">1.</span>
          <span>
            Open Google Cloud in a new tab:
            <a href="https://console.cloud.google.com/" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">console.cloud.google.com ↗</a>
            <br>Sign in, then create a project (or pick an existing one) using the project dropdown at the top.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">2.</span>
          <span>
            Enable the Google Drive API:
            <a href="https://console.cloud.google.com/apis/library/drive.googleapis.com" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Enable Drive API ↗</a>
            <br>Click the blue <b>Enable</b> button.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">3.</span>
          <span>
            Set up the OAuth consent screen:
            <a href="https://console.cloud.google.com/apis/credentials/consent" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Consent screen ↗</a>
            <br>Choose <b>External</b> → Create. Add your business name + email, save. (You can skip the scopes and test users steps.)
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">4.</span>
          <span>
            Create the OAuth client:
            <a href="https://console.cloud.google.com/apis/credentials" target="_blank" rel="noopener" class="font-semibold text-olive hover:underline">Credentials ↗</a>
            <br>Click <b>Create Credentials</b> → <b>OAuth client ID</b> → application type <b>Web application</b>.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">5.</span>
          <span>
            Add this exact <b>Authorized redirect URI</b> (click to copy):
            <br>
            <code class="mt-1 inline-block cursor-pointer select-all rounded-lg bg-haze px-3 py-1.5 font-mono text-xs text-ink" onclick="navigator.clipboard.writeText('<%= drive_oauth_callback_settings_url %>')"><%= drive_oauth_callback_settings_url %></code>
            <br>Click <b>Create</b>. Google shows you a <b>Client ID</b> and <b>Client Secret</b> — copy both.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">6.</span>
          <span>
            Paste them into the <b>Environment (.env)</b> card above and hit <b>Import</b>:
            <br>
            <code class="mt-1 inline-block rounded-lg bg-haze px-3 py-1.5 font-mono text-xs">GOOGLE_DRIVE_CLIENT_ID=your-client-id</code>
            <br>
            <code class="mt-1 inline-block rounded-lg bg-haze px-3 py-1.5 font-mono text-xs">GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret</code>
            <br>Optional: <code class="rounded bg-haze px-1.5 py-0.5 font-mono">GOOGLE_DRIVE_RETENTION=7</code> to change how many backups to keep.
          </span>
        </li>
        <li class="flex flex-wrap items-start gap-2">
          <span class="font-semibold text-olive">7.</span>
          <span>Come back here and click <b>Connect Google Drive</b> below. Done!</span>
        </li>
      </ol>
    </div>

    <div id="drive-connected" class="mt-5 hidden">
      <div class="flex flex-wrap items-center gap-3">
        <%= button_to "Back up now", drive_backup_settings_path, method: :post, class: "btn-primary", data: { turbo: false }, id: "drive-backup-btn" %>
        <a id="drive-latest-link" href="#" target="_blank" rel="noopener" class="btn-ghost hidden">Open latest backup ↗</a>
        <%= button_to "Disconnect", drive_disconnect_settings_path, method: :post, class: "btn-ghost btn-sm", data: { turbo: false } %>
      </div>
      <p id="drive-backup-result" class="mt-3 text-xs"></p>
    </div>

    <div id="drive-connect-btn" class="mt-5 hidden">
      <%= link_to "Connect Google Drive", drive_auth_settings_path, class: "btn-primary", data: { turbo: false } %>
    </div>

    <div class="mt-6">
      <h3 class="text-sm font-display text-ink">Recent backups</h3>
      <div id="drive-logs" class="mt-2 space-y-1.5"></div>
    </div>
  </section>

  <section class="card card-pad">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-xl text-ink">Buzz agent</h2>
      <span class="<%= BuzzAgent.configured? ? "pill-fern" : "pill-taupe" %>"><%= BuzzAgent.configured? ? "Configured" : "Not configured" %></span>
    </div>
    <p class="mt-2 text-xs text-taupe">Rupert joins your Buzz workspace as an agent: it holds its own Nostr keypair and posts signed events to a channel. Events fire on sync results and count submissions.</p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">Agent identity (npub)</p>
        <p class="mt-1 break-all font-mono text-xs text-ink"><%= BuzzAgent.agent_npub || "No keypair yet." %></p>
      </div>
      <div class="rounded-xl bg-haze px-4 py-3">
        <p class="text-xs font-medium text-mocha">Relay / channel</p>
        <p class="mt-1 break-all font-mono text-xs text-ink"><%= EnvStore.fetch("BUZZ_RELAY_URL", "—").presence || "No relay set" %><% if BuzzAgent.channel_id.present? %> · channel <%= BuzzAgent.channel_id[0, 12] %>…<% end %></p>
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to "Generate agent keypair", buzz_generate_settings_path, method: :post, class: "btn-ghost", data: { turbo: false } %>
      <%= button_to "Publish agent profile", buzz_register_settings_path, method: :post, class: "btn-ghost", disabled: !BuzzAgent.configured?, data: { turbo: false } %>
      <%= button_to "Send test message", buzz_test_settings_path, method: :post, class: "btn-primary", disabled: !BuzzAgent.configured?, data: { turbo: false } %>
    </div>

    <p class="mt-4 text-xs text-taupe">Configure on the Environment (.env) card:</p>
    <ul class="mt-2 space-y-1 font-mono text-xs text-mocha">
      <li>BUZZ_RELAY_URL · your relay, e.g. <code>wss://buzz.example.com</code></li>
      <li>BUZZ_CHANNEL · the channel's Nostr event id (kind 40) to post into</li>
    </ul>
    <p class="mt-3 text-xs text-taupe">To let Rupert into a channel: publish its profile, then add the npub as a member — Buzz only knows identities that have a profile on the relay.</p>
  </section>
</div>

<script>
  (function () {
    var list = document.getElementById("env-list");
    var result = document.getElementById("env-result");
    var csrf = document.querySelector('meta[name="csrf-token"]');
    var csrfHeader = csrf ? { "X-CSRF-Token": csrf.content } : {};

    fetch("/settings/env.json", { headers: { "X-Requested-With": "XMLHttpRequest" } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        data.keys.forEach(function (item) {
          var row = document.createElement("div");
          row.className = "flex items-center justify-between gap-4 rounded-xl bg-haze px-4 py-2.5 text-sm";
          row.innerHTML = '<div><p class="font-mono text-xs text-ink">' + item.key + '</p>' +
            '<p class="text-[11px] text-taupe">' + item.source + (item.set ? " · " + item.masked : " · not set") + '</p></div>' +
            '<span class="' + (item.set ? "dot bg-fern" : "dot bg-taupe") + '"></span>';
          list.appendChild(row);
        });
      });

    document.getElementById("env-import-form").addEventListener("submit", function (e) {
      e.preventDefault();
      result.textContent = "Importing…";
      var form = new FormData(this);
      fetch("/settings/env_import", { method: "POST", body: form, headers: Object.assign({ "X-Requested-With": "XMLHttpRequest" }, csrfHeader) })
        .then(function (r) { return r.json().then(function (b) { return { ok: r.ok, body: b }; }); })
        .then(function (res) {
          if (res.ok) {
            result.textContent = "Imported " + res.body.imported.length + " key(s).";
            setTimeout(function () { window.location.reload(); }, 800);
          } else {
            result.textContent = "Error: " + res.body.error;
          }
        });
    });

    document.getElementById("restore-file").addEventListener("change", function (e) {
      var file = e.target.files[0];
      if (!file) return;
      var r = document.getElementById("restore-result");
      r.textContent = "Restoring…";
      var form = new FormData();
      form.append("file", file);
      fetch(e.target.dataset.url, { method: "POST", body: form, headers: Object.assign({ "X-Requested-With": "XMLHttpRequest" }, csrfHeader) })
        .then(function (res) { return res.json().then(function (b) { return { ok: res.ok, body: b }; }); })
        .then(function (res) {
          r.textContent = res.ok ? "Restored. Reloading…" : "Error: " + res.body.error;
          if (res.ok) setTimeout(function () { window.location.reload(); }, 1000);
        });
    });

    var connEl = document.getElementById("drive-conn");
    var setupEl = document.getElementById("drive-setup");
    var connectedEl = document.getElementById("drive-connected");
    var connectBtnEl = document.getElementById("drive-connect-btn");
    var logsEl = document.getElementById("drive-logs");
    var resultEl = document.getElementById("drive-backup-result");

    function driveBadge(status) {
      connEl.textContent = status.connected ? "Connected" : (status.configured ? "Not connected" : "Not configured");
      connEl.className = "badge " + (status.connected ? "bg-fern" : "bg-taupe");
    }

    function driveRender(s) {
      driveBadge(s);
      document.getElementById("drive-retention").textContent = s.retention;
      setupEl.classList.toggle("hidden", s.configured);
      connectedEl.classList.toggle("hidden", !s.connected);
      connectBtnEl.classList.toggle("hidden", !s.configured || s.connected);

      var link = document.getElementById("drive-latest-link");
      if (s.latest_drive_url) { link.href = s.latest_drive_url; link.classList.remove("hidden"); }
      else { link.classList.add("hidden"); }

      var latest = s.last;
      if (latest && latest.status === "success" && latest.driveUrl) {
        resultEl.textContent = "Last successful backup: " + (latest.fileName || "") + " — " + latest.driveUrl;
      } else if (latest && latest.status === "failed") {
        resultEl.textContent = "Last backup failed: " + (latest.error || "unknown error");
      } else {
        resultEl.textContent = "";
      }

      fetch("/settings/drive_logs.json", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { return r.json(); })
        .then(function (rows) {
          logsEl.innerHTML = "";
          if (!rows.length) {
            logsEl.innerHTML = '<p class="text-xs text-taupe">No backups yet.</p>';
            return;
          }
          rows.forEach(function (row) {
            var el = document.createElement("div");
            el.className = "flex items-center justify-between gap-3 rounded-xl bg-haze px-4 py-2 text-xs";
            var label = row.status === "success" ? "bg-fern" : (row.status === "failed" ? "bg-rose" : "bg-butter");
            el.innerHTML = '<div class="flex items-center gap-2"><span class="dot ' + label + '"></span>' +
              '<span class="font-mono text-ink">' + (row.fileName || "—") + '</span>' +
              (row.driveUrl ? '<a href="' + row.driveUrl + '" target="_blank" rel="noopener" class="text-olive hover:underline">open ↗</a>' : "") + '</div>' +
              '<div class="text-right text-taupe"><span>' + row.finishedLabel + '</span>' +
              (row.error ? '<p class="text-rose">' + row.error + '</p>' : "") + '</div>';
            logsEl.appendChild(el);
          });
        });
    }

    function driveRefresh() {
      fetch("/settings/drive_status.json", { headers: { "X-Requested-With": "XMLHttpRequest" } })
        .then(function (r) { return r.json(); })
        .then(driveRender)
        .catch(function () { connEl.textContent = "Status unavailable"; });
    }

    var backupBtn = document.getElementById("drive-backup-btn");
    if (backupBtn) {
      backupBtn.addEventListener("click", function (e) {
        e.preventDefault();
        resultEl.textContent = "Backing up…";
        fetch("/settings/drive_backup.json", { method: "POST", headers: Object.assign({ "X-Requested-With": "XMLHttpRequest" }, csrfHeader) })
          .then(function (res) { return res.json().then(function (b) { return { ok: res.ok, body: b }; }); })
          .then(function (res) {
            if (res.ok) {
              resultEl.textContent = res.body.status === "success"
                ? "Backup uploaded. Open it on Google Drive: " + res.body.driveUrl
                : "Backup failed: " + (res.body.error || "unknown error");
              driveRefresh();
            } else {
              resultEl.textContent = "Error: " + res.body.error;
            }
          });
      });
    }

    driveRefresh();
  })();
</script>
