<%# Usage: render "shared/form_errors", model: <record>
    Renders the standard alert box for a failed save. Renders nothing when
    the record has no errors. %>
<% if model&.errors&.any? %>
  <div role="alert" class="rounded-xl border border-rose/30 bg-rose/10 px-4 py-2.5 text-sm text-rose">
    <%= model.errors.full_messages.to_sentence %>
  </div>
<% end %>
