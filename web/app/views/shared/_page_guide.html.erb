<details class="group mb-6 rounded-2xl border border-olive/20 bg-paper shadow-[0_1px_2px_rgba(26,57,61,0.06)]" open>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-3 [&::-webkit-details-marker]:hidden">
    <span class="flex items-center gap-2.5 text-sm font-semibold text-ink">
      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-olive/10 text-olive-deep">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
      </span>
      How to use this page
      <span class="hidden text-taupe sm:inline">·</span>
      <span class="hidden font-medium text-mocha sm:inline"><%= guide.title %></span>
    </span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-taupe transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </summary>

  <div class="border-t border-fog px-5 py-4">
    <p class="text-sm text-mocha"><%= guide.summary %></p>

    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <% guide.sections.each do |section| %>
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-wide text-olive-deep"><%= section[:heading] %></h3>
          <p class="mt-1 text-sm text-mocha"><%= section[:body] %></p>
        </div>
      <% end %>

      <% if guide.tips.any? %>
        <div class="lg:col-span-2">
          <h3 class="text-[11px] font-semibold uppercase tracking-wide text-olive-deep">Best practices</h3>
          <ul class="mt-1.5 space-y-1.5 text-sm text-mocha">
            <% guide.tips.each do |tip| %>
              <li class="flex items-start gap-2">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-olive-deep" aria-hidden="true"></span>
                <span><%= tip %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</details>
