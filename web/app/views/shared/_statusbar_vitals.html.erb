<%# Platform administrators only: server health at a glance (HostVitals, cached 30 s). %>
<% vitals = HostVitals.current %>
<% level = ->(percent) { percent.nil? ? '' : (percent >= HostVitals::ALERT ? 'vital-alert' : (percent >= HostVitals::WARN ? 'vital-warn' : '')) } %>
<%# Backups: the encrypted server backups (BackupHealth), the same answer as Settings → Backups and the bell. %>
<% backups = BackupHealth.current %>
<%= link_to system_path, class: 'statusbar-item statusbar-vitals', aria: { label: 'Server health' },
      title: "Server health, read #{l(vitals.taken_at, format: :short)}. Amber from #{HostVitals::WARN}%, red from #{HostVitals::ALERT}%." do %>
  <span class="<%= level.(vitals.cpu) %>" data-vital="cpu">CPU <%= vitals.cpu ? "#{vitals.cpu}%" : '—' %></span>
  <span class="<%= level.(vitals.memory) %>" data-vital="memory">RAM <%= vitals.memory ? "#{vitals.memory}%" : '—' %></span>
  <span class="<%= level.(vitals.disk) %>" data-vital="disk">Disk <%= vitals.disk ? "#{vitals.disk}%" : '—' %></span>
  <span class="statusbar-label" data-vital="db">DB <%= vitals.db_bytes ? number_to_human_size(vitals.db_bytes, precision: 3) : '—' %></span>
  <span class="statusbar-label <%= 'vital-alert' if backups.alert? %>" data-vital="backup" data-backup-health="<%= backups.state %>"><%= { off: 'Backups off', attention: 'Backups need attention', starting: 'First backup pending' }[backups.state] || "Backup #{time_ago_in_words(backups.last_good_at)} ago" %></span>
<% end %>
