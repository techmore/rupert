<%# SwipeSimple's native daily sales report: the four register-slip boxes for each merchant account.
    Accounts are never added together: each account (e.g. the counter terminal and a separate card account)
    has its own slip, so a combined figure would match neither. Locals: close (SwipesimpleDayClose), level (default :h2). %>
<% level = local_assigns.fetch(:level, :h2) %>
<% money = ->(cents) { ctrax_money(cents) } %>
<% boxes = [['Total collected', :net_sales_cents], ['Sales tax collected', :tax_cents], ['Credit card collected', :net_card_cents], ['Cash collected', :net_cash_cents]] %>
<% reports = close.register_reports.sort_by { |report| [report[:values].values.all? { |value| value&.zero? } ? 1 : 0, report[:account].to_s] } %>
<% box_grid = lambda do |values| %>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <% boxes.each do |label, field| %>
      <div class="stat" data-register-total="<%= field %>">
        <p class="stat-label"><%= label %></p>
        <p class="stat-value mt-2"><%= money.call(values[field]) %></p>
      </div>
    <% end %>
  </div>
<% end %>
<section aria-label="Register close totals" class="space-y-3">
  <%= section_heading 'Register close totals', level: level, hint: "SwipeSimple’s daily sales report for #{close.date.strftime('%b %-d, %Y')}, one set per merchant account so each matches that account’s register slip." %>
  <% if reports.empty? %>
    <% box_grid.call({}) %>
  <% else %>
    <% reports.each do |report| %>
      <% quiet = report[:values].values.all? { |value| value&.zero? } %>
      <div class="space-y-2" data-register-account="<%= report[:account] %>">
        <p class="text-sm"><span class="font-semibold text-ink"><%= report[:account] %></span>
          <span class="text-xs text-mocha"> · <%= report[:pulled_at] ? "report pulled #{retail_source_time(report[:pulled_at])}" : 'no report stored' %></span>
          <% if quiet %><span class="text-xs text-mocha"> · no sales on this report ($0.00)</span><% end %></p>
        <% box_grid.call(report[:values]) unless quiet %>
      </div>
    <% end %>
  <% end %>
  <% if reports.empty? || reports.any? { |report| report[:values].values.any?(&:nil?) } %>
    <p class="text-sm text-mocha">Some daily sales report amounts are missing. They are shown as Unknown until the reports supply them.</p>
    <% if retail_business_access?('settings.read') %><p><%= link_to 'Open SwipeSimple connection', pos_connection_path('swipesimple'), class: 'btn-ghost btn-sm' %></p><% end %>
  <% end %>
  <details class="explainer">
    <summary class="explainer-summary">Where these amounts come from</summary>
    <div class="mt-2 space-y-3 text-sm text-mocha">
      <p>Total collected is SwipeSimple’s Total Net Sales; tax, tips and refunds are already reflected in the reported amounts. Sales tax is shown separately for reference, not added again. These reports and the SwipeSimple transaction totals describe the same activity.</p>
      <p>Each merchant account is shown on its own and the accounts are not added together, so each set of boxes can be checked against that account’s register slip.</p>
      <p>Amounts are the latest stored figures for this business date. A report pulled before the day ended is provisional. An omitted day is zero only when a report covering it was pulled after the day ended. A blank report amount stays Unknown.</p>
    </div>
  </details>
</section>
