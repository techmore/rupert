<%# Push safety gate: nothing writes to Shopify/Square without an approved
    multi-person push window, and a frozen platform blocks all traffic — writes
    and its syncs — until it is explicitly unfrozen. %>
<section class="card card-pad border-rose/30">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="font-display text-xl text-ink">Push safety gate</h2>
      <p class="mt-1 max-w-2xl text-xs text-taupe">
        Every outbound write to Shopify or Square (reconcile apply, negative-inventory fixes, size approvals)
        is blocked unless a push window has been approved by <%= @push_guard.first[:approvals_required] %> different people.
        Windows expire automatically. A <span class="font-semibold text-rose">frozen</span> platform blocks writes
        <em>and</em> pauses its syncs — Square is frozen during its current platform update.
      </p>
    </div>
  </div>

  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <% @push_guard.each do |st| %>
      <div class="rounded-xl border border-fog bg-cream/50 p-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-display text-lg text-ink"><%= st[:label] %></span>
          <% if st[:frozen] %>
            <span class="pill-rose">FROZEN<%= st[:freeze_reason] ? " · #{st[:freeze_reason]}" : "" %></span>
          <% elsif st[:window_open] %>
            <span class="pill-fern">push window open</span>
          <% else %>
            <span class="pill-taupe">locked</span>
          <% end %>
          <% if st[:default_policy] && st[:frozen] %>
            <span class="pill-taupe">default policy</span>
          <% end %>
        </div>

        <% if st[:frozen] %>
          <p class="mt-2 text-xs text-rose">
            All traffic to <%= st[:label] %> is paused while frozen — writes and syncs are blocked until it is unfrozen.
          </p>
        <% elsif st[:window_open] %>
          <p class="mt-2 text-xs text-fern">
            Writes allowed until <%= l(Time.zone.parse(st[:window_expires_at]), format: :short) rescue st[:window_expires_at] %> — the window closes automatically.
          </p>
        <% else %>
          <p class="mt-2 text-xs text-taupe">
            Writes locked. <%= st[:approvals_needed] %> of <%= st[:approvals_required] %> approvals recorded.
          </p>
        <% end %>

        <ul class="mt-3 space-y-1">
          <% st[:approvals].each do |approval| %>
            <li class="text-xs text-mocha">✓ <%= approval[:email] %> · <%= l(Time.zone.parse(approval[:at]), format: :short) rescue approval[:at] %></li>
          <% end %>
          <% if st[:approvals].empty? %>
            <li class="text-xs text-taupe">No approvals yet.</li>
          <% end %>
        </ul>

        <div class="mt-3 flex flex-wrap gap-2">
          <% if Current.user.can?("reconcile.write") && !st[:frozen] %>
            <%= form_tag push_guard_approve_syncs_path, method: :post, class: "inline" do %>
              <%= hidden_field_tag :platform, st[:platform] %>
              <%= submit_tag st[:window_open] ? "Re-approve window" : "Approve #{st[:label]} push window", class: "btn-primary btn-sm" %>
            <% end %>
          <% end %>
          <% if Current.user.can?("settings.write") %>
            <% if st[:frozen] %>
              <%= form_tag push_guard_unfreeze_syncs_path, method: :post, class: "inline" do %>
                <%= hidden_field_tag :platform, st[:platform] %>
                <%= submit_tag "Unfreeze #{st[:label]}", class: "btn-ghost btn-sm" %>
              <% end %>
            <% else %>
              <%= form_tag push_guard_freeze_syncs_path, method: :post, class: "inline" do %>
                <%= hidden_field_tag :platform, st[:platform] %>
                <%= hidden_field_tag :reason, "manual freeze" %>
                <%= submit_tag "Freeze #{st[:label]} (maintenance)", class: "btn-ghost btn-sm !text-rose" %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
