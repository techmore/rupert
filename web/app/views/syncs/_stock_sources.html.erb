<%# Stock health per platform (StockSourceHealth): every store's latest read and the latest problem with its fix. %>
<section aria-labelledby="stock-sources-title" class="space-y-3" id="stock-sources">
  <%= section_heading 'Stock sources', id: 'stock-sources-title', hint: 'How fresh each platform’s stock is, store by store. A read older than an hour shows as old and is never pushed.' %>
  <div class="grid gap-3 lg:grid-cols-3">
    <% StockSourceHealth.all.each do |source| %>
      <article class="card card-pad space-y-2" data-source="<%= source.key %>" aria-label="<%= source.label %> stock">
        <div class="flex items-start justify-between gap-2">
          <div><p class="font-semibold text-ink"><%= source.label %></p><p class="text-xs text-taupe"><%= source.purpose %></p></div>
          <span class="<%= SourceSyncStatus.tone(source.badge) %> shrink-0"><%= source.badge %></span>
        </div>
        <% if source.reads.any? %>
          <ul class="text-sm" aria-label="Latest stock read per store">
            <% source.reads.each do |read| %>
              <li class="flex items-baseline justify-between gap-2 py-0.5"><span class="min-w-0 truncate text-mocha"><%= read.name %></span><span class="shrink-0 tabular-nums <%= read.old? ? 'font-semibold text-clay' : 'text-ink' %>"><%= read.at ? "#{short_age(read.at)} ago" : 'never' %><%= ' · old' if read.old? %></span></li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-mocha"><%= source.key == 'square' ? 'No Square stock is read for this store.' : 'No stock read yet.' %></p>
        <% end %>
        <% if (problem = source.problem) %>
          <div class="border-t border-fog pt-2">
            <p class="text-sm font-semibold <%= problem.recovered ? 'text-mocha' : 'text-rose' %>"><%= problem.title %> · <%= short_age(problem.at) %> ago<%= ' · worked again since' if problem.recovered %></p>
            <p class="text-xs text-mocha"><%= problem.fix %></p>
          </div>
        <% end %>
        <div class="flex flex-wrap gap-2 pt-1">
          <% if source.key == 'shopify' && source.ready && Current.user.can?('sync.write') %><%= button_to 'Sync Shopify now', source_syncs_path(source: 'shopify'), class: 'btn-ghost btn-sm', form: { data: { turbo: false } } %><% end %>
          <% if source.key == 'ctrax' %>
            <%= link_to 'C-Trax stock', ctrax_stock_index_path, class: 'btn-ghost btn-sm' %>
            <% if Current.user.can?('settings.read') %><%= link_to 'C-Trax setup', pos_connection_path('ctrax'), class: 'btn-ghost btn-sm' %><% end %>
          <% end %>
        </div>
      </article>
    <% end %>
  </div>
</section>
