<% content_for :title, "Sync" %>
<div class="space-y-6" data-controller="live-sync">
  <section class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="font-display text-3xl text-ink">Sync</h1>
      <p class="mt-1 text-sm text-mocha">Every pull from Shopify and Square is recorded here. Syncs run on a schedule and can be triggered manually.</p>
    </div>
    <div class="flex gap-2">
      <%= form_tag syncs_path, method: :post, class: "inline" do %>
        <%= submit_tag "Sync everything", class: "btn-primary" %>
      <% end %>
      <%= form_tag source_syncs_path, method: :post, class: "inline" do %>
        <%= hidden_field_tag :source, "square" %>
        <%= submit_tag "Square only", class: "btn-ghost btn-sm" %>
      <% end %>
      <%= form_tag source_syncs_path, method: :post, class: "inline" do %>
        <%= hidden_field_tag :source, "shopify" %>
        <%= submit_tag "Shopify only", class: "btn-ghost btn-sm" %>
      <% end %>
    </div>
  </section>

  <%= render "syncs/banner" %>

  <section class="grid gap-4 lg:grid-cols-2">
    <%= render "syncs/runs" %>

    <div class="card card-pad">
      <h2 class="font-display text-xl text-ink">Recent log entries</h2>
      <ul class="mt-4 space-y-2.5">
        <% if @logs.empty? %>
          <li class="py-3 text-sm text-taupe">No log file yet — it appears after a sync runs.</li>
        <% end %>
        <% @logs.each do |log| %>
          <li class="flex gap-3">
            <span class="<%= log["level"] == "success" ? "pill-fern" : log["level"] == "error" ? "pill-rose" : "pill-taupe" %> shrink-0"><%= log["level"] %></span>
            <div class="min-w-0">
              <p class="text-sm text-ink"><%= log["message"] %></p>
              <p class="text-xs text-taupe"><%= l(Time.zone.parse(log["at"]), format: :short) rescue "" %></p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </section>
</div>
