<%# The 0–9 scoreboard (TeamChat::Scorecard): one score per axis, overall and per module, real timing, and the change since the previous run. %>
<% axes = TeamChat::Scorecard::AXES %>
<% sla = TeamChat::Scorecard::SLOW_SECONDS.to_i %>
<% free = TeamChat::Scorecard::FREE_SECONDS.to_i %>
<% level = ->(value) { value.nil? ? 'none' : (value >= 7 ? 'high' : (value <= 3 ? 'low' : 'mid')) } %>
<%# Plain Ruby, not an ERB block: a lambda that writes template output prints its markup and then returns it again, which showed up as stray "</span>" text. %>
<% cell = lambda do |value, change = nil|
     arrow = change && change != 0 ? content_tag(:small, "#{change.positive? ? '▲' : '▼'}#{change.abs}", class: (change.positive? ? 'text-fern' : 'text-clay'), title: "Change since this model's previous run") : ''.html_safe
     content_tag(:span, safe_join([value.nil? ? '—' : value, arrow]), class: 'score-cell', data: { level: level.call(value) }, title: (value.nil? ? 'Not measured yet' : "#{value} out of 9"))
   end %>
<% seconds = ->(value) { value.nil? ? '—' : (value >= 100 ? "#{value.round} s" : "#{value} s") } %>
<% best = axes.keys.index_with { |key| @scorecard.filter_map { |card| card.overall[key] }.max } %>
<% fastest = @scorecard.filter_map { |card| card.timing.median }.min %>

<section class="mb-6" id="scorecard">
  <div class="flex flex-wrap items-baseline gap-2">
    <h2 class="font-display text-lg text-ink">Scoreboard</h2>
    <span class="text-sm text-mocha">Each model’s latest test runs, 0–9 per axis (9 is best). Axes are kept separate, so fast-but-wrong and slow-but-right look different. ▲▼ is the change since that model’s previous run. Sorted by <strong><%= axes[@score_axis] %></strong>; click a heading to re-sort.</span>
  </div>
  <% if @scorecard.empty? %>
    <p class="mt-2 text-sm text-mocha">No scored test runs yet.</p>
  <% else %>
    <div class="card mt-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full score-table text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th score-sticky">Model</th>
              <% axes.each do |key, label| %>
                <th scope="col" class="th text-right" aria-sort="<%= @score_axis == key ? 'descending' : 'none' %>"><%= link_to "#{label}#{' ↓' if @score_axis == key}", team_chat_scores_path(days: @days, set: @run_set, axis: key, anchor: 'scorecard'), class: (@score_axis == key ? 'font-semibold text-fern' : '') %></th>
              <% end %>
              <th scope="col" class="th text-right" title="Median time until the first word of the answer appeared (local models only), and the slow end: 95 in 100 were faster">First token (med / p95)</th>
              <th scope="col" class="th text-right" title="Median answer time">Median</th>
              <th scope="col" class="th text-right" title="95 in 100 answers were faster than this">Slow end (p95)</th>
              <th scope="col" class="th text-right" title="Answers slower than <%= free %> seconds lose speed points">Over <%= free %> s</th>
              <th scope="col" class="th text-right" title="Answers past <%= sla %> seconds are ignored in the speed score and these times">Ignored (&gt;<%= sla %> s)</th>
              <th scope="col" class="th text-right" title="Median time to load the model before answering, when recorded">Load</th>
              <th scope="col" class="th text-right">Questions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% @scorecard.each_with_index do |card, index| %>
              <% t = card.timing %>
              <tr class="hover:bg-cream">
                <td class="td whitespace-nowrap score-sticky">
                  <span class="text-taupe"><%= index + 1 %></span>
                  <strong class="text-ink">@<%= card.handle %></strong>
                  <span class="block text-xs text-taupe"><%= card.model %> · <%= card.where %><% if card.tested_at %> · <%= time_ago_in_words(card.tested_at) %> ago<% end %></span>
                </td>
                <% axes.each_key do |key| %>
                  <td class="td text-right"><%= cell.call(card.overall[key], card.change[key]) %><% if card.overall[key] && card.overall[key] == best[key] && @scorecard.size > 1 %> <span title="Best <%= axes[key].downcase %> score">🥇</span><% end %></td>
                <% end %>
                <td class="td text-right score-time" title="Time to first token: median / 95 in 100 were faster"><%= t.ttft_median ? "#{t.ttft_median} / #{t.ttft_p95} s" : '—' %></td>
                <td class="td text-right score-time"><%= seconds.call(t.median) %><% if t.median && t.median == fastest && @scorecard.size > 1 %> <span title="Fastest median">⚡</span><% end %></td>
                <td class="td text-right score-time <%= 'text-clay' if t.p95 && t.p95 > sla %>"><%= seconds.call(t.p95) %></td>
                <td class="td text-right score-time <%= 'text-clay font-semibold' if t.answered.positive? && t.slow * 4 > t.answered %>" title="<%= t.answered.zero? ? '' : "#{(t.slow * 100.0 / t.answered).round}% of answers" %>"><%= t.answered.zero? ? '—' : "#{t.slow}/#{t.answered}" %></td>
                <td class="td text-right score-time text-taupe"><%= t.ignored.zero? ? '0' : t.ignored %></td>
                <td class="td text-right score-time text-taupe"><%= seconds.call(t.load) %></td>
                <td class="td text-right text-xs text-taupe"><%= card.graded %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <h3 class="mt-4 text-sm font-semibold text-ink"><%= axes[@score_axis] %> by module</h3>
    <div class="card mt-2 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full score-table text-sm">
          <thead class="border-b border-fog bg-haze/60">
            <tr>
              <th scope="col" class="th score-sticky">Model</th>
              <% TeamChat::Leaderboard::COLUMNS.each_value do |label| %><th scope="col" class="th text-right"><%= label %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-fog">
            <% @scorecard.each do |card| %>
              <tr class="hover:bg-cream">
                <td class="td whitespace-nowrap score-sticky"><strong class="text-ink">@<%= card.handle %></strong></td>
                <% TeamChat::Leaderboard::COLUMNS.each_key do |column| %>
                  <td class="td text-right"><%= cell.call(card.modules.dig(column, @score_axis)) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-taupe">
      <span>Key:</span>
      <span class="score-cell" data-level="high">7–9</span><span class="score-cell" data-level="mid">4–6</span><span class="score-cell" data-level="low">0–3</span><span class="score-cell" data-level="none">—</span> not measured yet (never zero)
    </p>
    <p class="mt-1 text-xs text-taupe">Quality is the grader’s 1–5 mean mapped to 0–9. Speed: each answer scores 9 up to <%= free %> s, then loses points evenly to 0 at <%= sla %> s, and the score is the average. Answers past <%= sla %> s are ignored in the speed score and counted in the Ignored column. Reliability is answered out of attempted. First token: the median time until the first word appeared, on a log scale (9 at 1 s or less, 0 at 20 s or more); only local models record it, so remote models show a dash. Small samples move a lot: a module with two or three questions is a hint, not a ranking. Scale <code><%= TeamChat::Scorecard.scale_hash %></code>.</p>
  <% end %>
</section>
