<% content_for :title, t('time.clock.page.title') %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% correction_pill = { 'pending' => [t('time.clock.page.waiting'), 'pill-clay'], 'approved' => [t('time.clock.page.approved'), 'pill-fern'], 'rejected' => [t('time.clock.page.denied'), 'pill-rose'] } %>
<div class="space-y-6">
  <%= page_header t('time.clock.page.title'), subtitle: t('time.clock.page.subtitle', zone: Time.zone.name.sub(/ \(US & Canada\)/, '')),
        menu: (Current.user.can?('payroll.read') ? [['Commission preview', commission_preview_time_clock_path]] : nil) %>
  <%= render 'shared/open_clock_outs', items: @open_items, limit: @open_clock_outs.limit_hours %>
  <% if @worker %>
    <%= render 'shared/clock_card', worker: @worker, open_shift: @open_shift %>
  <% else %>
    <section class="section-card" aria-label="Clock in or out">
      <%= section_heading 'Link your worker record', hint: 'Ask an administrator to connect exactly one active Staff record to your sign-in account. Contractors can use the same time clock. Your existing shift history stays below.' %>
      <% if @open_shift && @open_shift.started_at >= ClockShift::MAX_SHIFT_HOURS.hours.ago %>
        <%= button_to t('time.clock.actions.clock_out'), clock_out_time_clock_path, params: { shift_id: @open_shift.id }, method: :post, class: 'btn-primary btn-lg', data: { turbo: false } %>
      <% end %>
    </section>
  <% end %>

  <section class="space-y-3" aria-labelledby="shifts-heading">
    <%= section_heading t('time.clock.page.your_shifts'), id: 'shifts-heading', hint: t('time.clock.page.your_shifts_hint') %>
    <% if @shifts.empty? %>
      <%= empty_state t('time.clock.page.no_shifts'), hint: t('time.clock.page.no_shifts_hint') %>
    <% else %>
      <% rules = PayRules.current %>
      <% @shifts.group_by { |shift| rules.period_range(shift.started_at.in_time_zone.to_date) }.each do |(from, to), shifts| %>
        <% week_hours = shifts.reject(&:stale_open?).sum { |shift| shift.paid_hours.to_d } %>
        <div class="card shift-week" data-shift-week="<%= from.iso8601 %>">
          <div class="row-item border-b border-fog">
            <h3 class="card-title"><%= period_range(from, to) %></h3>
            <p class="row-item-end text-sm"><span class="num font-semibold text-ink"><%= format_hours(week_hours, unit: true) %></span></p>
          </div>
          <ul class="row-list">
            <% shifts.each do |shift| %>
              <li class="row-item" id="shift-<%= shift.id %>" data-shift-id="<%= shift.id %>">
                <div class="min-w-0">
                  <p class="timesheet-day-name"><%= shift.started_at.in_time_zone.strftime('%a, %b %-d') %></p>
                  <p class="text-sm text-mocha"><%= shift.stale_open? ? "#{shift.started_at.in_time_zone.strftime('%-I:%M %p')} – #{t('time.clock.state.never_clocked_out').downcase}" : shift_span(shift.started_at, shift.ended_at) %><%= " · #{shift.register_name}" if shift.register_name.present? %></p>
                  <% if shift.breaks.any? %><p class="clock-break-list"><% shift.breaks.sort_by(&:started_at).each do |b| %><span><%= b.kind == 'meal' ? t('time.clock.page.meal_kind') : t('time.clock.page.break_kind') %> · <%= b.started_at.in_time_zone.strftime('%-I:%M %p') %> · <%= b.minutes %> min</span><% end %></p><% end %>
                  <% shift.corrections.sort_by(&:created_at).reverse.each do |correction| %>
                    <% label, pill = correction_pill.fetch(correction.status, [correction.status.humanize, 'pill-taupe']) %>
                    <p class="mt-1 text-xs text-mocha"><span class="<%= pill %>"><%= label %></span> <%= t('time.clock.page.correction_to', span: shift_span(correction.proposed_started_at, correction.proposed_ended_at)) %><%= " · #{t('time.clock.page.break_changes')}" if correction.changes_breaks? %> · <%= correction.reason %><%= " · #{correction.review_note}" if correction.review_note.present? %></p>
                  <% end %>
                </div>
                <div class="row-item-end">
                  <span class="num font-semibold text-ink"><%= shift.stale_open? ? '–' : format_hours(shift.paid_hours, unit: true) %></span>
                  <% if shift.stale_open? && shift.corrections.none? { |c| c.status == 'pending' } %>
                    <%= link_to t('time.clock.home.fix_clock_out'), fix_clock_out_time_clock_path(shift), class: 'btn-ghost btn-sm' %>
                  <% elsif shift.ended_at && shift.corrections.none? { |c| c.status == 'pending' } %>
                    <details class="entry-edit">
                      <summary class="btn-ghost btn-sm" aria-label="<%= t('time.clock.page.fix_punch_title') %> · <%= shift.started_at.in_time_zone.strftime('%A, %B %-d') %>"><%= t('time.clock.page.fix_punch') %></summary>
                      <%= render 'time_clock/fix_punch_form', shift: shift %>
                    </details>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <% if @pagy.pages > 1 %><%== @pagy.series_nav %><% end %>
    <% end %>
  </section>

  <% if @pending_corrections %><section class="space-y-3" id="corrections" aria-labelledby="corrections-heading">
    <%= section_heading 'Corrections to review', id: 'corrections-heading', hint: 'Approving changes the shift times and keeps the original on record. It does not change an approved timesheet or payroll.' %>
    <% if @pending_corrections.empty? %>
      <%= empty_state 'No corrections waiting', hint: 'Requests from staff appear here.' %>
    <% else %>
      <div class="card"><ul class="row-list">
        <% @pending_corrections.each do |correction| %>
          <li class="row-item" data-correction-id="<%= correction.id %>">
            <div class="min-w-0 text-sm">
              <p class="font-semibold text-ink"><%= correction.clock_shift.employee_name %> · <%= correction.original_started_at.in_time_zone.strftime('%a, %b %-d') %><% if correction.clock_shift.auto_closed_at %> <span class="pill-olive">Closed from the clock</span><% end %></p>
              <p><span class="text-mocha">Was</span> <%= correction.original_ended_at ? shift_span(correction.original_started_at, correction.original_ended_at) : "#{correction.original_started_at.in_time_zone.strftime('%-I:%M %p')} – never clocked out" %></p>
              <p><span class="text-mocha">Asks for</span> <strong><%= shift_span(correction.proposed_started_at, correction.proposed_ended_at) %></strong></p>
              <% if correction.changes_breaks? %><p class="clock-break-list"><span class="text-mocha">Breaks:</span><% correction.proposed_breaks.each do |b| %><span><%= b['kind'] == 'meal' ? 'Meal' : 'Break' %> · <%= Time.zone.parse(b['started_at']).strftime('%-I:%M %p') %> – <%= Time.zone.parse(b['ended_at']).strftime('%-I:%M %p') %></span><% end %><% if correction.proposed_breaks.empty? %><span>none</span><% end %></p><% end %>
              <p class="text-mocha"><%= correction.reason %></p>
            </div>
            <div class="row-item-end">
              <% if correction.clock_shift.user_id == Current.user.id || correction.requested_by_id == Current.user.id %>
                <span class="text-sm text-mocha">Your own request: another reviewer approves it.</span>
              <% else %>
                <%= button_to 'Approve', approve_correction_time_clock_path(correction), method: :post, class: 'btn-primary btn-sm', form: { data: { turbo_confirm: 'Apply these corrected shift times? Payroll does not change.' } } %>
                <%= button_to 'Deny', reject_correction_time_clock_path(correction), method: :post, class: 'btn-ghost btn-sm' %>
              <% end %>
            </div>
          </li>
        <% end %>
      </ul></div>
    <% end %>
  </section><% end %>
</div>
