<% content_for :title, "Checkout · #{@share.name}" %>
<section class="space-y-8">
  <header class="border-b border-fog pb-6">
    <p class="eyebrow text-olive">Warehouse sale</p>
    <h1 class="mt-2 font-display text-4xl text-ink md:text-5xl">Checkout</h1>
    <p class="mt-3 max-w-xl text-mocha"><%= @share.name %> · your card details are tokenized in your browser and never touch our server.</p>
    <% if AuthorizeNetClient.sandbox? %>
      <p class="mt-3 inline-block rounded-full bg-haze px-3 py-1 text-xs font-semibold text-taupe">Test mode — no real charges (use the Authorize.net test cards)</p>
    <% end %>
  </header>

  <%= form_tag warehouse_checkout_submit_path(@share.token), method: :post,
        data: { turbo: false, controller: "accept-payment",
                accept_payment_login_id_value: @login_id,
                accept_payment_client_key_value: @client_key,
                accept_payment_sandbox_value: AuthorizeNetClient.sandbox?,
                action: "submit->accept-payment#submit" } do %>
    <div class="grid gap-4 lg:grid-cols-5">
      <div class="space-y-4 lg:col-span-3">
        <div class="card card-pad">
          <h2 class="font-display text-xl text-ink">Shipping details</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_name">Name</label>
              <input type="text" id="shipping_name" name="shipping_name" required class="input w-full">
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_address1">Address</label>
              <input type="text" id="shipping_address1" name="shipping_address1" required class="input w-full">
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_address2">Address line 2</label>
              <input type="text" id="shipping_address2" name="shipping_address2" class="input w-full">
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_city">City</label>
              <input type="text" id="shipping_city" name="shipping_city" required class="input w-full">
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_province">State / Province</label>
              <input type="text" id="shipping_province" name="shipping_province" class="input w-full">
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_zip">ZIP / Postal code</label>
              <input type="text" id="shipping_zip" name="shipping_zip" required class="input w-full">
            </div>
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_country">Country</label>
              <input type="text" id="shipping_country" name="shipping_country" value="US" class="input w-full">
            </div>
            <div class="sm:col-span-2">
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha" for="shipping_phone">Phone</label>
              <input type="tel" id="shipping_phone" name="shipping_phone" class="input w-full">
            </div>
          </div>
        </div>

        <div class="card card-pad">
          <h2 class="font-display text-xl text-ink">Payment</h2>
          <div class="mt-4 space-y-3">
            <div>
              <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha">Card number</label>
              <div id="accept-card-number" data-accept-payment-target="cardNumber" class="h-11 rounded-xl border border-fog bg-haze px-3 py-2"></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha">Expiration</label>
                <div id="accept-expiration" data-accept-payment-target="expiration" class="h-11 rounded-xl border border-fog bg-haze px-3 py-2"></div>
              </div>
              <div>
                <label class="mb-1 block text-xs font-semibold uppercase tracking-wide text-mocha">Security code</label>
                <div id="accept-card-code" data-accept-payment-target="cardCode" class="h-11 rounded-xl border border-fog bg-haze px-3 py-2"></div>
              </div>
            </div>
          </div>
          <%= hidden_field_tag "payment_nonce", nil, data: { accept_payment_target: "nonce" } %>
          <%= hidden_field_tag "data_descriptor", nil, data: { accept_payment_target: "descriptor" } %>
          <p class="mt-3 text-sm text-rose" data-accept-payment-target="error"></p>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="card card-pad space-y-3">
          <h2 class="font-display text-xl text-ink">Order summary</h2>
          <% @cart.items.each do |item| %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="min-w-0 truncate text-mocha"><%= item.quantity %> × <%= item.title %></span>
              <span class="shrink-0 font-medium text-ink"><%= number_to_currency(item.line_price) %></span>
            </div>
          <% end %>
          <div class="flex items-center justify-between border-t border-fog pt-3">
            <span class="text-sm text-mocha">Total</span>
            <span class="text-lg font-semibold text-ink"><%= number_to_currency(@cart.total_cents / 100.0) %></span>
          </div>
          <%= submit_tag "Pay #{number_to_currency(@cart.total_cents / 100.0)}", data: { accept_payment_target: "submit" }, class: "btn-primary w-full" %>
        </div>
      </div>
    </div>
  <% end %>
</section>
