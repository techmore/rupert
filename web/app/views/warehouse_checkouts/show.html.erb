<% content_for :title, "Checkout · #{@share.name}" %>
<div class="space-y-8">
  <%= page_header 'Checkout', subtitle: "#{@share.name} · #{@dejavoo_hpp ? 'you pay on the payment processor’s secure page; your card never touches our site.' : 'your card details are tokenized in your browser and never touch our server.'}", eyebrow: 'Warehouse sale' do %>
    <% if @dejavoo_hpp ? DejavooHostedPage.sandbox? : AuthorizeNetClient.sandbox? %><span class="pill-taupe">Test mode · no real charges (use the processor’s test cards)</span><% end %>
  <% end %>

  <% if @payment_attempt %>
    <section class="section-card" aria-label="Payment status">
      <% if @payment_attempt.provider == 'dejavoo_hpp' && @payment_attempt.status == 'submitting' %>
        <%= section_heading 'Payment not finished', hint: 'Continue on the secure payment page, or check whether your payment went through. Do not start a new payment.' do %>
          <span class="pill-clay">In progress</span>
        <% end %>
        <div class="flex flex-wrap gap-2">
          <% if @payment_attempt.hosted_url.present? %><%= link_to 'Continue to payment', @payment_attempt.hosted_url, class: 'btn-primary', rel: 'noopener' %><% end %>
          <%= link_to 'Check payment status', warehouse_checkout_dejavoo_path(@share.token, @payment_attempt.invoice_number), class: 'btn-ghost' %>
        </div>
      <% elsif @payment_attempt.status == 'approved' %>
        <%= section_heading 'Payment approved', hint: 'Finish saving your order without submitting another card payment.' do %>
          <span class="pill-fern">Approved</span>
        <% end %>
        <%= button_to 'Finish approved order', warehouse_checkout_submit_path(@share.token), method: :post, class: 'btn-primary', data: { turbo: false } %>
      <% else %>
        <%= section_heading 'Payment status needs review', hint: "Do not submit another payment. Contact the store with reference #{@payment_attempt.invoice_number}." do %>
          <span class="pill-clay">Needs review</span>
        <% end %>
      <% end %>
    </section>
  <% else %>
    <% if @dejavoo_hpp %>
    <%= form_tag warehouse_checkout_submit_path(@share.token), method: :post, data: { turbo: false } do %>
      <%= hidden_field_tag :checkout_quote, @checkout_quote %>
      <div class="grid gap-4 lg:grid-cols-5">
        <div class="space-y-4 lg:col-span-3">
          <%= render 'shipping_fields' %>
          <section class="section-card" aria-label="Payment">
            <%= section_heading 'Payment' %>
            <p class="text-sm text-mocha">You’ll enter your card on the payment processor’s secure page, then come back here for your order confirmation. Your card number never reaches this site.</p>
          </section>
        </div>
        <div class="lg:col-span-2"><%= render 'order_summary', button: "Continue to secure payment · #{number_to_currency(@cart.total_cents / 100.0)}" %></div>
      </div>
    <% end %>
    <% else %>
    <%= form_tag warehouse_checkout_submit_path(@share.token), method: :post,
          data: { turbo: false, controller: "accept-payment#{' apple-pay' if @apple_pay}#{' google-pay' if @google_pay}",
                  accept_payment_login_id_value: @login_id,
                  accept_payment_client_key_value: @client_key,
                  accept_payment_sandbox_value: AuthorizeNetClient.sandbox?,
                  apple_pay_session_url_value: warehouse_apple_pay_session_path(@share.token),
                  apple_pay_total_value: format('%.2f', @cart.total_cents / 100.0),
                  apple_pay_label_value: @share.name,
                  google_pay_login_id_value: @login_id,
                  google_pay_total_value: format('%.2f', @cart.total_cents / 100.0),
                  google_pay_environment_value: (AuthorizeNetClient.sandbox? ? 'TEST' : 'PRODUCTION'),
                  google_pay_merchant_id_value: EnvStore.fetch('GOOGLE_PAY_MERCHANT_ID', ''),
                  google_pay_merchant_name_value: EnvStore.fetch('GOOGLE_PAY_MERCHANT_NAME', '').presence || @share.name,
                  action: 'submit->accept-payment#submit' } do %>
      <%= hidden_field_tag :checkout_quote, @checkout_quote %>
      <div class="grid gap-4 lg:grid-cols-5">
        <div class="space-y-4 lg:col-span-3">
          <%= render 'shipping_fields' %>

          <fieldset class="section-card">
            <legend class="sr-only">Payment</legend>
            <%= section_heading 'Payment' %>
            <% if @google_pay %>
              <div hidden data-google-pay-target="wrapper"><div data-google-pay-target="button"></div></div>
            <% end %>
            <% if @apple_pay %>
              <div hidden data-apple-pay-target="wrapper">
                <button type="button" data-apple-pay-target="button" data-action="apple-pay#pay" aria-label="Pay with Apple Pay" class="apple-pay-button"></button>
                <p class="mt-2 text-center text-xs text-taupe">or pay with a card</p>
              </div>
            <% end %>
            <div class="space-y-3">
              <div>
                <label class="field-label" for="accept-card-number">Card number</label>
                <div id="accept-card-number" data-accept-payment-target="cardNumber" class="input h-11"></div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="field-label" for="accept-expiration">Expiration</label>
                  <div id="accept-expiration" data-accept-payment-target="expiration" class="input h-11"></div>
                </div>
                <div>
                  <label class="field-label" for="accept-card-code">Security code</label>
                  <div id="accept-card-code" data-accept-payment-target="cardCode" class="input h-11"></div>
                </div>
              </div>
            </div>
            <%= hidden_field_tag 'payment_nonce', nil, data: { accept_payment_target: 'nonce' } %>
            <%= hidden_field_tag 'data_descriptor', nil, data: { accept_payment_target: 'descriptor' } %>
            <p class="text-sm text-rose" data-accept-payment-target="error"></p>
          </fieldset>
        </div>

        <div class="lg:col-span-2">
          <%= render 'order_summary', button: "Pay #{number_to_currency(@cart.total_cents / 100.0)}", accept: true %>
        </div>
      </div>
    <% end %>
    <% end %>
  <% end %>
</div>
