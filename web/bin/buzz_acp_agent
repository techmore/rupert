#!/usr/bin/env bash
# Run the @rupert Buzz agent via the officially supported buzz-acp harness,
# driving opencode's ACP server. The agent keypair lives in the tenant
# settings DB (Settings page), so resolve it here before exec'ing buzz-acp.
set -euo pipefail

cd "$(dirname "$0")/.."
export RAILS_ENV="${RAILS_ENV:-production}"

key="$(
  bin/rails runner 't = Tenant.find_by(status: "active") || Tenant.first; Current.tenant = t; print EnvStore.fetch("BUZZ_PRIVATE_KEY").to_s' 2>/dev/null |
    grep -oE '[0-9a-f]{64}' | head -1
)"

if [ -z "$key" ]; then
  echo "[buzz_acp_agent] BUZZ_PRIVATE_KEY not found in tenant settings — refusing to start" >&2
  exit 1
fi

export BUZZ_PRIVATE_KEY="$key"

relay="$(
  bin/rails runner 't = Tenant.find_by(status: "active") || Tenant.first; Current.tenant = t; print EnvStore.fetch("BUZZ_RELAY_URL").to_s' 2>/dev/null |
    grep -oE 'wss?://[^[:space:]]+' | head -1 || true
)"

if [ -n "$relay" ]; then
  export BUZZ_RELAY_URL="$relay"
fi

auth_tag="$(
  bin/rails runner 't = Tenant.find_by(status: "active") || Tenant.first; Current.tenant = t; print EnvStore.fetch("BUZZ_AUTH_TAG").to_s' 2>/dev/null |
    grep -oE '\{"[^}]*"\}' | head -1 || true
)"

if [ -n "$auth_tag" ]; then
  export BUZZ_AUTH_TAG="$auth_tag"
fi

exec /usr/local/bin/buzz-acp "$@"
